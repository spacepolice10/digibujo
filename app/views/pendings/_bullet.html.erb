<%# locals: (bullet:) %>
<div id="<%= dom_id(bullet, :pending) %>" class="pending--bullet">
  <% if bullet.author_name.present? %>
    <p class="typography--paragraph-sm pending--author"><%= bullet.author_name %></p>
  <% end %>
  <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
  <div class="layout--flex">
    <%= button_to pending_bullet_accept_path(bullet),
          method: :post,
          class: "button--secondary button--sm",
          form: { class: "pending--action-form" },
          aria: { label: "Add to today" } do %>
      <%= icon_tag("arrow-right") %>
      Today
    <% end %>
    <%= button_to pending_bullet_discard_path(bullet),
          method: :post,
          class: "button--secondary button--sm",
          form: { class: "pending--action-form" },
          aria: { label: "Discard" } do %>
      <%= icon_tag("archive") %>
      Discard
    <% end %>
  </div>
</div>
