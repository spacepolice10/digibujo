<% content_for(:title) { "New bundle" } %>

<div class="layout--page form--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <% back_path = @collection ? collection_path(@collection) : home_path %>
      <%= link_to back_path, class: "button--secondary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
    </div>
    <h2>New bundle</h2>
  </div>

  <div class="form--surface">
    <%= form_with model: (@collection ? [@collection, @bundle] : @bundle), class: "form form--strong" do |f| %>
      <% unless @collection %>
        <div class="form-group">
          <%= f.label :collection_id, "Collection", class: "form-label" %>
          <%= f.collection_select :collection_id,
                user_collections,
                :id,
                ->(c) { c.bucket.name },
                { include_blank: "None (standalone bundle)" },
                class: "form-input" %>
        </div>
      <% end %>
      <%= render "collections/identity_fields", form: f,
            name_hint: "Give your bundle a name." %>
      <%= f.submit "Create bundle", class: "button--primary form--submit" %>
    <% end %>
  </div>
</div>
