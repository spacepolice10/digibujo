<% content_for(:title) { @bundle.name } %>

<div class="layout--page layout--workspace-page">
  <div class="layout--workspace">
    <aside class="layout--rail">
      <%= link_to collection_path(@collection),
            class: "button--secondary layout--rail-action",
            onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
      <%= render "buckets/pins_button", bucket: @bundle.bucket %>
    </aside>

    <div class="layout--surface bucket--list" data-controller="bulk-menu">
      <h2 class="layout--surface-title"><%= @bundle.name %></h2>

      <div data-bulk-menu-target="list">
        <div class="bundle--list">
          <%= render "bundles/section",
                bundle: @bundle,
                collection: @collection,
                hide_title: true %>
        </div>
      </div>

      <%= render "bullets/bulk_menu" %>
    </div>

    <aside class="layout--rail" aria-hidden="true"></aside>
  </div>
</div>
