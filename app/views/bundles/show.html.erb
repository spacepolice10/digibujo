<% content_for(:title) { @bundle.name } %>

<div class="layout--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <% back_path = @bundle.collection ? collection_path(@bundle.collection) : home_path %>
      <% back_label = @bundle.collection ? @bundle.collection.name : "Home" %>
      <%= link_to back_path, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        <%= back_label %>
      <% end %>
    </div>
    <h2><%= @bundle.name %></h2>
  </div>

  <article class="layout--column">
    <div id="bullets">
      <%= render partial: "bullets/bullet", collection: @bullets, as: :bullet %>
    </div>
  </article>
</div>
