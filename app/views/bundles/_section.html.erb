<%# locals: (bundle:, collection:, bulk_list: false, hide_title: false) %>
<section id="<%= dom_id(bundle, :section) %>" class="bundle--section">
  <header class="bundle--header<%= " bundle--header--actions-only" if hide_title %>">
    <% unless hide_title %>
      <h3 class="bundle--title" data-bucket-colour="<%= bundle.colour %>"><%= bundle.name %></h3>
    <% end %>
    <%= button_to collection_bundle_path(collection, bundle),
          method: :delete,
          class: "button--primary button--icon button--circle bundle--close",
          data: { turbo_confirm: "Delete this bundle? Its bullets will remain in the collection." },
          aria: { label: "Delete #{bundle.name}" } do %>
      <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
    <% end %>
  </header>
  <div class="bundle--body">
    <div class="bundle--bullets"<% if bulk_list %> id="bullets" data-bulk-menu-target="list"<% end %>>
      <%= render bundle.bullets.where(archived: false).distinct.chronological %>
    </div>
    <turbo-frame id="composer_bundle_<%= bundle.id %>" class="bundle-composer--<%= bundle.id %>">
      <%= render "bullets/add_bullet_button",
            attributes: {
              bucket_id: bundle.bucket.id,
              composer_id: "composer_bundle_#{bundle.id}"
            },
            turbo_frame: "_self",
            aria_label: "Add bullet to #{bundle.name}" %>
    </turbo-frame>
  </div>
</section>
