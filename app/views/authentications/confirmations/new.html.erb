<% content_for(:title) { "Enter code" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto authentication--header">
    <%= icon_tag("mail", style: "color: var(--color-text-base);", class: "authentication--header-icon") %>
    <h1>Check your email</h1>
  </div>
  <p class="utilities--mx-auto typography--paragraph-sm typography--center">
    We sent a 6-character code to <strong><%= @email %></strong>.
  </p>

  <div class="layout--mx-auto">
    <div class="layout--padded">
      <%= form_with url: authentication_confirmation_path, class: "form form--strong" do |form| %>
        <div class="layout--mx-auto">
          <%= form.button type: "submit", class: "button--primary button--lg" do %>
            Verify code
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="layout--mx-auto typography--center">
    <%= link_to "Didn't receive it? Try again", new_authentication_path, class: "typography--paragraph-sm" %>
  </div>
</div>
