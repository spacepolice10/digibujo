<% if q.present? %>
  <% if buckets.any? || bullets.any? %>
    <% if buckets.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">Buckets</h4>
        <ul class="layout--list bucket--list" role="listbox">
          <% buckets.each do |bucket| %>
            <%= render "bucket", bucket: bucket %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if bullets.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">Bullets</h4>
        <ul class="layout--list menu--palette-list" role="listbox">
          <% bullets.each do |bullet| %>
            <%= render "bullet", bullet: bullet %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if buckets_overflow || bullets_overflow %>
      <%= link_to "View all results",
            search_path(q: q),
            class: "button--tertiary menu--palette-view-all",
            data: { turbo_frame: "_top", combobox_target: "item" } %>
    <% end %>
  <% else %>
    <p class="search--empty">No results for "<%= q %>"</p>
  <% end %>
<% end %>
