<% content_for(:title, "Account") %>

<%= render "shared/tabbar" %>

<main data-size="md">
  <h1>Account</h1>

  <article>
    <ul data-layout="column" data-divider="true">
      <li>
        <div>
          <%= icon("face") %>
          <p><%= Current.user.email_address %></p>
        </div>
      </li>

      <li>
        <%= link_to access_codes_path, data: { turbo_frame: "_top" } do %>
          <%= icon("code") %>
          <p>Access codes</p>
        <% end %>
      </li>

      <li>
        <%= link_to hooks_path, data: { turbo_frame: "_top" } do %>
          <%= icon("webhook") %>
          <p>Hooks</p>
        <% end %>
      </li>
    </ul>
  </article>

  <%= button_to authentication_path,
        method: :delete,
        data: { intent: "primary", radius: "base" },
        form: { data: { turbo_confirm: "Sign out of Dotted?" } } do %>
    <%= icon("sign-out") %>
    Sign out
  <% end %>
</main>
