<% content_for(:title) { "Account" } %>

<main class="layout--page layout--container-sm layout--surface-sunken">
  <div class="layout--header-actions">
    <%= link_to home_path, class: "button--secondary" do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-left)"
        aria-hidden="true"
      ></i>

      <p>Back</p>
    <% end %>
  </div>

  <div class="layout--page">
    <div class="layout--surface">
      <span class="button--secondary button--icon-strong button--circle">
        <%= Current.user.email_address.first.upcase %>
      </span>
      <div>
        <h1 class="typography--h1">Account</h1>
        <p class="typography--paragraph-sm">
          Signed in as <strong><%= Current.user.email_address %></strong>.
        </p>
      </div>
    </div>

    <div class="layout--surface layout--header-actions">
      <%= link_to "#", class: "button--secondary" do %>
        <i
          class="icon"
          style="--icon-mask: var(--icon-webhook)"
          aria-hidden="true"
        ></i>
        Webhooks
      <% end %>

      <%= button_to authentication_path,
              method: :delete,
              class: "button--secondary",
              form: { data: { turbo_confirm: "Sign out of Digibujo?" } } do %>
        <i
          class="icon"
          style="--icon-mask: var(--icon-sign-out)"
          aria-hidden="true"
        ></i>
        Sign out
      <% end %>
    </div>
  </div>
</main>
