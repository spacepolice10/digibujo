<% content_for(:title) { "Archived" } %>
<div class="bucket--layout">
<div class="bucket--header">
  <h2>Archived</h2>
  <span><strong><%= @amount_of_archived %></strong> total</span>
</div>
  <article class="bucket--list">
    <%= render "pagination/paginated_records",
          page: @page,
          pagination_link_path: ->(next_param) { archived_index_path(page: next_param) } %>
  </article>
</div>
