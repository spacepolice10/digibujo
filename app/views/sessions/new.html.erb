<% content_for(:title) { "Sign in" } %>

<div class="session--page">
  <div class="form--surface">
    <%= render "sessions/flash" %>

    <%= form_with url: session_path, class: "form form--strong" do |form| %>
      <div class="session--intro">
        <h1 class="session--title">Sign in</h1>
        <p class="form-hint session--description">Enter your email and we'll send you a one-time code.</p>
      </div>

      <div class="form-group">
        <%= form.email_field :email_address,
              class: "form-input",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              aria: { label: "Email" },
              value: params[:email_address] %>
      </div>

      <%= form.submit "Continue", class: "button--primary form--submit" %>
    <% end %>
  </div>

  <%= link_to new_signup_path, class: "session--footer-link" do %>
    New here? Create an account
  <% end %>
</div>
