<% content_for(:title) { "Enter code" } %>

<div class="session--page">
  <div class="form--surface">
    <%= render "sessions/flash" %>

    <%= form_with url: session_code_path, class: "form form--strong" do |form| %>
      <div class="session--intro">
        <h1 class="session--title">Check your email</h1>
        <p class="form-hint session--description">We sent a 6-character code to <strong><%= @email %></strong>.</p>
      </div>

      <div class="form-group">
        <%= form.label :code, "Login code", class: "form-label" %>
        <%= form.text_field :code,
              class: "form-input session--code-input",
              required: true,
              autofocus: true,
              autocomplete: "one-time-code",
              inputmode: "text",
              maxlength: 6,
              placeholder: "······",
              aria: { label: "6-character login code" } %>
      </div>

      <%= form.submit "Verify code", class: "button--primary form--submit" %>
    <% end %>
  </div>

  <%= link_to "Didn't receive it? Try again", new_session_path, class: "session--footer-link" %>
</div>
