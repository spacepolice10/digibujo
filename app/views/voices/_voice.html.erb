<%# locals: (voice:, selected_date: nil) %>
<% bullet = voice %>
<% voice = bullet.bulletable %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-type="voice">
  <%= render "bullets/marker", bullet: bullet %>
  <div class="bullet--body">
    <% unless voice.recording.attached? %>
      <span class="bullet--content"><%= voice.body %></span>
    <% end %>
    <%= render "voices/playback_for_bullet", bullet: bullet %>
    <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
  </div>
</turbo-frame>
