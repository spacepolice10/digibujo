<%# locals: (voice:, selected_date: nil) %>
<turbo-frame id="<%= dom_id(voice) %>" class="bullet" data-bullet-type="voice">
  <div class="bullet--marker-slot">
    <%= render "bullets/marker", bullet: voice %>
  </div>
  <div class="bullet--body">
    <div class="bullet-body">
      <% unless voice.bulletable_type == "Voice" && voice.bulletable.recording.attached? %>
        <%= voice.body %>
      <% end %>
      <%= render "voices/playback_for_bullet", bullet: voice %>
    </div>
    <%= render "bullets/metadata", bullet: voice, selected_date: selected_date %>
  </div>
  <%= render "bullets/bulk_menu_select", bullet: voice %>
</turbo-frame>
