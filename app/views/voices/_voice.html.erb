<%# locals: (bullet:) %>
<%= render layout: "bullets/bullet", locals: { bullet: } do %>
  <% if bullet.body.present? %>
    <span class="voice--caption"><%= bullet.body %></span>
  <% end %>
  <%= render "voices/playback",
        recording: bullet.voice.recording,
        recording_duration: bullet.voice.duration_seconds %>
<% end %>
