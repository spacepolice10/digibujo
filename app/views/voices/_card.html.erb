<%# locals: (bullet:) %>
<div class="voice--card">
  <div class="voice--playback-zone">
    <div class="voice--playback-header">
      <span class="voice--rec-dot" aria-hidden="true"></span>
      <span class="voice--caption"><%= bullet.body %></span>
      <% if bullet.voice.duration_seconds.present? %>
        <span class="voice--duration utilities--text-sm"><%= bullet.voice.duration_seconds %>s</span>
      <% end %>
    </div>
    <%= render "voices/playback", bullet: bullet %>
  </div>
</div>
