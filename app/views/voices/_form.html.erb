<%# locals: (bullet:, editing:) %>
<%= render layout: "bullets/form",
      locals: {
        bullet:,
        editing:,
        stimulus_controller: "voice-recorder",
        stimulus_actions: "turbo:submit-end->voice-recorder#clearOnSubmit"
      } do |fr, bulletable| %>
  <% bulletable.body = "Record #{(bullet.pops_on || Date.current).strftime('%a, %b %-d')}" if bulletable.body.blank? %>
  <%= fr.fields_for :bulletable, bulletable do |bf| %>
    <%= bf.hidden_field :id if bulletable.persisted? %>
    <%= bf.text_field :body,
          value: bulletable.body,
          placeholder: "Caption your voice, guitar playing or cat meowing…",
          autofocus: false,
          class: "bullet-composer--plain-input",
          data: {
            voice_recorder_target: "captionInput",
            action: "keydown->composer#plainEnter input->composer#editorInput"
          } %>
    <%= bf.file_field :recording, accept: "audio/webm,audio/mp4", hidden: true, data: { voice_recorder_target: "fileInput" } %>
    <%= bf.hidden_field :duration_seconds, data: { voice_recorder_target: "durationInput" } %>
  <% end %>

  <div class="voice-recorder">
    <div class="voice-recorder--preview" data-voice-recorder-target="previewContainer" hidden>
      <%= render "voices/playback", bullet: bullet %>
    </div>
    <p class="voice-recorder--unsupported utilities--text-sm" data-voice-recorder-target="unsupported" hidden>
      Voice recording is not supported in this browser.
    </p>
  </div>
  <div class="voice-recorder--controls" aria-label="Voice recording">
    <button type="button"
            class="button--tertiary voice-recorder--record hotkey-hint hotkey-hint--always"
            data-controller="hotkey"
            data-hotkey="Shift+R"
            data-voice-recorder-target="recordButton"
            data-action="voice-recorder#start keydown.shift+r@document->hotkey#click"
            aria-label="Start recording"
            aria-keyshortcuts="Shift+R">
      <i class="icon" style="--icon-mask: var(--icon-microphone)" aria-hidden="true"></i>
      <p>Record</p>
    </button>
    <button type="button"
            class="button--secondary button--icon voice-recorder--stop"
            data-voice-recorder-target="stopButton"
            data-action="voice-recorder#stop"
            hidden
            aria-label="Stop recording">
      <i class="icon" style="--icon-mask: var(--icon-square)" aria-hidden="true"></i>
    </button>
    <button type="button"
            class="button--secondary button--icon"
            data-voice-recorder-target="discardButton"
            data-action="voice-recorder#discard"
            hidden>
      <i class="icon" style="--icon-mask: var(--icon-trash)" aria-hidden="true"></i>
    </button>
    <span class="voice-recorder--timer utilities--text-sm" data-voice-recorder-target="timer" aria-live="polite">0:00</span>
    <span class="voice-recorder--status utilities--text-sm" data-voice-recorder-target="status" hidden></span>
  </div>
<% end %>
