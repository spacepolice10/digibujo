<%# locals: (bullet:, editing:, return_path: nil) %>
<%= render layout: "bullets/form",
      locals: {
        bullet:,
        editing:,
        return_path:,
        stimulus_controller: "voice-recorder",
        stimulus_actions: "turbo:submit-end->voice-recorder#clearOnSubmit"
      } do |fr, bulletable| %>
  <% bulletable.body = "Record #{(bullet.pops_on || Date.current).strftime('%a, %b %-d')}" if bulletable.body_as_text.blank? %>
  <%= fr.fields_for :bulletable, bulletable do |bf| %>
    <%= bf.hidden_field :id if bulletable.persisted? %>
    <%= bf.rich_text_area :body,
          value: bulletable.body,
          preset: "inline",
          placeholder: "Caption your voice, guitar playing or cat meowing…",
          autofocus: false %>
    <%= bf.file_field :recording, accept: "audio/webm,audio/mp4", hidden: true, data: { voice_recorder_target: "file" } %>
    <%= bf.hidden_field :duration_seconds, data: { voice_recorder_target: "duration" } %>
  <% end %>

  <div class="voice-recorder">
    <div class="voice--playback" data-voice-recorder-target="waveform" hidden>
      <button type="button"
              class="button--tertiary button--sm voice--play"
              data-voice-recorder-target="stopButton"
              data-action="voice-recorder#stop"
              aria-label="Stop recording">
        <%= icon_tag("square", style: "color: var(--color-text-base);", class: "button--icon") %>
        <p>Stop</p>
      </button>
      <div class="voice--waveform" aria-hidden="true">
        <svg viewBox="0 0 160 32" preserveAspectRatio="none">
          <% 80.times do |i| %>
            <rect class="voice--waveform-item" x="<%= i * 2 %>" y="15" width="1.25" height="2" rx="0.5" />
          <% end %>
        </svg>
      </div>
    </div>
    <div class="voice-recorder--preview" data-voice-recorder-target="previewContainer" hidden>
      <%= render "voices/playback", recording: nil, recording_duration: 0 %>
    </div>
    <p class="voice-recorder--unsupported utilities--text-sm" data-voice-recorder-target="unsupported" hidden>
      Voice recording is not supported in this browser.
    </p>
  </div>
  <div class="voice-recorder--controls" aria-label="Voice recording">
    <button type="button"
            class="button--tertiary voice-recorder--record hotkey-hint hotkey-hint--always"
            data-controller="hotkey"
            data-hotkey="Shift+R"
            data-voice-recorder-target="recordButton"
            data-action="voice-recorder#record keydown.shift+r@document->hotkey#click"
            aria-label="Start recording"
            aria-keyshortcuts="Shift+R">
      <%= icon_tag("microphone", style: "color: var(--color-text-base);", class: "button--icon") %>
      <p>Record</p>
    </button>
    <button type="button"
            class="button--secondary voice-recorder--discard"
            data-voice-recorder-target="discardButton"
            data-action="voice-recorder#discard"
            hidden>
      <%= icon_tag("trash", style: "color: var(--color-text-base);", class: "button--icon") %>
      <p>Discard</p>
    </button>
    <span class="voice-recorder--remaining utilities--text-sm" data-voice-recorder-target="remaining" aria-live="polite">0:00</span>
    <span class="utilities--sr-only" data-voice-recorder-target="status" aria-live="polite" hidden></span>
  </div>
<% end %>
