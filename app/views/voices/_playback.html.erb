<%# locals: (voice: nil, preview: false, src: nil, duration_seconds: nil, compact: false, hide_duration: false) %>
<% duration = duration_seconds || voice&.duration_seconds.to_i %>
<% audio_src = src || (voice&.recording&.attached? ? url_for(voice.recording) : nil) %>
<div class="voice--playback<%= " voice--playback-compact" if compact %>"
     data-controller="voice-player"
     data-voice-player-duration-value="<%= duration %>">
  <audio class="utilities--sr-only"
         data-voice-player-target="audio"
         <% if preview %>data-voice-recorder-target="preview"<% end %>
         preload="metadata"
         <% if audio_src.present? %>src="<%= audio_src %>"<% end %>
         aria-hidden="true"></audio>

  <button type="button"
          class="button--tertiary button--icon voice--play"
          data-voice-player-target="playButton"
          data-action="voice-player#toggle"
          aria-label="Play">
    <i class="icon voice--play-icon" style="--icon-mask: var(--icon-play)" aria-hidden="true" data-voice-player-target="playIcon"></i>
    <i class="icon voice--pause-icon" style="--icon-mask: var(--icon-pause)" aria-hidden="true" data-voice-player-target="pauseIcon" hidden></i>
  </button>

  <div class="voice--progress"
       data-voice-player-target="progress"
       data-action="click->voice-player#seek keydown->voice-player#progressKeydown"
       role="slider"
       aria-label="Playback position"
       aria-valuemin="0"
       aria-valuemax="<%= duration %>"
       aria-valuenow="0"
       tabindex="0">
    <div class="voice--progress-fill" data-voice-player-target="progressFill"></div>
  </div>

  <% if duration.positive? && !hide_duration %>
    <span class="voice--duration utilities--text-sm"><%= duration %>s</span>
  <% end %>
</div>
