<%# locals: (monthly_bucket:) %>
<% months = (0..5).map { |i| Date.current.beginning_of_month + i.months } %>
<% selected_month = monthly_bucket.period_from&.beginning_of_month || months.first %>

<%= form_with url: monthly_buckets_path, scope: :monthly_bucket, class: "form form--strong" do |f| %>
  <% errors = (monthly_bucket.errors.any? ? monthly_bucket.errors.full_messages : []) +
              (monthly_bucket.bucket&.errors&.any? ? monthly_bucket.bucket.errors.full_messages : []) %>
  <% if errors.any? %>
    <div class="form-errors" role="alert">
      <% errors.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <small class="form-hint">A monthly spread gives you a bird's-eye view of the month — like the traditional BuJo calendar page, but linked to your daily log. Plan events and deadlines here, then jump to any day to work on the details.</small>

  <div class="form-group">
    <%= field_set_tag "Month", class: "form--period-picker" do %>
      <%= f.collection_radio_buttons :month, months, :iso8601, ->(m) { m.strftime("%B %Y") },
            { checked: selected_month.iso8601, item_wrapper_tag: false } do |b| %>
        <% month_date = Date.parse(b.value) %>
        <%= b.label class: "form--period-option", data: { month: month_date.month } do %>
          <%= b.radio_button class: "utilities--sr-only form--period-input" %>
          <span class="form--period-card">
            <span class="form--period-label"><%= month_date.strftime("%b") %></span>
            <span class="form--period-meta"><%= month_date.year %></span>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= f.submit "Create monthly spread", class: "button--primary form--submit" %>
<% end %>
