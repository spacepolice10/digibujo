<%# locals: (monthly_bucket:, occupied_months:) %>
<% months = (0..5).map { |i| Date.current.beginning_of_month + i.months } %>
<% occupied_months = Array(occupied_months) %>
<% available_months = months.reject { |m| occupied_months.include?(m) } %>
<% selected_month = available_months.first || months.first %>
<% all_occupied = months.all? { |m| occupied_months.include?(m) } %>

<%= form_with url: future_monthly_buckets_path, scope: :monthly_bucket, class: "form form--strong" do |f| %>
  <% errors = (monthly_bucket.errors.any? ? monthly_bucket.errors.full_messages : []) +
              (monthly_bucket.bucket&.errors&.any? ? monthly_bucket.bucket.errors.full_messages : []) %>
  <% if errors.any? %>
    <div class="form-errors" role="alert">
      <% errors.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <small class="form-hint">A monthly spread gives you a bird's-eye view of the month — like the traditional BuJo calendar page, but linked to your daily log. Plan events and deadlines here, then jump to any day to work on the details.</small>

  <div class="form-group">
    <%= field_set_tag "Month", class: "form--period-picker" do %>
      <%= f.collection_radio_buttons :month, months, :iso8601, ->(m) { m.strftime("%B %Y") },
            { checked: (all_occupied ? nil : selected_month.iso8601), item_wrapper_tag: false } do |b| %>
        <% month_date = Date.parse(b.value) %>
        <% disabled = occupied_months.include?(month_date) %>
        <%= b.label class: ["form--period-option", ("form--period-option--disabled" if disabled)].compact.join(" "),
                    data: { month: month_date.month } do %>
          <%= b.radio_button class: "utilities--sr-only form--period-input", disabled: disabled %>
          <span class="form--period-card">
            <span class="form--period-label"><%= month_date.strftime("%b") %></span>
            <span class="form--period-meta"><%= month_date.year %></span>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= f.submit "Create monthly spread", class: "button--primary form--submit", disabled: all_occupied %>
<% end %>
