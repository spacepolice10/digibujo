<% content_for(:title) { @monthly_bucket.name } %>

<div class="layout--page monthly-bucket--page monthly-bucket--page-mobile">
  <div class="monthly-bucket--actions">
    <%= link_to home_path, class: "button--secondary" do %>
      <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      Back
    <% end %>
    <%= render "buckets/pins_button", bucket: @bucket %>
  </div>

  <div class="monthly-bucket--heading">
    <h2 class="layout--surface-name"><%= @monthly_bucket.name %></h2>
    <% if @monthly_bucket.period? %>
      <p class="monthly-bucket--period utilities--text-sm">
        <%= @monthly_bucket.period_from.strftime("%b %-d") %> – <%= @monthly_bucket.period_to.strftime("%b %-d, %Y") %>
      </p>
    <% end %>
  </div>

  <div class="monthly-bucket--workspace monthly-bucket--workspace-mobile"
       data-controller="monthly-sections"
       data-monthly-sections-active-value="days">
    <nav class="monthly-bucket--monthly-sections" role="tablist" aria-label="Monthly spread sections">
      <button type="button"
              class="monthly-bucket--monthly-section monthly-bucket--monthly-section-active"
              role="tab"
              aria-selected="true"
              data-monthly-sections-target="section"
              data-monthly-sections-section="days"
              data-action="monthly-sections#select">
        Planned
      </button>
      <button type="button"
              class="monthly-bucket--monthly-section"
              role="tab"
              aria-selected="false"
              data-monthly-sections-target="section"
              data-monthly-sections-section="unplanned"
              data-action="monthly-sections#select">
        Unplanned
      </button>
    </nav>

    <div class="monthly-bucket--spread monthly-bucket--spread-mobile">
      <section class="monthly-bucket--calendar monthly-bucket--side monthly-bucket--side-active"
               aria-label="Planned by date"
               data-controller="scroll"
               data-monthly-sections-target="side"
               data-monthly-sections-side="days">
        <% if @period_days %>
          <div class="monthly-bucket--calendar-body">
            <% @period_days.each do |date| %>
              <div class="monthly-bucket--date-band<%= " monthly-bucket--date-band-current" if date == Date.current %>"
                   <% if date == Date.current %> data-scroll-target="current"<% end %>>
                <div class="monthly-bucket--date-rail">
                  <%= link_to daylog_path(date: date.iso8601),
                        class: "monthly-bucket--date-number",
                        aria: { label: "Open #{date.strftime('%B %-d')} on daily log" } do %>
                    <span class="monthly-bucket--date-day"><%= date.day %></span>
                    <span class="monthly-bucket--date-weekday"><%= date.strftime("%a") %></span>
                  <% end %>
                  <div class="monthly-bucket--date-entries">
                    <div id="<%= dom_id(@monthly_bucket, "date_#{date.to_date}_bullets") %>"
                         class="monthly-bucket--bullets-list">
                      <% (@bullets_by_date[date] || []).each do |bullet| %>
                        <%= render "monthly_buckets/bullets/bullet", bullet: bullet %>
                      <% end %>
                    </div>
                    <div class="monthly-bucket--date-add">
                      <%= render "bullets/composer/open_composer_of",
                            path: new_bullet_path(pops_on: date, bucket_id: @monthly_bucket.bucket.id, bulletable_type: "Event"),
                            name: "Event",
                            icon: "circle",
                            modifier: "event" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="monthly-bucket--by-date-empty">No period set for this spread.</p>
        <% end %>
      </section>

      <section class="monthly-bucket--unplanned monthly-bucket--side"
               aria-label="Unplanned"
               data-monthly-sections-target="side"
               data-monthly-sections-side="unplanned"
               hidden>
        <header class="monthly-bucket--unplanned-header">
          <h3 class="monthly-bucket--unplanned-title">Unplanned</h3>
          <p class="monthly-bucket--unplanned-description utilities--text-sm">
            Brain dump for the month — park ideas here until you assign them to a day.
          </p>
        </header>
        <div class="monthly-bucket--unplanned-entries">
          <div id="<%= dom_id(@monthly_bucket, :unplanned_bullets) %>"
               class="monthly-bucket--bullets-list">
            <% @unplanned_bullets.each do |bullet| %>
              <%= render "monthly_buckets/bullets/bullet", bullet: bullet %>
            <% end %>
          </div>

          <%= render "bullets/composer/open_composer_of",
                path: new_bullet_path(bucket_id: @monthly_bucket.bucket.id, bulletable_type: "Task"),
                name: "Task",
                icon: "square",
                modifier: "task",
                hotkey: "Shift+T",
                hotkey_action: "keydown.shift+t@document->hotkey#click" %>
        </div>
      </section>
    </div>
  </div>

</div>
