<% content_for(:title) { "New monthly spread" } %>

<div class="layout--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
    </div>
    <h2>New monthly spread</h2>
  </div>
  <div class="layout--surface">
    <%= render "form", monthly_bucket: @monthly_bucket, occupied_months: @occupied_months %>
  </div>
</div>
