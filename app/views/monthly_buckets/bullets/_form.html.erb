<%# locals: (bullet:, monthly_bucket:, composer_id:, attributes: {}) %>
<% editor_id = "bullet_editor_#{bullet.object_id}" %>
<% type_entry = Bullet::Composer.type_options.find { |entry| entry[:type] == bullet.bulletable_type } %>
<% bulletable = bullet.bulletable || bullet.bulletable_type.constantize.new %>
<% picker_url = new_monthly_bucket_bullet_path(monthly_bucket, **attributes.merge(composer_id: composer_id).compact) %>

<%= form_with model: bullet,
      url: monthly_bucket_bullets_path(monthly_bucket),
      namespace: editor_id,
      class: "bullet-form monthly-bucket--bullet-form",
      data: {
        controller: "bullet-composer",
        bullet_composer_submit_on_enter_value: bulletable.submit_on_enter?,
        bullet_composer_submit_on_command_return_value: bulletable.submit_on_command_return?,
        composer_frame_picker_url: picker_url,
        action: "keydown->bullet-composer#handleKeydown turbo:submit-end->bullet-composer#clearOnSubmit"
      } do |f| %>
  <%= hidden_field_tag "bullet[composer_id]", composer_id %>
  <% attributes.each do |name, value| %>
    <% if %w[pops_on bucket_id].include?(name.to_s) %>
      <%= f.hidden_field name, value: value %>
    <% end %>
  <% end %>
  <%= f.hidden_field :bulletable_type %>
  <%= f.hidden_field :bucket_id, value: monthly_bucket.bucket.id if bullet.bucket_id.blank? %>

  <%= render "monthly_buckets/bullets/editor", f: f, bullet: bullet %>

  <div class="bullet-form-rail">
    <% if type_entry %>
      <span class="bullet--marker <%= type_entry[:marker_styles] %>" aria-hidden="true">
        <i class="icon" style="--icon-mask: var(--icon-<%= type_entry[:icon].dasherize %>)" aria-hidden="true"></i>
      </span>
      <span class="utilities--sr-only"><%= type_entry[:name] %></span>
    <% end %>

    <div class="bullet-form-rail-actions">
      <%= render "bullets/composer/submit_actions", f: f %>
    </div>
  </div>
<% end %>
