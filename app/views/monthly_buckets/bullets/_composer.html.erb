<%# locals: (monthly_bucket:, pops_on: nil, label: "Add bullet") %>
<% composer_id = pops_on.present? ? "composer_#{pops_on.to_date.iso8601}" : "composer_unplanned" %>
<turbo-frame id="<%= composer_id %>"
             class="bullet_pops_on_<%= pops_on %>"
             data-controller="composer-frame">
  <%= render "monthly_buckets/bullets/composer_content",
        bullet: Current.user.bullets.build(bucket_id: monthly_bucket.bucket.id, pops_on: pops_on),
        monthly_bucket: monthly_bucket,
        composer_id: composer_id,
        composer_attributes: { pops_on: pops_on, bucket_id: monthly_bucket.bucket.id }.compact %>
</turbo-frame>
