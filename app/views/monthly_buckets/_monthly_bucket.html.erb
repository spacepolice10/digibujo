<%# locals: (monthly_bucket:) %>
<li id="<%= dom_id(monthly_bucket.bucket, :list_item) %>" class="layout--list-item">
  <%= link_to monthly_bucket, monthly_bucket_path(monthly_bucket), data: { turbo_frame: "_top" }, class: "layout--list-item-link" do %>
    <span class="layout--list-item-name"><%= monthly_bucket.name %></span>
    <span class="layout--list-item-meta"><%= monthly_bucket.period_from.strftime("%b %-d") %> – <%= monthly_bucket.period_to.strftime("%b %-d") %></span>
  <% end %>
</li>
