<%# locals: (monthly_bucket:, date:, bucket:) %>
<%= link_to new_bullet_path(
      pops_on: date.iso8601,
      bucket_id: bucket.id,
      bulletable_type: "Event",
      composer_frame_id: dom_id(monthly_bucket, "date_#{date}_composer"),
      render_context: "monthly_bucket_by_date",
      monthly_bucket_id: monthly_bucket.id
    ),
    class: "button--tertiary button--icon",
    aria: { label: "Add to #{date.strftime('%B %-d')}" } do %>
  <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
<% end %>
