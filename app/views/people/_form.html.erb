<%= form_with model: person, class: "form form--strong", data: { controller: "person-handles" } do |f| %>
  <small class="form-hint">People let you tag bullets with a contact, so you can quickly pull up every task, note, or event tied to that person.</small>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <small class="form-hint">Name of the person.</small>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>

  <div class="form-group">
    <span class="form-label">Contacts</span>
    <small class="form-hint">Add email, phone, or social handles. Duplicates are allowed.</small>

    <div class="person--handles" data-person-handles-target="list">
      <%= f.fields_for :handles do |handle_form| %>
        <%= render "handle_fields", form: handle_form %>
      <% end %>
    </div>

    <template data-person-handles-target="template">
      <%= f.fields_for :handles, Person::Handle.new, child_index: "NEW_RECORD" do |handle_form| %>
        <%= render "handle_fields", form: handle_form %>
      <% end %>
    </template>

    <button type="button" class="button--secondary person--handles-add" data-action="person-handles#add">
      Add contact
    </button>
  </div>

  <div class="form-group">
    <span class="form-label">Colour</span>
    <div class="form--colour-picker" role="radiogroup" aria-label="Person colour">
      <% Colourable::COLOUR_MAPPINGS.each_key do |name| %>
        <label class="form--colour-option">
          <%= f.radio_button :colour, name %>
          <span class="form--colour-swatch" style="background: <%= Colourable.colour_bg_variable_for(name) %>" aria-hidden="true"></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :avatar, class: "form-label" %>
    <%= f.file_field :avatar, class: "form-input", accept: "image/*" %>
  </div>

  <%= f.submit class: "button--primary form--submit" %>
<% end %>
