<%= form_with model: person, class: "form form--strong" do |f| %>
  <small class="form-hint">
    People let you tag bullets with a contact, so you can quickly pull up every
    task, note, or event tied to that person.
  </small>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <small class="form-hint">Name of the person.</small>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>

  <div class="form-group">
    <span class="form-label">Contact</span>
    <small class="form-hint">Optional email and phone.</small>

    <div class="person--inline-contacts">
      <%= f.fields_for :handles, @email_handle, child_index: @email_handle_index do |email_form| %>
        <div class="person--inline-field" data-controller="valid-email">
          <%= email_form.hidden_field :kind, value: "email" %>
          <%= email_form.hidden_field :id if @email_handle.persisted? %>

          <i
            class="icon person--inline-field-icon"
            style="--icon-mask: var(--icon-mail)"
            aria-hidden="true"
          ></i>

          <%= email_form.email_field :data,
                class: "form-input person--inline-field-input",
                autocomplete: "email",
                placeholder: "Email",
                aria: { label: "Email" },
                data: {
                  valid_email_target: "input",
                  action: "input->valid-email#validate blur->valid-email#validate invalid->valid-email#report"
                } %>
        </div>
      <% end %>

      <%= f.fields_for :handles, @phone_handle, child_index: @phone_handle_index do |phone_form| %>
        <div class="person--inline-field" data-controller="valid-phone">
          <%= phone_form.hidden_field :kind, value: "phone" %>
          <%= phone_form.hidden_field :id if @phone_handle.persisted? %>

          <i
            class="icon person--inline-field-icon"
            style="--icon-mask: var(--icon-phone)"
            aria-hidden="true"
          ></i>

          <%= phone_form.telephone_field :data,
                class: "form-input person--inline-field-input",
                autocomplete: "tel",
                placeholder: "Phone",
                aria: { label: "Phone" },
                data: {
                  valid_phone_target: "input",
                  action: "input->valid-phone#validate blur->valid-phone#validate invalid->valid-phone#report"
                } %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/form/colour_picker", form: f %>

  <div class="form-group">
    <%= f.label :avatar, class: "form-label" %>
    <%= f.file_field :avatar, class: "form-input", accept: "image/*" %>
  </div>

  <%= f.submit class: "button--primary form--submit" %>
<% end %>
