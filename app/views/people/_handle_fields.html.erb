<%# locals: (form:) %>
<% handle = form.object %>
<div class="person--handle-row" data-person-handles-target="row">
  <div class="person--handle-row-fields">
    <%= form.hidden_field :id if handle.persisted? %>
    <%= form.hidden_field :position, value: handle.position || 0 %>

    <div class="form-group">
      <%= form.label :kind, "Type", class: "form-label" %>
      <%= form.select :kind,
            Person::Handle.kinds.keys.map { |kind| [ kind.humanize, kind ] },
            {},
            class: "form-input",
            data: { action: "person-handles#kindChanged" } %>
    </div>

    <div class="form-group person--handle-platform"
         data-person-handles-target="platformField"
         <%= "hidden" unless handle.handle? %>>
      <%= form.label :platform, "Platform", class: "form-label" %>
      <%= form.select :platform,
            options_for_select(
              Person::Handle::PLATFORMS.map { |key, config| [ config[:label], key ] },
              handle.platform
            ),
            { include_blank: "Choose platform" },
            class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :data, "Data", class: "form-label" %>
      <%= form.text_field :data,
            class: "form-input",
            autocomplete: handle.email? ? "email" : (handle.phone? ? "tel" : "off"),
            placeholder: handle.handle? ? "Handle or username" : nil,
            type: handle.email? ? "email" : (handle.phone? ? "tel" : "text"),
            data: { person_handles_target: "dataField" } %>
    </div>
  </div>

  <div class="person--handle-row-actions">
    <% if handle.persisted? %>
      <%= form.label :_destroy, class: "button--secondary person--handle-remove" do %>
        <%= form.check_box :_destroy, class: "utilities--sr-only", data: { person_handles_target: "destroyField" } %>
        Remove
      <% end %>
    <% else %>
      <button type="button"
              class="button--secondary person--handle-remove"
              data-action="person-handles#remove">
        Remove
      </button>
    <% end %>
  </div>
</div>
