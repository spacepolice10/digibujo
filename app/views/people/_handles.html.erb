<% if person.handles.any? %>
  <ul class="person--handles-list">
    <% person.handles.each do |handle| %>
      <li class="person--handles-list-item">
        <% if handle.href.present? %>
          <%= link_to handle.display_label, handle.href, class: "person--handle-link" %>
        <% else %>
          <span class="person--handle-text"><%= handle.display_label %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
