<%= link_to person_path(person),
      class: ["pill", person.colour.present? ? "pill--#{person.colour}" : nil].compact.join(" "),
      data: { turbo_frame: "_top" },
      aria: { label: "Person: #{person.name}" } do %>
  <% if person.avatar.attached? %>
    <%= image_tag person.avatar, class: "person--avatar", alt: "" %>
  <% elsif person.icon.present? %>
    <%= image_tag person.icon_path, alt: "", class: "form--list-icon" %>
  <% end %>
  <span><%= person.name %></span>
<% end %>
