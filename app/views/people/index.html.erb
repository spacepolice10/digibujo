<% content_for(:title) { "People" } %>

<div class="layout--page">
  <h2>People</h2>
  <div class="layout--header-actions">
    <%= link_to home_path, class: "button--tertiary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
      <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      Back
    <% end %>
    <%= link_to new_person_path, class: "button--tertiary", aria: { label: "Add person" } do %>
      <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
      Add person
    <% end %>
  </div>

  <turbo-frame id="people">
    <% if @people.any? %>
      <ul class="layout--list layout--surface">
        <%= render partial: "mentions/mention", collection: @people, as: :mention %>
      </ul>
    <% else %>
      <p>No people yet.</p>
    <% end %>
  </turbo-frame>
</div>
