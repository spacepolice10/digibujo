<li id="<%= dom_id(person, :list_item) %>" class="layout--list-item">
  <%= link_to person_path(person), { data: { turbo_frame: "_top" }, class: "bucket--list-item-link" } do %>
    <div class="bucket--list-item-name">
    <div class="bucket--list-item-marker" data-bucket-colour="<%= person.colour %>" aria-hidden="true">
      <% if person.avatar.attached? %>
        <%= image_tag person.avatar, class: "person--avatar", alt: "" %>
      <% else %>
        <%= image_tag person.icon_path, alt: "", class: "form--list-icon" %>
      <% end %>
    </div>
      <span class="utilities--line-clamp-1"><%= person.name %></span>
    </div>
    <div class="bucket--list-item-meta utilities--line-clamp-1">
      <span><%= person.bullets.count %> <%= "bullet".pluralize(person.bullets.count) %></span>,
      <span><%= person.created_at.strftime("%b %d") %></span>
    </div>
  <% end %>
</li>
