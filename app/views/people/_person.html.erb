<li id="<%= dom_id(person, :list_item) %>" class="layout--list-item">
  <%= link_to person_path(person), { data: { turbo_frame: "_top" }, class: "layout--list-item-link" } do %>

    <span aria-hidden="true">
      <% if person.avatar.attached? %>
        <%= image_tag person.avatar, style: "background-color: transparent", class: "person--avatar", alt: "" %>
      <% else %>
        <div class="person--avatar" aria-hidden="true">
          <%= person.initial %>
        </div>
      <% end %>
    </span>
    <span class="utilities--line-clamp-1"><%= person.name %></span>
    <div class="typography-description utilities--line-clamp-1">
      <span><%= person.bullets.count %> <%= "bullet".pluralize(person.bullets.count) %></span>,
      <span><%= person.created_at.strftime("%b %d") %></span>
    </div>
  <% end %>
</li>
