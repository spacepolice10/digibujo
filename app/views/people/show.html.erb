<% content_for(:title) { @person.name } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary" do %>
        <%= icon_tag("arrow-left", colour: "var(--color-stroke-base)") %>
        People
      <% end %>
      <%= render "mentions/pins_button",
            mention: @person,
            pin_path: people_pin_path,
            pin_params: { person_id: @person.id } %>
      <%= button_to person_path(@person),
            method: :delete,
            class: "button--secondary button--danger layout--rail-action",
            form: { data: { turbo_confirm: "Delete this person and remove them from all bullets?" } } do %>
        <i class="icon" style="--icon-mask: var(--icon-trash)" aria-hidden="true"></i>
        Delete
      <% end %>
    </div>
    <h2 class="layout--surface-name"><%= @person.name %></h2>
  </div>

  <div class="layout--surface">
    <div class="layout--list">
      <% if @bullets.any? %>
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                pagination_link_path: ->(next_param) { person_path(@person, page: next_param) }
              } do %>
          <% @page.records.each do |bullet| %>
            <%= render bullet %>
          <% end %>
        <% end %>
      <% else %>
        <p>No bullets yet.</p>
      <% end %>
    </div>
  </div>
</div>
