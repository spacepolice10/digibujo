<% content_for(:title) { "New person" } %>

<div class="layout--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to people_path, class: "button--secondary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
    </div>
    <h2>New person</h2>
  </div>
  <div class="layout--surface">
    <%= render "mentions/form",
          mention: @person,
          url: people_path,
          hint: "People let you tag bullets with a contact, so you can quickly pull up every task, note, or event tied to that person.",
          name_hint: "Name of the person." %>
  </div>
</div>
