<lexxy-prompt-item search="<%= person.name %>" sgid="<%= person.attachable_sgid %>">
  <template type="menu">
    <div class="bucket--list-item-name">
      <%= render "people/pill_graphic", person: person %>
      <span class="utilities--line-clamp-1"><%= person.name %></span>
      <kbd class="key">Tab</kbd>
    </div>
  </template>
  <template type="editor" content-type="application/vnd.actiontext.person">
    <%= render "people/attachable_editor", person: person %>
  </template>
</lexxy-prompt-item>
