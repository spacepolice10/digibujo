<% content_for(:title) { "Future Log" } %>

<div class="layout--page future">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary" do %>
        <i
          class="icon"
          style="--icon-mask: var(--icon-arrow-left)"
          aria-hidden="true"
        ></i>
        Home
      <% end %>
    </div>

    <h2><%= @future_bucket.name %></h2>
  </div>

  <div class="future--container">
    <%= render "future_buckets/monthly_grid", children: @children %>
    <%= render "future_buckets/unplanned", bullets: @bullets, future_bucket: @future_bucket %>
  </div>
</div>
