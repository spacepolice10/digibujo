
    <div class="future--grid" data-bulk-menu-target="list">
        <% children.each do |monthly_bucket| %>
          <% bucket = monthly_bucket.bucket %>

          <div class="future--card">
            <div class="future--card-header text-heading">
              <%= link_to monthly_bucket.name, monthly_bucket_path(monthly_bucket) %>
            </div>

            <div id="<%= dom_id(bucket, :unplanned) %>" class="future--card-content">
              <% unplanned = monthly_bucket.bullets.where(pops_on: nil).order(created_at: :asc).includes(:bulletable).first(6) %>

              <% unplanned.each do |bullet| %>
                <p class="text-description"><%= bullet.bulletable.name %></p>
                <%#= render "future_buckets/bullets/bullet", bullet: bullet %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= link_to "+ Add month", new_monthly_bucket_path, class: "future--create-monthly-bucket" %>
      </div>
