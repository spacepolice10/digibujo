<%# locals: (recurrency:, date:, tracker:, variant: :grid, dom_key: nil, content_only: false) %>
<% scheduled = recurrency.scheduled_on?(date) %>
<% chip = variant == :chip %>
<% dom_key ||= chip ? "header" : "cell" %>
<% completed = tracker.completed?(recurrency, date) %>
<% hint_id = dom_id(recurrency, :"hint_#{dom_key}_#{date.iso8601}") if chip %>
<% hint_anchor = "--hint-recurrency-#{recurrency.id}-#{dom_key}-#{date.iso8601}" if chip %>
<% chip_button_styles = chip && hint_anchor.present? ? [ "anchor-name: #{hint_anchor}" ] : [] %>
<% toggle = capture do %>
  <%= form_with url: recurrency_completion_path(recurrency),
        method: completed ? :delete : :post,
        **(chip || content_only ? {} : { id: dom_id(recurrency, "#{dom_key}_#{date.iso8601}") }),
        class: "recurrency--toggle-form#{' recurrency--toggle-form-cell' unless chip}",
        data: { turbo_stream: true } do %>
    <%= hidden_field_tag :date, date.iso8601 %>
    <%= hidden_field_tag :dom_key, dom_key %>
    <button type="submit"
            class="<%= chip ? "recurrency--chip bucket--list-item-marker#{' recurrency--chip-done' if completed}#{' recurrency--chip-neutral' unless completed}" : "recurrency--cell#{' recurrency--cell-done' if completed}" %>"
            <% if chip && completed && recurrency.colour.present? %>data-bucket-colour="<%= recurrency.colour %>"<% end %>
            <% if chip && hint_id.present? %>interestfor="<%= hint_id %>"<% end %>
            <% if chip_button_styles.any? %>style="<%= chip_button_styles.join("; ") %>"<% end %>
            aria-label="<%= completed ? "Mark #{recurrency.name} incomplete#{" on #{date}" unless chip}" : "Mark #{recurrency.name} complete#{" on #{date}" unless chip}" %>"
            aria-pressed="<%= completed %>">
      <% if chip %>
        <% if recurrency.icon_path %>
          <%= image_tag recurrency.icon_path, alt: "", class: "recurrency--chip-image" %>
        <% elsif recurrency.icon.present? %>
          <i class="icon" style="--icon-mask: <%= recurrency.icon_mask %>" aria-hidden="true"></i>
        <% else %>
          <span class="recurrency--chip-initial" aria-hidden="true"><%= recurrency.name.first.upcase %></span>
        <% end %>
      <% end %>
    </button>
  <% end %>
<% end %>
<% if chip %>
  <% if content_only %>
    <%= toggle %>
  <% else %>
    <div id="<%= dom_id(recurrency, "#{dom_key}_#{date.iso8601}") %>" class="recurrency--header-chip">
      <%= toggle %>
      <div id="<%= hint_id %>"
           class="hint"
           popover="hint"
           style="position-anchor: <%= hint_anchor %>">
        <%= recurrency_hint(recurrency, tracker: tracker, date: date) %>
      </div>
    </div>
  <% end %>
<% elsif content_only %>
  <%= toggle if scheduled %>
<% else %>
  <td class="recurrency--grid-cell<%= " recurrency--grid-cell-today" if date == Date.current %><%= " recurrency--grid-cell-muted" unless scheduled %>">
    <%= toggle if scheduled %>
  </td>
<% end %>
