<%# locals: (recurrency:, date:, tracker:) %>
<% scheduled = recurrency.scheduled_on?(date) %>
<td class="recurrency--grid-cell<%= " recurrency--grid-cell-today" if date == Date.current %><%= " recurrency--grid-cell-muted" unless scheduled %>">
  <% if scheduled %>
    <%= render "recurrencies/toggle", recurrency: recurrency, date: date, tracker: tracker, dom_key: "cell", appearance: :cell %>
  <% end %>
</td>
