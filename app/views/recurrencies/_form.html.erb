<%# locals: (recurrency:) %>
<%= form_with model: recurrency, class: "form form--strong" do |f| %>
  <% if recurrency.errors.any? %>
    <div class="form--errors" role="alert">
      <p><%= pluralize(recurrency.errors.count, "error") %> prevented this recurrency from being saved:</p>
      <ul>
        <% recurrency.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <small class="form-small">Recurrencies are repeating habits you want to build — mark them off each day on your daily log and track your consistency over time.</small>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <small class="form-small">Give your recurrency a name. Examples: Morning run, Meditate, Drink water.</small>
    <%= f.text_field :name, class: "form-input", required: true, autofocus: true %>
  </div>

  <%= render "shared/form/colour_picker", form: f %>
  <%= render "shared/form/icon_picker", form: f %>
  <%= render "shared/form/schedule_days_picker", form: f %>
  <%= f.submit class: "button--primary form--submit" %>
<% end %>
