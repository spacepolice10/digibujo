<% content_for(:title) { "Recurrency" } %>

<div class="layout--workspace layout--workspace-page">
  <aside class="layout--rail">
    <%= link_to new_recurrency_path, class: "button--primary layout--rail-action" do %>
      <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
      Add recurrency
    <% end %>
    <%= link_to home_path, class: "button--secondary layout--rail-action" do %>
      <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      Home
    <% end %>
  </aside>

  <div class="layout--surface">
    <div class="layout--header">
      <h2>Recurrency</h2>
      <p class="utilities--text-sm recurrency--index-description">
        Track recurring actions across your daily log and monthly spread.
      </p>
    </div>

    <% if @recurrencies.any? %>
      <ul class="layout--list recurrency--list">
        <% @recurrencies.each do |recurrency| %>
          <% stats = @tracker.stats(recurrency) %>
          <li class="layout--list-item recurrency--card<%= " recurrency--card-retired" if recurrency.retired? %>">
            <% if recurrency.colour.present? || recurrency.icon.present? %>
              <div class="recurrency--card-marker bucket--list-item-marker"
                   <% if recurrency.colour.present? %>data-bucket-colour="<%= recurrency.colour %>"<% end %>
                   aria-hidden="true">
                <% if recurrency.icon_path %>
                  <%= image_tag recurrency.icon_path, alt: "", class: "recurrency--chip-image" %>
                <% elsif recurrency.icon.present? %>
                  <i class="icon recurrency--chip-icon" style="--icon-mask: <%= recurrency.icon_mask %>" aria-hidden="true"></i>
                <% else %>
                  <span class="recurrency--chip-initial" aria-hidden="true"><%= recurrency.name.first.upcase %></span>
                <% end %>
              </div>
            <% end %>
            <%= link_to recurrency_path(recurrency), class: "recurrency--card-link" do %>
              <div class="recurrency--card-name">
                <span class="utilities--line-clamp-1"><%= recurrency.name %></span>
                <span class="recurrency--card-schedule pill"><%= recurrency.schedule_label %></span>
              </div>
              <div class="recurrency--card-meta utilities--text-sm utilities--line-clamp-1">
                <% if recurrency.retired? %>
                  <span>Ended <%= recurrency.active_to.strftime("%b %-d, %Y") %></span>
                <% else %>
                  <span>
                    <% if stats[:streak] > 0 %><%= stats[:streak] %> streak · <% end %>
                    <%= stats[:total] %> total ·
                    <%= stats[:period_scheduled].zero? ? 0 : ((stats[:period_completed] * 100.0) / stats[:period_scheduled]).round %>% this month
                  </span>
                <% end %>
              </div>
            <% end %>
            <%= link_to edit_recurrency_path(recurrency), class: "button--tertiary recurrency--card-edit", aria: { label: "Edit #{recurrency.name}" } do %>
              <i class="icon" style="--icon-mask: var(--icon-pencil)" aria-hidden="true"></i>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="recurrency--empty">No recurring actions yet. <%= link_to "Add one", new_recurrency_path %>.</p>
    <% end %>
  </div>
</div>
