<%# locals: (tracker:, period_days:, title: nil) %>
<section class="recurrency--tracker" aria-label="Recurrency tracker">
  <header class="recurrency--tracker-header">
    <h3 class="recurrency--tracker-title"><%= title || "Recurrency" %></h3>
    <% if period_days %>
      <% completed_count = tracker.recurrencies.sum { |r| tracker.stats(r)[:period_completed] } %>
      <% scheduled_count = tracker.recurrencies.sum { |r| tracker.stats(r)[:period_scheduled] } %>
      <span class="recurrency--tracker-summary utilities--text-sm">
        <%= completed_count %>/<%= scheduled_count %> marks
      </span>
    <% end %>
    <%= link_to "Manage", recurrencies_path, class: "button--tertiary" %>
  </header>

  <% if tracker.recurrencies.any? %>
    <div class="recurrency--grid-scroll">
      <table class="recurrency--grid">
        <thead>
          <tr>
            <th class="recurrency--grid-name-header" scope="col"></th>
            <% period_days.each do |date| %>
              <th scope="col"
                  class="recurrency--grid-day-header<%= " recurrency--grid-day-header-today" if date == Date.current %>">
                <span class="recurrency--grid-day-number"><%= date.day %></span>
                <span class="recurrency--grid-day-weekday"><%= date.strftime("%a") %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% tracker.recurrencies.each do |recurrency| %>
            <% stats = tracker.stats(recurrency) %>
            <tr>
              <th scope="row" class="recurrency--grid-name">
                <span class="recurrency--grid-name-label"><%= recurrency.name %></span>
                <span class="recurrency--grid-name-meta utilities--text-sm">
                  <% if stats[:streak] > 0 %><%= stats[:streak] %> streak · <% end %>
                  <%= stats[:period_completed] %>/<%= stats[:period_scheduled] %>
                </span>
              </th>
              <% period_days.each do |date| %>
                <%= render "recurrencies/cell", recurrency: recurrency, date: date, tracker: tracker %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="recurrency--tracker-empty utilities--text-sm">
      No recurring actions yet.
      <%= link_to "Add one", new_recurrency_path %>.
    </p>
  <% end %>
</section>
