<%# locals: (tracker:, date:) %>
<% scheduled_recurrencies = tracker.recurrencies.select { |recurrency| recurrency.scheduled_on?(date) } %>
<% if scheduled_recurrencies.any? %>
  <div class="recurrency--header-chips" role="group" aria-label="Recurrency for this day">
    <% scheduled_recurrencies.each do |recurrency| %>
      <%= render "recurrencies/header_chip", recurrency: recurrency, date: date, tracker: tracker %>
    <% end %>
  </div>
<% end %>
