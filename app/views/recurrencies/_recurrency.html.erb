<%# locals: (recurrency:, tracker:) %>
<% statistics = tracker.statistics(recurrency) %>
<li id="<%= dom_id(recurrency, :list_item) %>" class="layout--list-item">
  <%= link_to recurrency_path(recurrency), class: "bucket--list-item-link", data: { turbo_frame: "_top" } do %>
    <div class="bucket--list-item-name">
      <div class="bucket--list-item-marker"
           <% if recurrency.colour.present? %>data-bucket-colour="<%= recurrency.colour %>"<% end %>
           aria-hidden="true">
        <% if recurrency.icon_path %>
          <%= image_tag recurrency.icon_path, alt: "", class: "form--list-icon" %>
        <% elsif recurrency.icon.present? %>
          <i class="icon" style="--icon-mask: <%= recurrency.icon_mask %>" aria-hidden="true"></i>
        <% end %>
      </div>
      <span class="utilities--line-clamp-1"><%= recurrency.name %></span>
    </div>
    <div class="bucket--list-item-meta utilities--line-clamp-1">
      <span>
        <% if statistics[:streak] > 0 %><%= statistics[:streak] %> streak · <% end %>
        <%= statistics[:total] %> total ·
        <%= statistics[:period_scheduled].zero? ? 0 : ((statistics[:period_completed] * 100.0) / statistics[:period_scheduled]).round %>% this month
      </span>
    </div>
  <% end %>
</li>
