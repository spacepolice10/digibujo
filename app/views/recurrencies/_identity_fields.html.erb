<%# locals: (form:) %>
<div class="form-group">
  <span class="form-label">Colour</span>
  <div class="form--colour-picker" role="radiogroup" aria-label="Recurrency colour">
    <% Colourable::COLOUR_MAPPINGS.each_key do |name| %>
      <label class="form--colour-option">
        <%= form.radio_button :colour, name %>
        <span class="form--colour-swatch" style="background: <%= Colourable.colour_bg_variable_for(name) %>" aria-hidden="true"></span>
      </label>
    <% end %>
  </div>
</div>
<div class="form-group">
  <span class="form-label">Icon</span>
  <small class="form-hint">Pick an emoji to spot this recurrency in your daily log.</small>
  <div class="form--icon-picker" role="radiogroup" aria-label="Recurrency icon">
    <% Iconable::ICON_MAPPINGS.each do |key| %>
      <label class="form--icon-option">
        <%= form.radio_button :icon, key %>
        <%= image_tag "emoji/#{key}.svg", alt: "", class: "form--icon-image" %>
      </label>
    <% end %>
  </div>
</div>
