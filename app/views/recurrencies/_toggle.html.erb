<%# locals: (recurrency:, date:, tracker:, dom_key:, appearance: :chip) %>
<% completed = tracker.completed?(recurrency, date) %>
<% chip = appearance == :chip %>
<%= form_with url: recurrency_completion_path(recurrency),
      method: completed ? :delete : :post,
      id: dom_id(recurrency, "#{dom_key}_#{date.iso8601}"),
      class: "recurrency--toggle-form#{' recurrency--toggle-form-cell' if appearance == :cell}",
      data: { turbo_stream: true } do %>
  <%= hidden_field_tag :date, date.iso8601 %>
  <%= hidden_field_tag :dom_key, dom_key %>
  <button type="submit"
          class="<%= chip ? "recurrency--chip bucket--list-item-marker#{' recurrency--chip-done' if completed}#{' recurrency--chip-neutral' unless completed}" : "recurrency--cell#{' recurrency--cell-done' if completed}" %>"
          <% if chip && completed && recurrency.colour.present? %>data-bucket-colour="<%= recurrency.colour %>"<% end %>
          title="<%= chip ? recurrency.name : nil %>"
          aria-label="<%= completed ? "Mark #{recurrency.name} incomplete#{" on #{date}" unless chip}" : "Mark #{recurrency.name} complete#{" on #{date}" unless chip}" %>"
          aria-pressed="<%= completed %>">
    <% if chip %>
      <% if recurrency.icon_path %>
        <%= image_tag recurrency.icon_path, alt: "", class: "recurrency--chip-image" %>
      <% elsif recurrency.icon_variable %>
        <i class="icon recurrency--chip-icon" style="--icon-mask: <%= recurrency.icon_mask %>" aria-hidden="true"></i>
      <% else %>
        <span class="recurrency--chip-initial" aria-hidden="true"><%= recurrency.name.first.upcase %></span>
      <% end %>
    <% end %>
  </button>
<% end %>
