<%# locals: (bullet:) %>
<%= render layout: "bullets/bullet", locals: { bullet: } do %>
  <% if bullet.long? %>
    <div class="bullet--document">
      <h2 class="bullet--name"><%= bullet.name %></h2>
      <p><%= bullet.excerpt %></p>
      <%= link_to "Read more", bullet_path(bullet), class: "button read-more", data: { intent: "secondary", radius: "base", size: "sm", turbo_frame: "_top", action: "click->chat-scroll#preserveScrollPosition" } %>
    </div>
  <% else %>
    <div class="bullet--note"><%= bullet.excerpt %></div>
  <% end %>
<% end %>
