<% content_for(:title) { "Edit #{@tracker.name}" } %>

<div class="layout--page form--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to tracker_path(@tracker), class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
    </div>
    <h2>Edit tracker</h2>
  </div>
  <div class="form--surface">
    <%= render "form", tracker: @tracker %>
  </div>
</div>
