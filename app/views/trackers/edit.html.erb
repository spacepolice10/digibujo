<% content_for(:title) { "Edit #{@tracker.name}" } %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
      <%= back_link_to tracker_path(@tracker), class: 'button', data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h1>Edit tracker</h1>
      </nav>
    </header>
    <%= render "form", tracker: @tracker, name_hint: "Morning run, Meditate, Drink water." %>
  </article>
</main>
