<% content_for(:title) { @tracker.name } %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
  <header class="layout--container-header">
      <%= back_link_to trackers_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %><span>Trackers</span>
      <% end %>
      <h1><%= @tracker.name %></h1>

    <div class="layout--container-header-action dropdown--dock">

    <button
      type="button"
      class="button"
      data-intent="secondary"
      data-radius="full"
      data-size="xs"
      data-content="icon"
      popovertarget="tracker_actions"
      aria-label="Tracker options"
      aria-haspopup="menu"
    >
      <%= icon_tag("dots") %>
    </button>

    <div
      id="tracker_actions"
      class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
      style="position-anchor: tracker_actions"
      popover
      data-controller="grid-navigation"
      data-grid-navigation-columns-value="1"
      data-action="keydown->grid-navigation#navigate"
    >
      <div class="dropdown--element-body">
        <nav class="dropdown--menu" aria-label="Tracker options">


          <%= link_to edit_tracker_path(@tracker),
                class: "dropdown-item picker--item",
                data: { turbo_frame: "_top", grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
            <%= icon_tag("pencil") %>
            Edit
          <% end %>
        </nav>
      </div>
    </div>
  </div>
</header>

    <%= render "statistics", tracker: @tracker %>

    <section class="layout--surface" data-elevation="2" data-padding="true" aria-label="Last 30 days">

      <div class="tracker--heatmap">
        <% @heatmap_days.each do |day| %>
          <%= render "cell", tracker: @tracker, date: day %>
        <% end %>
      </div>
    </section>
  </div>
</main>
