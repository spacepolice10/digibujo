<% content_for(:title) { @tracker.name } %>

<div class="session-layout session-layout--app">
  <main class="session-layout--main session-layout--main-wide">
    <div class="session--page">
      <div class="form--surface">
        <h2 class="layout--surface-name"><%= @tracker.name %></h2>
        <header class="tracker--show-header">
          <div class="layout--header-actions">
            <%= link_to home_path, class: "button--secondary" do %>
              <i
                class="icon"
                style="--icon-mask: var(--icon-arrow-left)"
                aria-hidden="true"
              ></i>
              Back
            <% end %>
          </div>

          <div class="tracker--show-actions">
            <%= link_to "Edit", edit_tracker_path(@tracker), class: "button--secondary" %>

            <% if @tracker.open? %>
              <%= button_to tracker_stop_path(@tracker),
                    method: :post,
                    class: "button--secondary",
                    form: { data: { turbo_confirm: "Stop this tracker?" } } do %>
                Stop
              <% end %>
            <% end %>

            <%= button_to @tracker,
                  method: :delete,
                  class: "button--secondary button--danger",
                  form: { data: { turbo_confirm: "Delete this tracker?" } } do %>
              Delete
            <% end %>
          </div>
        </header>

        <% statistics = @tracker.statistics %>

        <dl class="tracker--statistics">
          <div>
            <dt>Current streak</dt>
            <dd><%= statistics[:streak] %></dd>
          </div>

          <div>
            <dt>Best streak</dt>
            <dd><%= statistics[:best_streak] %></dd>
          </div>

          <div>
            <dt>Total days</dt>
            <dd><%= statistics[:total] %></dd>
          </div>
        </dl>

        <section class="tracker--heatmap" aria-label="Last 90 days">
          <h2 class="tracker--heading">Last 90 days</h2>

          <div class="tracker--heatmap-days">
            <% @heatmap_days.each do |day| %>
              <%= render "cell", tracker: @tracker, date: day %>
            <% end %>
          </div>
        </section>
      </div>
    </div>
  </main>
</div>
