<% content_for(:title) { @tracker.name } %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
        <%= back_link_to trackers_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" }, aria: { label: "Back to Trackers" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>

        <h1><%= @tracker.name %></h1>
      </nav>

      <%= link_to edit_tracker_path(@tracker), class: "button", data: { intent: "secondary", radius: "full", size: "xs" } do %>
        <%= icon_tag("pencil") %> Edit
      <% end %>
    </header>


    <main>
      <section>
        <article data-elevation="1">
          <header>
            <h2>Current streak</h2>
          </header>
          <main><%= @tracker.statistics[:streak] %></main>
        </article>
        <article data-elevation="1">
          <header>
            <h2>Best streak</h2>
          </header>
          <main><%= @tracker.statistics[:best_streak] %></main>
        </article>
        <article data-elevation="1">
          <header>
            <h2>Total days</h2>
          </header>
          <main><%= @tracker.statistics[:total] %></main>
        </article>
      </section>
      <br>
      <div class="tracker--heatmap">
        <% @heatmap_days.each do |day| %>
          <%= render "cell", tracker: @tracker, date: day %>
        <% end %>
      </div>
    </main>
  </article>
</main>
