<% content_for(:title) { "Trackers" } %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
      <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" }, aria: { label: "Back to Home" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h1>Trackers</h1>
      </nav>
      <%= link_to new_tracker_path, class: "button", data: { intent: "primary", radius: "full", size: "xs" } do %>
        <%= icon_tag("plus") %><span>New</span>
      <% end %>
    </header>

    <main id="trackers">
      <% if @trackers.any? %>
        <section>
          <%= render partial: "trackers/tracker", collection: @trackers, as: :tracker %>
        </section>
      <% else %>
        <p class="typography--paragraph-sm">You haven't created any trackers yet. Try creating one to track your progress on doing sport, quitting smoking, or anything else.</p>
      <% end %>
    </main>
  </article>
</main>
