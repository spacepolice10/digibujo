<% content_for(:title) { "Trackers" } %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to home_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %><span>Home</span>
      <% end %>
      <h1>Trackers</h1>
      <%= link_to new_tracker_path, class: "button layout--container-header-action", data: { intent: "primary", radius: "full", size: "xs" } do %>
        <%= icon_tag("plus") %><span>Create</span>
      <% end %>
    </header>

    <div id="trackers">
      <% if @trackers.any? %>
        <div class="layout--flex" data-direction="column">
          <%= render partial: "trackers/tracker", collection: @trackers, as: :tracker %>
        </div>
      <% else %>
        <p class="typography--paragraph-sm">No trackers yet.</p>
      <% end %>
    </div>
  </div>
</main>
