<% if request.headers["Turbo-Frame"] == "pinned_list" %>
  <turbo-frame id="pinned_list" class="dropdown dropdown--element dropdown--element-up animations--side-in pinned--dropdown" popover>
    <%= render "pinned/entities_list", pinned_entities: @pinned_entities %>
  </turbo-frame>
<% else %>
  <% content_for(:title) { "Pinned" } %>

  <div class="layout--page layout--container layout--container-md">
    <div class="layout--mx-auto pinned--header">
      <%= icon_tag("pin", style: "color: var(--color-text-base);", class: "pinned--header-icon") %>
      <h2>Pinned</h2>
    </div>

    <div class="layout--surface">

      <% if @pinned_entities.any? %>
        <ul class="layout--list layout--padded pinned--list">
          <% @pinned_entities.each do |pinned_entity| %>
            <%= render "pinned/entity", pinned_entity: pinned_entity %>
          <% end %>
        </ul>
      <% else %>
        <p class="pinned--no-entities">Nothing pinned yet.</p>
      <% end %>
    </div>
  </div>
<% end %>
