<% if request.headers["Turbo-Frame"] == "pinned_list" %>
  <turbo-frame id="pinned_list" class="dropdown pinned--list" popover>
    <%= render "pinned/entities_list",
          pinned_entities: @pinned_entities,
          compact: true,
          popover: true %>
  </turbo-frame>
<% else %>
  <% content_for(:title, "Pinned") %>
  <div class="layout--page pinned--page" data-controller="bulk-menu">
    <section class="pinned--workspace">
      <%= render "pinned/entities_list",
            pinned_entities: @pinned_entities,
            compact: false,
            popover: false %>
    </section>
    <%= render "bullets/bulk_menu" %>
  </div>
<% end %>
