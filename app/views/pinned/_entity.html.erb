<% pinnable = pinned_entity.pinnable %>
<% path = case pinnable
   when Mention then public_send(:"#{pinnable.kind}_path", pinnable)
   when Bucket then polymorphic_path(pinnable.bucketable)
   else polymorphic_path(pinnable)
   end %>

<li id="<%= dom_id(pinnable, :list_item) %>" class="layout--list-item">
  <%= link_to path, class: "layout--list-item-link" do %>
    <div class="pointer-events-none">
      <% if pinnable.is_a?(Bullet) %>
        <i class="icon bullet--marker-type" style="--icon-mask: var(--icon-<%= pinnable.icon.to_s.dasherize %>)" aria-hidden="true"></i>
      <% elsif pinnable.is_a?(Mention) %>
        <%= render "mentions/mark", mention: pinnable %>
      <% else %>
        <%= image_tag pinnable.icon_path, alt: "", style: "background-color: transparent", class: "icon" %>
      <% end %>
      <%= pinnable.name %>
    </div>
  <% end %>
</li>
