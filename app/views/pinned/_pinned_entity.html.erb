<li class="layout--list-item" role="option">
  <%= link_to polymorphic_path(pinned_entity.pinnable),
        class: "pinned--entity-item",
        data: {
          turbo_frame: "_top",
          grid_navigation_target: "item",
          action: "focus->grid-navigation#syncPosition"
        } do %>
    <%= icon_tag(pinned_entity.pinnable.icon, style: "color: #{Colourable.colour_variable_of(pinned_entity.pinnable.colour)};", class: "home--section-list-item-icon") %>
    <span class="utilities--line-clamp-1"><%= pinned_entity.pinnable.name %></span>
  <% end %>
</li>
