<div class="pinned--dock">
  <button
    type="button"
    class="pill pinned--summary"
    popovertarget="pinned_bullets"
  >
    Pinned
  </button>
  <turbo-frame
    id="pinned_bullets"
    class="dropdown pinned--list"
    src="<%= pinned_index_path %>"
    loading="lazy"
    popover
  ></turbo-frame>
</div>
