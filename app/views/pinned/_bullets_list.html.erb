<div class="pinned--list-body">
  <button
    type="button"
    class="button--primary button--icon button--circle bulk-menu--hide"
    popovertarget="pinned_bullets"
    popovertargetaction="hide"
    aria-label="Close pinned bullets"
  >
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
  <div class="layout--list bucket--list">
    <% bullets.each do |bullet| %>
      <%= render_bullet_compact(bullet) %>
    <% end %>
  </div>
</div>
