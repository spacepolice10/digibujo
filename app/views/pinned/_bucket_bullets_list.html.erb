<div class="dropdown--header">
  <div class="bucket--list-item-name">
    <span class="bucket--list-item-marker" data-bucket-colour="<%= bucket.colour %>" aria-hidden="true">
      <% if bucket.icon.present? %>
        <i
          class="icon"
          style="--icon-mask: <%= bucket.icon_mask %>"
          aria-hidden="true"
        ></i>
      <% end %>
    </span>
    <h2><%= bucket.name %></h2>
  </div>
  <button
    type="button"
    class="button--secondary button--icon"
    popovertarget="<%= dom_id(bucket, :footer_bullets) %>"
    popovertargetaction="hide"
    aria-label="Close <%= bucket.name %>"
  >
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
</div>
<div class="bucket--list">
<% bullets.each do |bullet| %>
  <%= render partial: bullet.to_partial_path,
        locals: { bullet.bulletable_type.downcase.to_sym => bullet } %>
<% end %>
</div>
