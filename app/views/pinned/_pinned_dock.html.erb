<div class="pinned--dock">
  <button
    type="button"
    class="button--secondary button--circle hotkey-hint pinned--dock-button"
    popovertarget="pinned_list"
    data-controller="hotkey"
    data-hotkey="P"
    data-action="keydown.shift+p@document->hotkey#click"
    aria-label="Pinned"
    aria-keyshortcuts="Shift+P"
  >
    <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
  </button>
  <turbo-frame
    id="pinned_list"
    class="dropdown pinned--list"
    src="<%= pinned_index_path %>"
    loading="lazy"
    popover
  ></turbo-frame>
</div>
