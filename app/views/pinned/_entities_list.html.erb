<%# locals: (pinned_entities:) %>
<%= render "shared/dropdown", name: "Pinned", popover_target: "pinned_list" do %>
  <% if pinned_entities.any? %>
    <ul class="layout--list bucket--list">
      <% pinned_entities.each do |pinned_entity| %>
        <%= render "pinned/entity", pinned_entity: pinned_entity %>
      <% end %>
    </ul>
  <% else %>
    <p class="pinned--no-entities">Nothing pinned yet.</p>
  <% end %>
<% end %>
