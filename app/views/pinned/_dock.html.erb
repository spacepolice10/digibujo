<% if bullets.any? %>
  <div class="pinned--dock">
    <button
      type="button"
      class="button-secondary pinned--summary"
      popovertarget="pinned_bullets"
    >
      Pinned
    </button>
    <turbo-frame
      id="pinned_bullets"
      class="pinned--list"
      src="<%= pinned_index_path %>"
      loading="lazy"
      popover
    ></turbo-frame>
  </div>
  <% @buckets.each do |bucket| %>
    <%= bucket.name %>
  <% end %>
<% end %>
