<turbo-frame id="<%= dom_id(bucket, :pin_button) %>">
  <% if bucket.pinned? %>
    <%= button_to buckets_pin_path,
          method: :delete,
          params: { bucket_id: bucket.id },
          class: "button--secondary layout--rail-action bucket--list-item-pin",
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{bucket.name}" } do %>
      <i class="icon" style="--icon-mask: var(--icon-unpin)" aria-hidden="true"></i>
      Unpin
    <% end %>
  <% else %>
    <%= button_to buckets_pin_path,
          method: :post,
          params: { bucket_id: bucket.id },
          class: "button--secondary layout--rail-action",
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{bucket.name}" } do %>
      <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
      Pin
    <% end %>
  <% end %>
</turbo-frame>
