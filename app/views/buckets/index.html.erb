<div class="buckets--layout">
  <aside class="buckets--sidebar-left">
    <h4 class="buckets--sidebar-label">Create</h4>
    <%= link_to "+ Add collection", new_collection_path, class: "buckets--sidebar-action", data: { turbo_frame: "_top" } %>
    <%= link_to "+ Add monthly log", new_monthly_bucket_path, class: "buckets--sidebar-action", data: { turbo_frame: "_top" } %>
    <%= link_to "+ New project", new_project_path, class: "buckets--sidebar-action", data: { turbo_frame: "_top" } %>
  </aside>

  <div class="buckets--content">
    <% if @future %>
      <div class="layout--header">
        <h2 class="collection">Future</h2>
      </div>
      <ul class="layout--list bucket--list">
        <li id="<%= dom_id(@future, :list_item) %>" class="layout--list-item">
          <%= link_to future_path, class: "bucket--list-item-link" do %>
            <div class="bucket--list-item-name">
              <div class="bucket--list-item-marker" data-bucket-colour="<%= @future.colour %>" aria-hidden="true"></div>
              <span class="utilities--line-clamp-1"><%= @future.name %></span>
            </div>
            <div class="utilities--line-clamp-1">
              <span><%= @future.bucketable.monthly_buckets.count %> months</span>
            </div>
          <% end %>
        </li>
      </ul>
    <% end %>

    <div class="layout--header">
      <h2 class="project">Projects</h2>
    </div>
    <ul class="layout--list bucket--list">
      <%= render @projects %>
    </ul>
    <% if @projects.count >= 8 %>
      <%= link_to "Show more", projects_path, class: "button--secondary", "aria-label": "All projects", data: { turbo_frame: "_top" } %>
    <% end %>

    <div class="layout--header">
      <h2 class="collection">Collections</h2>
    </div>
    <ul class="layout--list bucket--list">
      <%= render @collections.select { |c| c.bucket != @future } %>
    </ul>
    <% if @collections.count >= 8 %>
      <%= link_to "Show more", collections_path, class: "button--secondary", "aria-label": "All collections", data: { turbo_frame: "_top" } %>
    <% end %>

    <div class="layout--header">
      <h2 class="monthly-bucket">Monthly spreads</h2>
    </div>
    <ul class="layout--list bucket--list">
      <%= render partial: "monthly_buckets/monthly_bucket", collection: @monthly_buckets, as: :monthly_bucket %>
    </ul>
  </div>

  <aside class="buckets--sidebar-right">
    <h4 class="buckets--sidebar-label">Activity</h4>
    <div class="buckets--activity-list">
      <% if @activities.any? %>
        <% @activities.each do |activity| %>
          <div class="buckets--activity-item">
            <span class="buckets--activity-bullet"><%= activity.bullet.name.truncate(60) %></span>
            <span class="buckets--activity-meta">
              <%= time_ago_in_words(activity.created_at) %> ago
              <span class="buckets--activity-action"><%= activity.action_name %></span>
            </span>
          </div>
        <% end %>
        <%= link_to "View all", activities_path, class: "button--tertiary", data: { turbo_frame: "_top" } %>
      <% else %>
        <p class="buckets--activity-item utilities--text-sm" style="color: var(--color-fg-subtle);">No recent activity</p>
      <% end %>
    </div>
  </aside>
</div>
