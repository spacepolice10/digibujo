<nav class="bucket--layout">
<div class="bucket--header">
        <h2 class="project">Projects</h2>
        <div class="bucket--header-actions">
        <%= link_to "View All", projects_path, class: "button-secondary", "aria-label": "All projects", data: { turbo_frame: "_top" } %>
        <%= link_to "New project", new_project_path, class: "button-primary", data: { turbo_frame: "_top" } %>
        </div>
      </div>
      <ul class="bucket--list">
      <%= render @projects %>
      </ul>


<div class="bucket--header">
        <h2 class="collection">Collections</h2>
        <div class="bucket--header-actions">
        <%= link_to "View All", collections_path, class: "button-secondary", "aria-label": "All collections", data: { turbo_frame: "_top" } %>
        <%= link_to "New collection", new_collection_path, class: "button-primary", data: { turbo_frame: "_top" } %>
        </div>
      </div>
      <ul class="bucket--list">
        <%= render @collections %>
      </ul>
</nav>
