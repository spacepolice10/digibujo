
<% date_anchor = bullet.pops_on || selected_date || Date.current %>

  <%= form_with url: bullet_pop_path(bullet), method: :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :pops_on, (date_anchor + 1.day).iso8601 %>
    <%= button_tag type: :submit, class: "bullet-dropdown-item", data: { "grid-navigation-target" => "item" } do %>
      <span class="bullet-dropdown-icon bullet-dropdown-icon--postpone">
        <span class="icon" style="--icon-mask: var(--icon-arrow-up)"></span>
      </span>
      <span class="bullet-dropdown-text">
        <span class="bullet-dropdown-label">Postpone</span>
        <span class="bullet-dropdown-desc">Move to the next day</span>
      </span>
    <% end %>
  <% end %>
