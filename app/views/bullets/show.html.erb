<% content_for(:title) { @bullet.name } %>

<main data-size="md">
  <article data-elevation="1">

    <header>
      <nav>
      <%= back_link_to search_path, data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
        <%= icon("arrow-left", style: "color: var(--color-invert-2);") %>
        <% end %>
      </nav>

      <nav>
        <button type="button" data-intent="secondary" data-radius="full" data-size="sm" data-content="icon" aria-label="Actions" aria-haspopup="menu" popovertarget="<%= dom_id(@bullet, :actions) %>">
          <%= icon("dots", style: "color: var(--color-invert-2);") %>
        </button>
        <div id="<%= dom_id(@bullet, :actions) %>"
             style="position-anchor: <%= dom_id(@bullet, :actions) %>"
             popover
             data-controller="grid-navigation"
             data-grid-navigation-columns-value="1"
             data-action="keydown->grid-navigation#navigate">
          <div class="dropdown--element-body">
            <nav class="dropdown--menu" aria-label="Actions">
              <% if @bullet.published? %>
                <%= button_to publish_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unpublish #{@bullet.name}" } do %>
                  <%= icon("link") %>
                  Unpublish
                <% end %>
              <% else %>
                <%= button_to publish_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Publish #{@bullet.name}" } do %>
                  <%= icon("link") %>
                  Publish
                <% end %>
              <% end %>

              <% if @bullet.archived? %>
                <%= button_to archive_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unarchive #{@bullet.name}" } do %>
                  <%= icon("archive") %>
                  Unarchive
                <% end %>
              <% else %>
                <%= button_to archive_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      form: { data: { turbo_confirm: "Are you sure?" } },
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Archive #{@bullet.name}" } do %>
                  <%= icon("archive") %>
                  Archive
                <% end %>
              <% end %>
            </nav>
          </div>
        </div>
      </nav>
    </header>

    <main class="bullet--show">
      <div class="bullet--show-published-link">
      <% if @bullet.published? %>
        <input <%# herb:disable html-input-require-autocomplete %>
          type="text"
          value="<%= published_url(@bullet.public_code) %>"
          readonly
          onclick="this.select()"
          class="bullet--published-link"
        >
        <% end %>
      </div>

      <% if @bullet.file.attached? %>
        <% file = @bullet.file %>
        <% if file.variable? %>
          <%= image_tag file.variant(:display), alt: file.filename.to_s, class: "attachment--image" %>
        <% else %>
          <%= link_to rails_blob_path(file, disposition: "attachment"), class: "attachment--file", data: { turbo: false } do %>
            <%= icon("paperclip") %>
            <span class="attachment--file-name"><%= file.filename %></span>
            <small><%= number_to_human_size(file.byte_size) %></small>
          <% end %>
        <% end %>
        <div><small class="bullet--filename"><%= @bullet.filename %></small></div>
      <% else %>
        <div class="bullet--show-body">
          <%= @bullet.body %>
        </div>
      <% end %>
    </main>
  </article>
</main>
