<% content_for(:title, @bullet.name) %>

<%= render "shared/back_tabbar" %>

<main class="timeline--window timeline--window--focus" data-size="md">
  <header>
    <h1><%= @bullet.name %></h1>

    <% if @bullet.published? %>
      <input <%# herb:disable html-input-require-autocomplete %>
        type="text"
        value="<%= published_url(@bullet.public_code) %>"
        readonly
        onclick="this.select()"
        class="bullet--published-link"
      >
    <% end %>

    <div class="dropdown--dock">
      <button
        type="button"
        data-intent="secondary"
        data-radius="full"
        data-size="xs"
        data-content="icon"
        popovertarget="bullet_actions"
        aria-label="Bullet options"
        aria-haspopup="menu"
      >
        <%= icon("dots") %>
      </button>

      <div
        id="bullet_actions"
        role="menu"
        style="position-anchor: bullet_actions"
        popover
        data-controller="grid-navigation"
        data-grid-navigation-columns-value="1"
        data-action="keydown->grid-navigation#navigate"
      >
        <nav role="listbox" aria-label="Bullet options">
          <%= button_to publish_path,
                method: @bullet.published? ? :delete : :post,
                params: { bullet_ids: @bullet.id },
                class: "dropdown-item picker--item",
                form_class: "dropdown--menu-form",
                data: {
                  grid_navigation_target: "item",
                  action: "focus->grid-navigation#syncPosition"
                },
                aria: { label: "#{@bullet.published? ? 'Unpublish' : 'Publish'} #{@bullet.name}" } do %>
            <%= icon("link") %>
            <%= @bullet.published? ? "Unpublish" : "Publish" %>
          <% end %>

          <%= button_to archive_path,
                method: @bullet.archived? ? :delete : :post,
                params: { bullet_ids: @bullet.id },
                class: "dropdown-item picker--item",
                form_class: "dropdown--menu-form",
                form: (@bullet.archived? ? {} : { data: { turbo_confirm: "Are you sure?" } }),
                data: {
                  grid_navigation_target: "item",
                  action: "focus->grid-navigation#syncPosition"
                },
                aria: { label: "#{@bullet.archived? ? 'Unarchive' : 'Archive'} #{@bullet.name}" } do %>
            <%= icon("archive") %>
            <%= @bullet.archived? ? "Unarchive" : "Archive" %>
          <% end %>
        </nav>
      </div>
    </div>
  </header>

  <div
    id="timeline"
    class="timeline--scroller"
    data-controller="timeline-scroll"
    data-timeline-scroll-focus-value="true"
  >
    <section id="timeline_section_<%= @timeline.section_of(@bullet.pops_on).key %>" class="timeline--section">
      <h2 class="pill"><%= @bullet.pops_on.strftime("%A, %b %-d") %></h2>
      <% @bullets.each do |bullet| %>
        <% if bullet == @bullet %>
          <%= render "bullets/current_bullet", bullet: bullet %>
        <% else %>
          <%= render "bullets/bullet", bullet: bullet %>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
