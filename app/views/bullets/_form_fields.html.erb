<%# locals: (f:, bullet:, submitted_attributes: {}, editing: false) %>
<% editor_value = bullet.editor_content_for_form %>
<% expand_dialog_id = dom_id(bullet, :expand) %>
<% type_name = bullet.bulletable_type.presence || Bullet::DEFAULT_COMPOSER_TYPE %>
<% bulletable_form = bullet.bulletable || type_name.constantize.new %>

<% bullet_column_names = %w[pops_on bucket_id] %>
<% submitted_attributes.each do |name, value| %>
  <% if bullet_column_names.include?(name.to_s) %>
    <%= f.hidden_field name, value: value %>
  <% else %>
    <%= hidden_field_tag "bullet[#{name}]", value %>
  <% end %>
<% end %>

<%= f.check_box :indented,
      class: "utilities--sr-only",
      data: { bullet_composer_target: "indentField" } %>

<div class="bullet-form-composer">
  <%= f.rich_text_area :body,
        value: editor_value,
        autofocus: !editing,
        placeholder: "What's on your mind?",
        multiline: false,
        rows: 1,
        preset: "inline" do %>
    <lexxy-prompt trigger="#"
                  name="project"
                  src="<%= project_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="@"
                  name="person"
                  src="<%= person_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="/" name="action">
      <% unless editing %>
        <% Bullet::COMPOSER_TYPE_OPTIONS.each do |entry| %>
          <lexxy-prompt-item search="<%= entry[:value].downcase %>">
            <template type="menu">
              <button type="button"
                      data-action="bullet-composer#selectType"
                      data-type="<%= entry[:value] %>">
                <%= entry[:label] %>
              </button>
            </template>
          </lexxy-prompt-item>
        <% end %>
      <% end %>
      <lexxy-prompt-item search="attachment">
        <template type="menu">
          <button type="button" data-action="bullet-composer#pickFile">Attachment</button>
        </template>
      </lexxy-prompt-item>
    </lexxy-prompt>
  <% end %>
</div>

<%= render "bullets/rich_body_preview", bullet: bullet %>

<div class="attachment--previews"
     data-bullet-composer-target="previews"
     hidden></div>

<div data-bullet-composer-target="attachmentsField"></div>

<div class="bullet-form-rail">
  <% unless editing %>
    <%= render "bullets/type_select", f: f, selected_type: type_name %>
  <% else %>
    <%= f.hidden_field :bulletable_type %>
  <% end %>

  <div class="bullet-form-note-options"
       data-bullet-composer-target="noteOptions"
       <%= "hidden" unless type_name == "Note" %>>
    <% note_form = bullet.bulletable.is_a?(Note) ? bullet.bulletable : Note.new %>
    <%= f.fields_for :bulletable, note_form do |nf| %>
      <div class="mood-picker">
        <% moods = { positive: "😊", negative: "😞", inspired: "✨", frustrated: "😣" } %>
        <% moods.each do |name, emoji| %>
          <label class="mood-option">
            <%= nf.radio_button :mood, name, class: "utilities--sr-only" %>
            <span class="mood_marker" title="<%= name.to_s.humanize %>" aria-hidden="true"><%= emoji %></span>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="bullet-form-rail-actions">
    <%= render "bullets/actions_select", bullet: bullet %>

    <div class="bullet-form-rail-submit">
      <%= f.button type: "submit", class: "button--primary button--icon button--circle" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-up)" aria-hidden="true"></i>
      <% end %>
    </div>
  </div>
</div>

<%= render "shared/dialog", id: expand_dialog_id, class: "dialog--large", data_target: "expandDialog" do %>
  <div class="bullet-form-expand">
    <h2 class="bullet-form-expand-title">Expanded content</h2>
    <%= f.rich_text_area :rich_body,
          placeholder: "Code, files, markdown…",
          preset: "expand" do %>
      <lexxy-prompt trigger="#"
                    name="project"
                    src="<%= project_suggestions_path %>"
                    remote-filtering
                    supports-space-in-searches>
      </lexxy-prompt>
      <lexxy-prompt trigger="@"
                    name="person"
                    src="<%= person_suggestions_path %>"
                    remote-filtering
                    supports-space-in-searches>
      </lexxy-prompt>
    <% end %>
    <div class="bullet-form-expand-footer">
      <button type="button"
              class="button--secondary"
              commandfor="<%= expand_dialog_id %>"
              command="close">
        Cancel
      </button>
      <button type="button"
              class="button--primary"
              data-action="bullet-composer#saveExpand">
        Save
      </button>
    </div>
  </div>
<% end %>
