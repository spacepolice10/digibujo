<% content_for(:title) { "Edit bullet" } %>

<% bullet_colour = colour(@bullet.colour) || "var(--#{@bullet.bulletable_type.downcase}-color)" %>

<main data-size="md">
  <article data-elevation="1">
  <header><nav>
    <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
      <%= icon_tag("arrow-left", style: "color: var(--color-invert-2);") %>
    <% end %>
  </nav></header>
  <main>

                   <%= form_with model: @bullet, url: bullet_path(@bullet), method: :put, class: "utilities--contents" do |f| %>
                   <%= f.rich_text_area :body, autofocus: true %>
                   <%= f.submit "Save", class: "button", data: { intent: "primary", radius: "full", size: "sm" } %>
                 <% end %>
  </main>
  </article>
</main>
