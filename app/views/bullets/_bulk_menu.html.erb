<div
  class="bulk-menu"
  data-bulk-menu-target="menu"
  data-action="keydown.esc@document->bulk-menu#escape"
  tabindex="0"
  hidden
>
  <header>
    <h2 class="utilities--sr-only">Bulk edit</h2>
  </header>

  <div class="bulk-menu--actions">
    <%= form_with url: completion_path, method: :post,
          class: "utilities--contents",
          data: { turbo_stream: true, bulk_menu_target: "complete" },
          html: { hidden: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>

      <%= button_tag type: :submit,
            class: "hotkey-hint hotkey-hint--always bulk-menu--action-button",
            data: {
              intent: "secondary",
              radius: "base",
              size: "sm",
              controller: "hotkey",
              hotkey: "C",
              action: "keydown.c@document->hotkey#click"
            },
            aria: { keyshortcuts: "C" } do %>
        <%= icon("check") %> Complete
      <% end %>
    <% end %>

    <%= form_with url: completion_path, method: :delete,
          data: { turbo_stream: true, bulk_menu_target: "uncomplete" },
          html: { hidden: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>

      <%= button_tag type: :submit,
            class: "hotkey-hint hotkey-hint--always bulk-menu--action-button",
            data: {
              intent: "secondary",
              radius: "base",
              size: "sm",
              controller: "hotkey",
              hotkey: "U",
              action: "keydown.u@document->hotkey#click"
            },
            aria: { keyshortcuts: "U" } do %>
        <%= icon("square") %> Uncomplete
      <% end %>
    <% end %>

    <%= form_with url: publish_path, method: :post,
          class: "utilities--contents",
          data: { turbo_stream: true, bulk_menu_target: "publish" },
          html: { hidden: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>

      <%= button_tag type: :submit,
            class: "hotkey-hint hotkey-hint--always bulk-menu--action-button",
            data: {
              intent: "secondary",
              radius: "base",
              size: "sm",
              controller: "hotkey",
              hotkey: "Shift+P",
              action: "keydown.shift+p@document->hotkey#click"
            },
            aria: { keyshortcuts: "Shift+P" } do %>
        <%= icon("link") %> Publish
      <% end %>
    <% end %>

    <%= form_with url: publish_path, method: :delete,
          class: "utilities--contents",
          data: { turbo_stream: true, bulk_menu_target: "unpublish" },
          html: { hidden: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>

      <%= button_tag type: :submit,
            class: "hotkey-hint hotkey-hint--always bulk-menu--action-button",
            data: {
              intent: "secondary",
              radius: "base",
              size: "sm",
              controller: "hotkey",
              hotkey: "Shift+P",
              action: "keydown.shift+p@document->hotkey#click"
            },
            aria: { keyshortcuts: "Shift+P" } do %>
        <%= icon("link") %> Unpublish
      <% end %>
    <% end %>

    <%= form_with url: archive_path, method: :post,
          class: "utilities--contents",
          data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>

      <%= button_tag type: :submit,
            class: "hotkey-hint hotkey-hint--always bulk-menu--action-button",
            data: {
              intent: "secondary",
              radius: "base",
              size: "sm",
              controller: "hotkey",
              hotkey: "A",
              action: "keydown.a@document->hotkey#click"
            },
            aria: { keyshortcuts: "A" } do %>
        <%= icon("archive") %> Archive
      <% end %>
    <% end %>

    <button
      type="button"
      class="hotkey-hint hotkey-hint--always bulk-menu--action-button"
      data-controller="hotkey"
      data-intent="secondary"
      data-radius="base"
      data-size="sm"
      data-hotkey="L"
      data-action="bulk-menu#openPopsPicker keydown.l@document->hotkey#click"
      aria-keyshortcuts="L"
    >
      <%= icon("arrow-up") %> Later
    </button>

    <button
      type="button"
      class="hotkey-hint hotkey-hint--always bulk-menu--action-button"
      data-controller="hotkey"
      data-intent="secondary"
      data-radius="base"
      data-size="sm"
      data-hotkey="S"
      data-action="bulk-menu#openCollectsPicker keydown.s@document->hotkey#click"
      aria-keyshortcuts="S"
    >
      <%= icon("arrow-left") %> Save
    </button>
  </div>

  <p class="bulk-menu--amount" data-bulk-menu-target="amount">0 selected</p>

  <button
    type="button"
    class="utilities--mx-auto"
    data-intent="primary"
    data-radius="base"
    data-size="sm"
    data-action="bulk-menu#clear"
    aria-label="Clear selection"
  >
    <p>Clear selection</p>
  </button>
</div>

<%= render "shared/dialog",
      id: "postpone_picker_dialog",
      standalone: true,
      size: "sm" do %>
  <turbo-frame
    id="postpone_picker_dialog"
    data-bulk-menu-target="popsDialog"
    loading="lazy"
    data-controller="grid-navigation"
    data-grid-navigation-columns-value="1"
    data-action="keydown->grid-navigation#navigate"
  ></turbo-frame>
<% end %>

<%= render "shared/dialog",
      id: "collects_picker_dialog",
      standalone: true,
      size: "lg" do %>
  <turbo-frame
    id="collects_picker_dialog"
    data-bulk-menu-target="collectsDialog"
    loading="lazy"
  ></turbo-frame>
<% end %>
