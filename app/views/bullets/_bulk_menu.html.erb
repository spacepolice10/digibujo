<div class="bulk-menu"
     data-bullets-bulk-target="menu"
     data-action="turbo:submit-end->bullets-bulk#submitEnd"
     hidden>
  <p class="bulk-menu--count" data-bullets-bulk-target="count">0 selected</p>

  <button type="button"
          class="button-tertiary bulk-menu--clear"
          data-action="bullets-bulk#clear">
    Clear
  </button>

  <div class="bulk-menu--actions">
    <div data-bullets-bulk-target="pinAction" hidden>
      <%= form_with url: pin_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
        <%= button_tag type: :submit, class: "button-secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
          Pin
        <% end %>
      <% end %>
    </div>

    <div data-bullets-bulk-target="unpinAction" hidden>
      <%= form_with url: pin_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
        <%= button_tag type: :submit, class: "button-secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
          Unpin
        <% end %>
      <% end %>
    </div>

    <%= form_with url: archive_path, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
      <%= button_tag type: :submit, class: "button-secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
        Archive
      <% end %>
    <% end %>

    <%= form_with url: archive_path, method: :delete, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
      <%= button_tag type: :submit, class: "button-secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
        Unarchive
      <% end %>
    <% end %>

    <div class="bulk-menu--pops-dock">
      <%= form_with url: new_pop_path, method: :get, data: { turbo_frame: "pop_picker" } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
        <%= button_tag type: :submit,
              class: "button-secondary",
              popovertarget: "pop_picker" do %>
          <i class="icon" style="--icon-mask: var(--icon-arrow-up)" aria-hidden="true"></i>
          Pop
        <% end %>
      <% end %>
      <turbo-frame id="pop_picker" class="bulk-menu--pops-menu" popover></turbo-frame>
    </div>

    <%= form_with url: new_collect_path, method: :get, data: { turbo_frame: "modal" } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
      <%= button_tag type: :submit, class: "button-secondary", data: { action: "click->dialog#open" } do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Collect
      <% end %>
    <% end %>

    <%= form_with url: collect_path, method: :delete, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bullets_bulk_target: "idsInput" } %>
      <%= button_tag type: :submit, class: "button-secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Uncollect
      <% end %>
    <% end %>
  </div>
</div>
