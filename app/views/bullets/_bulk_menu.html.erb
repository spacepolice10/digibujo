<div class="bulk-menu"
     data-bulk-menu-target="menu"
     data-action="turbo:submit-end->bulk-menu#submitEnd keydown.esc->bulk-menu#clear"
     tabindex="0"
     hidden>


  <div class="bulk-menu--actions">
    <div data-bulk-menu-target="pinAction" hidden>
      <%= form_with url: pin_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
          Pin
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="unpinAction" hidden>
      <%= form_with url: pin_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
          Unpin
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="completeAction" hidden>
      <%= form_with url: complete_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-check)" aria-hidden="true"></i>
          Complete
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="uncompleteAction" hidden>
      <%= form_with url: complete_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <i class="icon" style="--icon-mask: var(--icon-square)" aria-hidden="true"></i>
          Uncomplete
        <% end %>
      <% end %>
    </div>

    <%= form_with url: archive_path, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
      <%= button_tag type: :submit, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
        Archive
      <% end %>
    <% end %>

    <%= form_with url: archive_path, method: :delete, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
      <%= button_tag type: :submit, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
        Unarchive
      <% end %>
    <% end %>

    <div class="bulk-menu--action-dock">
      <button type="button"
              class="button--secondary"
              data-action="bulk-menu#openPopsPicker">
        <i class="icon" style="--icon-mask: var(--icon-arrow-up)" aria-hidden="true"></i>
        Pop
      </button>
      <turbo-frame id="pops_picker_frame"
                   class="bulk-menu--action-menu bulk-menu--action-frame"
                   popover
                   loading="lazy"
                   data-bulk-menu-target="popsFrame"></turbo-frame>
    </div>

    <div class="bulk-menu--action-dock">
      <button type="button"
              class="button--secondary"
              data-action="bulk-menu#openCollectsPicker">
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Collect
      </button>
      <turbo-frame id="collects_picker_frame"
                   class="bulk-menu--action-menu bulk-menu--action-frame"
                   popover
                   loading="lazy"
                   data-bulk-menu-target="collectsFrame"></turbo-frame>
    </div>

    <% if local_assigns[:review_migrate] %>
      <%= form_with url: review_migrate_path(from: review_migrate[:from].iso8601, to: review_migrate[:to].iso8601),
                    method: :post,
                    data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <span class="review--migration-mark" aria-hidden="true">›</span>
          Mark migrated
        <% end %>
      <% end %>
    <% end %>

      <button
    type="button"
    class="button--primary button--icon button--circle bulk-menu--hide"
    data-action="bulk-menu#clear"
  >
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
  </div>  <p class="bulk-menu--amount" data-bulk-menu-target="amount">0 selected</p>
</div>
