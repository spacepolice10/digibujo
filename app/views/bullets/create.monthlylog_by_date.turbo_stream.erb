<% monthlylog = Current.user.monthlylogs.find(@monthlylog_id) %>
<% date = @bullet.pops_on %>

<%= turbo_stream.append dom_id(monthlylog, "date_#{date}_bullets") do %>
  <%= render_bullet_compact(@bullet) %>
<% end %>

<%= turbo_stream.update dom_id(monthlylog, "date_#{date}_composer") do %>
  <%= render "monthlylogs/day_composer", monthlylog: monthlylog, date: date, bucket: @bullet.bucket %>
<% end %>
