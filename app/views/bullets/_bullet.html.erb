<%# locals: (bullet:) %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-done="<%= bullet.done? ? "true" : "false" %>">
  <label
  class="bullet--select-checkbox"
  for="<%= dom_id(bullet, :select_checkbox) %>"
  aria-label="Select bullet"
  ></label>
  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-publishable="<%= bullet.published? ? "published" : "unpublished" %>"
    data-bulk-scheduled="<%= bullet.pops_on == Date.current ? "today" : "not-today" %>"
    data-bulk-completable="<%= bullet.done? ? "completed" : "incomplete" %>"
    data-bulk-menu-target="checkbox"
    data-action="bulk-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--content">
    <div class="bullet--body">
      <label
        class="bullet--marker"
        for="<%= dom_id(bullet, :select_checkbox) %>"
        aria-label="Select bullet"
      >
        <span aria-hidden="true" style="display: flex;">
          <%= icon(bullet.marker_icon.to_s.dasherize, class: "bullet--marker-icon") %>
          <span class="bullet--marker-select-indicator" aria-hidden="true"></span>
        </span>
      </label>
      <% if bullet.file.attached? %>
        <% file = bullet.file %>
        <% if file.variable? %>
          <% width, height = file.blob.metadata.values_at("width", "height") %>
          <%= link_to attachment_path(file.blob.signed_id), class: "attachment--image-link", data: { turbo_frame: "_top" } do %>
            <%= image_tag file.variant(:thumb),
                  alt: file.filename.to_s,
                  class: "attachment--image",
                  style: (width.present? && height.present? ? "aspect-ratio: #{width} / #{height}" : nil) %>
          <% end %>
        <% else %>
          <%= link_to rails_blob_path(file, disposition: "attachment"), class: "attachment--file", data: { turbo: false } do %>
            <%= icon("paperclip") %>
            <span class="attachment--file-name utilities--line-clamp-1"><%= file.filename %></span>
            <small><%= number_to_human_size(file.byte_size) %></small>
          <% end %>
        <% end %>
      <% else %>
        <div class="bullet--note"><%= bullet.body %></div>
      <% end %>
    </div>
    <% if bullet.file.attached? %>
      <small class="bullet--filename"><%= bullet.filename %></small>
    <% end %>
  </div>
</turbo-frame>
