<%# locals: (bullet:) %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-type="<%= bullet.bulletable_type.downcase %>" data-bullet-done="<%= bullet.done? ? "true" : "false" %>"
  data-bullet-data-attributes="<%= bullet.data_attributes.to_json %>">
  <label
  class="bullet--select-checkbox"
  for="<%= dom_id(bullet, :select_checkbox) %>"
  aria-label="Select bullet"
  ></label>
  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-publishable="<%= bullet.published? ? "published" : "unpublished" %>"
    data-bulk-scheduled="<%= bullet.collection_id.nil? && bullet.pops_on == Date.current ? "today" : "not-today" %>"
    data-bulk-completable="<%= bullet.done? ? "completed" : "incomplete" %>"
    data-bulk-menu-target="checkbox"
    data-action="bulk-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--rail">
    <label
      class="bullet--marker"
      for="<%= dom_id(bullet, :select_checkbox) %>"
      aria-label="Select bullet"
    >
      <span aria-hidden="true" style="display: flex;">
        <%= icon_tag(bullet.marker_icon.to_s.dasherize, class: "bullet--marker-icon") %>
        <span class="bullet--marker-select-indicator" aria-hidden="true"></span>
      </span>
    </label>
  </div>

  <div class="bullet--content">
    <div class="bullet--body">
      <%= yield %>
    </div>
  </div>
</turbo-frame>
