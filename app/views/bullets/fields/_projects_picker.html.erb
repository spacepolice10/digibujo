<% field_name = local_assigns.fetch(:field_name, "bullet[bucket_id]") %>
<% bucket = bullet.bucket if bullet.bucket&.bucketable_type == "Project" %>
<% project = bucket&.bucketable %>
<% initial_project = if bucket && project
     { id: project.id, bucketId: bucket.id, name: project.name, colour: project.colour, icon: project.icon }.compact
   else
     {}
   end %>
<% dialog_id = local_assigns.fetch(:dialog_id) { dom_id(bullet, :projects_picker_dialog) } %>
<% search_id = local_assigns.fetch(:search_id) { dom_id(bullet, :projects_picker_search) } %>
<div class="projects-picker"
     data-controller="projects-picker dialog combobox"
     data-projects-picker-project-value="<%= initial_project.to_json %>">
  <button
    type="button"
    class="button-secondary projects-picker--trigger projects-picker--trigger-composer"
    commandfor="<%= dialog_id %>"
    command="show-modal"
    data-action="click->projects-picker#reset"
    >
    <i class="icon projects-picker--trigger-icon"
       style="--icon-mask: <%= bucket_icon_mask(bucket) %>"
       aria-hidden="true"
       data-projects-picker-target="triggerIcon"></i>
    <span data-projects-picker-target="triggerText">Project</span>
  </button>
  <input type="hidden" name="<%= field_name %>" value="<%= bucket&.id %>" data-projects-picker-target="hiddenBucketId">
  <dialog
    id="<%= dialog_id %>"
    class="dialog"
    data-dialog-target="dialog"
    data-action="click->dialog#backdropHide"
    >
    <div class="projects-picker--body">
      <p class="projects-picker--title">Project picker</p>
      <input
        type="search"
        id="<%= search_id %>"
        class="form-input"
        autocomplete="off"
        placeholder="Search projects"
        data-projects-picker-target="search"
        data-combobox-target="input"
        data-action="input->projects-picker#search keydown->combobox#navigate keydown->projects-picker#submitOnEnter"
        >
      <ul class="projects-picker--suggestions"
          role="listbox"
          data-projects-picker-target="suggestions"></ul>
      <button type="button"
              class="button-secondary projects-picker--clear"
              data-action="click->projects-picker#clear"
              data-projects-picker-target="clearButton"
              <%= "disabled" if bucket.blank? %>>Clear project</button>
    </div>
  </dialog>
</div>
