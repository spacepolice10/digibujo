<turbo-frame id="<%= @frame_id %>">
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <header class="layout--flex" data-justify="between" data-align="center">
      <p class="typography--paragraph-sm typography--bold">New bullet</p>

      <%= link_to @return_to,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "xs" },
            aria: { label: "Close composer" } do %>
        <p> Cancel </p>
      <% end %>
    </header>

    <%= render "bullets/composer_v2",
          bullet: Bullet.new,
          bucket_id: @bucket.id,
          pops_on: @pops_on&.iso8601,
          allowed_bulletable_variants: @allowed_bulletable_variants,
          preset: "default",
          autofocus: true,
          composer_id: @composer_id %>
  </div>
</turbo-frame>
