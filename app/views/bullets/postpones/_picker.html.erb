<%# locals: (bullet_ids: "", asap:, tomorrow:, next_monday:, next_weekends:, daylog_bucket:, daylog_buckets: {}, future:, monthlylog: nil) %>
<% daylog_buckets = daylog_buckets.presence || { asap: daylog_bucket, tomorrow: daylog_bucket, next_monday: daylog_bucket, next_weekends: daylog_bucket } %>
<div class="bulk-menu--action-header">
  <p class="bulk-menu--action-name">Schedule</p>

  <button
    type="button"
    class="button--primary button--icon button--circle"
    popovertarget="postpone_picker_dropdown_id"
    popovertargetaction="hide"
    aria-label="Close schedule picker"
  >
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
</div>

<div class="bulk-menu--action-options">
  <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, daylog_buckets[:asap].id %>
    <%= hidden_field_tag :pops_on, asap %>

    <%= button_tag type: :submit,
          class: "button--tertiary bulk-menu--action-option",
          data: {
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-up)"
        aria-hidden="true"
      ></i>
      ASAP · <%= asap.strftime("%a, %b %-d") %>
    <% end %>
  <% end %>

  <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, daylog_buckets[:tomorrow].id %>
    <%= hidden_field_tag :pops_on, tomorrow %>

    <%= button_tag type: :submit,
          class: "button--tertiary bulk-menu--action-option",
          data: {
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-right)"
        aria-hidden="true"
      ></i>
      Tomorrow · <%= tomorrow.strftime("%a, %b %-d") %>
    <% end %>
  <% end %>

  <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, daylog_buckets[:next_monday].id %>
    <%= hidden_field_tag :pops_on, next_monday %>

    <%= button_tag type: :submit,
          class: "button--tertiary bulk-menu--action-option",
          data: {
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-calendar-repeat)"
        aria-hidden="true"
      ></i>
      Next week · <%= next_monday.strftime("%a, %b %-d") %>
    <% end %>
  <% end %>

  <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, daylog_buckets[:next_weekends].id %>
    <%= hidden_field_tag :pops_on, next_weekends %>

    <%= button_tag type: :submit,
          class: "button--tertiary bulk-menu--action-option",
          data: {
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-calendar-repeat)"
        aria-hidden="true"
      ></i>
      Next weekend · <%= next_weekends.strftime("%a, %b %-d") %>
    <% end %>
  <% end %>

  <% if monthlylog&.bucket %>
    <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
      <%= hidden_field_tag :bucket_id, monthlylog.bucket.id %>

      <%= button_tag type: :submit,
            class: "button--tertiary bulk-menu--action-option",
            data: {
              grid_navigation_target: "item",
              action: "focus->grid-navigation#syncPosition"
            } do %>
        <i
          class="icon"
          style="--icon-mask: var(--icon-calendar)"
          aria-hidden="true"
        ></i>
        This month
      <% end %>
    <% end %>
  <% end %>

  <% if future&.bucket %>
    <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
      <%= hidden_field_tag :bucket_id, future.bucket.id %>

      <%= button_tag type: :submit,
            class: "button--tertiary bulk-menu--action-option",
            data: {
              grid_navigation_target: "item",
              action: "focus->grid-navigation#syncPosition"
            } do %>
        <i
          class="icon"
          style="--icon-mask: var(--icon-calendar)"
          aria-hidden="true"
        ></i>
        Sometime
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="bulk-menu--action-date-picker">
  <label
    for="pops_on_date_picker"
    class="button--tertiary bulk-menu--action-option"
    data-grid-navigation-target="item"
    data-action="focus->grid-navigation#syncPosition"
  >
    <i
      class="icon"
      style="--icon-mask: var(--icon-calendar)"
      aria-hidden="true"
    ></i>

    <span>Pick a date</span>

    <input
      type="checkbox"
      id="pops_on_date_picker"
      name="pops_on_date_picker"
      class="utilities--sr-only"
    >
  </label>

  <%= form_with url: postpone_path, method: :post, class: "bulk-menu--action-form", data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, daylog_bucket.id %>
    <%= date_field_tag :pops_on, asap, class: "form-input" %>

    <%= button_tag type: :submit, class: "button--primary" do %>
      Confirm
    <% end %>
  <% end %>
</div>
