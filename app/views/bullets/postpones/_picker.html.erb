<%# locals: (bullet_ids: "", postpone_options: []) %>

  <header>
    <h2 class="utilities--sr-only">Schedule</h2>
  </header>

  <main aria-label="Schedule">
    <% postpone_options.each do |option| %>
      <%= form_with url: postpone_path, method: :post,
            class: "utilities--contents",
            data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
        <%= hidden_field_tag :pops_on, option[:pops_on].iso8601 %>

        <%= button_tag type: :submit,
              class: "picker--item",
              data: {
                grid_navigation_target: "item",
                action: "focus->grid-navigation#syncPosition"
              } do %>
          <%= icon(option[:icon]) %>
          <%= option[:name] %>

          <% if option[:pops_on] %>
            · <%= option[:pops_on].strftime("%a, %b %-d") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="bulk-menu--picker-date">
      <label
        for="pops_on_date_picker"
        class="picker--item"
        tabindex="-1"
        data-grid-navigation-target="item"
        data-action="focus->grid-navigation#syncPosition"
      >
        <%= icon("calendar") %>
        <span>Pick a date</span>

        <input
          type="checkbox"
          id="pops_on_date_picker"
          name="pops_on_date_picker"
          class="utilities--sr-only"
        >
      </label>

      <%= form_with url: postpone_path, method: :post, class: "form bulk-menu--picker-date-form", data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
        <%= date_field_tag :pops_on, Date.current %>

        <%= button_tag type: :submit, data: { intent: "primary", radius: "full", size: "xs" } do %>
          Confirm
        <% end %>
      <% end %>
    </div>
  </main>

