<% bucket_tags = bullet.bucket.present? ? [bullet.bucket] : [] %>
<% if bullet.pinned? || bullet.archived? || bullet.ends_date.present? || bucket_tags.any? || bullet.rich_body? %>
  <div class="bullet--metadata">
    <span class="bullet--tags">
      <% if bullet.pops_on && @selected_date && bullet.pops_on > @selected_date %>
        <span class="pill pill--emerald">
          <p>Scheduled on <%= bullet.pops_on.strftime("%B %d") %></p>
        </span>
      <% end %>
      <% if bullet.pinned? %>
        <% pinned_hint_id = dom_id(bullet, :hint_pinned) %>
        <% pinned_anchor = "--hint-#{bullet.id}-pinned" %>
        <span
          class="pill"
          interestfor="<%= pinned_hint_id %>"
          style="anchor-name: <%= pinned_anchor %>"
          aria-label="Pinned"
        >
          <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
        </span>
      <% end %>
      <% if bullet.archived? %>
        <% archived_hint_id = dom_id(bullet, :hint_archived) %>
        <% archived_anchor = "--hint-#{bullet.id}-archived" %>
        <span
          class="pill"
          interestfor="<%= archived_hint_id %>"
          style="anchor-name: <%= archived_anchor %>"
          aria-label="Archived"
        >
          <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
        </span>
      <% end %>
      <% if bullet.rich_body? %>
        <span class="pill pill--emerald" aria-label="Has expanded content">
          <i class="icon" style="--icon-mask: var(--icon-file)" aria-hidden="true"></i>
        </span>
      <% end %>
      <% bucket_tags.each do |bucket| %>
        <% bucketable = bucket.bucketable %>
        <% next unless bucketable %>
        <% if bucket.bucketable_type == "MonthlyBucket" %>
          <% monthly_bucket_hint_id = dom_id(bullet, "hint_monthly_bucket_#{bucket.id}") %>
          <% monthly_bucket_anchor = "--hint-#{bullet.id}-monthly_bucket-#{bucket.id}" %>
          <%= link_to future_monthly_bucket_path(bucketable),
                class: ["pill", bucket.colour.present? ? "pill--#{bucket.colour}" : nil].compact.join(" "),
                interestfor: monthly_bucket_hint_id,
                style: "anchor-name: #{monthly_bucket_anchor}",
                data: { turbo_frame: "_top" },
                aria: { label: "Monthly spread: #{bucket.name}" } do %>
            <i class="icon" style="--icon-mask: <%= bucket.icon_mask %>" aria-hidden="true"></i>
          <% end %>
        <% elsif bucket.bucketable_type == "Collection" %>
          <% coll_hint_id = dom_id(bullet, "hint_collection_#{bucket.id}") %>
          <% coll_anchor = "--hint-#{bullet.id}-collection-#{bucket.id}" %>
          <%= link_to collection_path(bucketable),
                class: ["pill", bucket.colour.present? ? "pill--#{bucket.colour}" : nil].compact.join(" "),
                interestfor: coll_hint_id,
                style: "anchor-name: #{coll_anchor}",
                data: { turbo_frame: "_top" },
                aria: { label: "Collection: #{bucket.name}" } do %>
            <% if bucket.icon_path %>
              <%= image_tag bucket.icon_path, alt: "", class: "form--list-icon" %>
            <% else %>
              <i class="icon" style="--icon-mask: <%= bucket.icon_mask %>" aria-hidden="true"></i>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </span>
    <% if bullet.pinned? %>
      <% pinned_hint_id = dom_id(bullet, :hint_pinned) %>
      <% pinned_anchor = "--hint-#{bullet.id}-pinned" %>
      <div
        id="<%= pinned_hint_id %>"
        class="hint"
        popover="hint"
        style="position-anchor: <%= pinned_anchor %>"
      >
        Pinned — stays at the top of your timeline.
      </div>
    <% end %>
    <% if bullet.archived? %>
      <% archived_hint_id = dom_id(bullet, :hint_archived) %>
      <% archived_anchor = "--hint-#{bullet.id}-archived" %>
      <div
        id="<%= archived_hint_id %>"
        class="hint"
        popover="hint"
        style="position-anchor: <%= archived_anchor %>"
      >
        Archived — hidden from the main timeline until restored.
      </div>
    <% end %>
    <% bucket_tags.each do |bucket| %>
      <% bucketable = bucket.bucketable %>
      <% next unless bucketable %>
      <% if bucket.bucketable_type == "MonthlyBucket" %>
        <% monthly_bucket_hint_id = dom_id(bullet, "hint_monthly_bucket_#{bucket.id}") %>
        <% monthly_bucket_anchor = "--hint-#{bullet.id}-monthly_bucket-#{bucket.id}" %>
        <div
          id="<%= monthly_bucket_hint_id %>"
          class="hint"
          popover="hint"
          style="position-anchor: <%= monthly_bucket_anchor %>"
        >
          <%= bucket.name %>
        </div>
      <% elsif bucket.bucketable_type == "Collection" %>
        <% coll_hint_id = dom_id(bullet, "hint_collection_#{bucket.id}") %>
        <% coll_anchor = "--hint-#{bullet.id}-collection-#{bucket.id}" %>
        <div
          id="<%= coll_hint_id %>"
          class="hint"
          popover="hint"
          style="position-anchor: <%= coll_anchor %>"
        >
          <%= bucket.name %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
