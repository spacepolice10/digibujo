<%# locals: (bucket_id:, pops_on: nil) %>
<%
  bullet = Current.user.bullets.new(bulletable_type: "Note", bucket_id: bucket_id, pops_on: pops_on)
  default_type = BulletsHelper::COMPOSER_TYPES.first
  default_config = bullet_type_config(default_type)
%>

<div
  id="bullet_composer"
  class="composer"
  data-bullet-type="<%= default_type.downcase %>"
  data-controller="chat-composer voice-recorder"
  data-voice-recorder-manage-submit-value="false"
  data-voice-recorder-shell-value="true"
  data-action="voice-recorder:change->chat-composer#refresh voice-recorder:denied->chat-composer#cancelVoice"
>
  <%= form_with model: bullet,
        class: "composer--form",
        multipart: true,
        data: {
          chat_composer_target: "form",
          action: "turbo:submit-end->chat-composer#submitEnd turbo:submit-end->voice-recorder#clearOnSubmit"
        } do |fr| %>
    <%= hidden_field_tag :inline_composer, "1" %>
    <%= fr.hidden_field :bucket_id, value: bucket_id %>
    <%= fr.hidden_field :pops_on, value: pops_on %>
    <%= fr.hidden_field :bulletable_type,
          value: default_type,
          data: { chat_composer_target: "typeField" } %>

    <%# Voice file fields stay mounted for the whole form lifetime. %>
    <%= file_field_tag "bullet[bulletable_attributes][recording]",
          accept: "audio/webm,audio/mp4",
          hidden: true,
          data: { voice_recorder_target: "file" } %>
    <%= hidden_field_tag "bullet[bulletable_attributes][duration_seconds]", nil,
          id: "bullet_bulletable_attributes_duration_seconds",
          data: { voice_recorder_target: "duration" } %>

    <div class="composer--row" data-chat-composer-target="composeRow">
      <%# Field first in the DOM so multiline can lift it; single-line order is CSS. %>
      <div class="composer--field hotkey-hint"
           data-controller="hotkey"
           data-hotkey="Shift+F"
           data-action="keydown.shift+f@document->hotkey#click click->chat-composer#focus"
           aria-keyshortcuts="Shift+F">
        <%= fr.fields_for :bulletable, Note.new do |bf| %>
          <%# rows drives Lexxy's --lexxy-editor-rows: start at one chat line. %>
          <%# toolbar id points at the external <lexxy-toolbar> in chrome —
              Lexxy wires setEditor to that node (do not reparent; disconnect disposes it). %>
          <%= bf.rich_text_area :body,
                preset: "note",
                toolbar: "composer_toolbar",
                rows: 1,
                placeholder: default_config[:placeholder],
                class: "lexxy-content composer--editor",
                data: {
                  chat_composer_target: "editor",
                  action: "keydown->chat-composer#keydown:capture lexxy:change->chat-composer#refresh"
                } do %>
            <lexxy-prompt
              trigger="#"
              name="project"
              src="<%= project_suggestions_path %>"
              remote-filtering
              supports-space-in-searches
            ></lexxy-prompt>
          <% end %>
        <% end %>
      </div>

      <%# display:contents when compact so lead/actions sit in the pill row;
          becomes its own pill under the floating field when multiline. %>
      <div class="composer--chrome">
        <div class="composer--lead">
          <div class="composer--type dropdown--dock" style="anchor-name: --composer_types">
            <button type="button"
                    class="button--secondary button--icon button--circle composer--type-button"
                    popovertarget="composer_types"
                    aria-haspopup="menu"
                    aria-label="Change bullet type"
                    aria-keyshortcuts="Shift+Tab">
              <% (BulletsHelper::COMPOSER_TYPES + ["Voice"]).each do |type_name| %>
                <% config = bullet_type_config(type_name) %>
                <span class="composer--type-icon"
                      data-chat-composer-target="typeIcon"
                      data-composer-type="<%= type_name %>"
                      <%= "hidden" if type_name != default_type %>>
                  <%= icon_tag(config[:icon], style: "color: #{config[:colour]};") %>
                </span>
              <% end %>
            </button>

            <div id="composer_types"
                 class="dropdown dropdown--element animations--side-in"
                 style="position-anchor: --composer_types"
                 popover
                 data-controller="grid-navigation"
                 data-grid-navigation-columns-value="1"
                 data-action="keydown->grid-navigation#navigate">
              <div class="dropdown--element-body">
                <nav class="dropdown--menu" aria-label="Bullet type">
                  <% BulletsHelper::COMPOSER_TYPES.each do |type_name| %>
                    <% config = bullet_type_config(type_name) %>
                    <button type="button"
                            class="dropdown-item composer--type-option"
                            role="menuitemradio"
                            aria-checked="<%= type_name == default_type %>"
                            data-chat-composer-target="typeOption"
                            data-grid-navigation-target="item"
                            data-composer-type="<%= type_name %>"
                            data-composer-placeholder="<%= config[:placeholder] %>"
                            data-action="chat-composer#selectType focus->grid-navigation#syncPosition"
                            popovertarget="composer_types"
                            popovertargetaction="hide">
                      <span class="composer--type-copy">
                        <span class="composer--type-heading">
                          <%= icon_tag(config[:icon], style: "color: #{config[:colour]};") %>
                          <span class="composer--type-name"><%= type_name %></span>
                        </span>
                        <span class="composer--type-description utilities--text-sm"><%= config[:description] %></span>
                      </span>
                    </button>
                  <% end %>
                </nav>
              </div>
            </div>
          </div>

          <button type="button"
                  class="composer--clear"
                  data-action="chat-composer#clear"
                  data-chat-composer-target="clearButton"
                  aria-label="Clear draft"
                  hidden>
            <%= icon_tag("trash", class: "button--icon") %>
          </button>
        </div>

        <%# External Lexxy toolbar (toolbar="composer_toolbar" on the editor).
            Empty shell is filled from Lexxy's defaultTemplate before/with init.
            Visibility is driven by .composer--toolbar (animates; no [hidden]). %>
        <lexxy-toolbar id="composer_toolbar"
                       class="composer--toolbar-panel"
                       data-chat-composer-target="toolbarPanel"
                       data-upload="file"
                       data-attachments="true"
                       aria-hidden="true"></lexxy-toolbar>

        <div class="composer--actions">
          <button type="button"
                  class="composer--toolbar-toggle"
                  data-action="chat-composer#toggleToolbar"
                  data-chat-composer-target="toolbarButton"
                  aria-label="Show formatting toolbar"
                  aria-expanded="false"
                  aria-controls="composer_toolbar"
                  aria-keyshortcuts="Control+Shift+E"
                  aria-pressed="false"
                  hidden>
            <%= icon_tag("text-color", class: "button--icon") %>
          </button>

          <button type="button"
                  class="composer--upload"
                  data-action="chat-composer#uploadFile"
                  data-chat-composer-target="uploadButton"
                  aria-label="Upload files"
                  hidden>
            <%= icon_tag("paperclip", class: "button--icon") %>
          </button>

          <button type="button"
                  class="composer--record hotkey-hint"
                  data-controller="hotkey"
                  data-hotkey="Shift+R"
                  data-chat-composer-target="recordButton"
                  data-voice-recorder-target="recordButton"
                  data-action="voice-recorder#record chat-composer#startVoice keydown.shift+r@document->hotkey#click"
                  aria-label="Record voice memo"
                  aria-keyshortcuts="Shift+R">
            <%= icon_tag("microphone", class: "button--icon") %>
          </button>

          <button type="submit"
                  class="button--primary button--icon button--circle composer--submit"
                  data-chat-composer-target="submit"
                  aria-label="Save bullet"
                  disabled>
            <%= icon_tag("arrow-up", class: "button--icon") %>
          </button>
        </div>
      </div>
    </div>

    <%# Separate shell: same pill chrome, waveform instead of text, pause + send. %>
    <div class="composer--row composer--voice" data-chat-composer-target="voicePanel" hidden>
      <div class="composer--lead">
        <button type="button"
                class="button--secondary button--icon button--circle composer--voice-pause"
                data-voice-recorder-target="stopButton"
                data-action="voice-recorder#stop"
                aria-label="Stop recording">
          <%= icon_tag("pause", class: "button--icon") %>
        </button>
        <button type="button"
                class="button--secondary button--icon button--circle composer--voice-discard"
                data-voice-recorder-target="discardButton"
                data-action="voice-recorder#discard chat-composer#cancelVoice"
                aria-label="Discard recording"
                hidden>
          <%= icon_tag("trash", class: "button--icon") %>
        </button>
      </div>

      <div class="composer--field composer--voice-field">
        <div class="composer--voice-waveform" data-voice-recorder-target="waveform" aria-hidden="true" hidden>
          <svg viewBox="0 0 160 32" preserveAspectRatio="none">
            <% 80.times do |index| %>
              <rect class="voice--waveform-item" x="<%= index * 2 %>" y="15" width="1.25" height="2" rx="0.5" />
            <% end %>
          </svg>
        </div>
        <span class="composer--voice-remaining utilities--text-sm"
              data-voice-recorder-target="remaining"
              aria-live="polite">0:00</span>

        <div data-voice-recorder-target="previewContainer" hidden>
          <%= render "voices/playback", recording: nil, recording_duration: 0 %>
        </div>

        <p class="utilities--sr-only"
           data-voice-recorder-target="status"
           aria-live="polite"
           hidden></p>
        <p class="composer--voice-status utilities--text-sm" data-voice-recorder-target="unsupported" hidden>
          Voice recording is not supported in this browser.
        </p>
      </div>

      <div class="composer--actions">
        <button type="submit"
                class="button--primary button--icon button--circle composer--submit"
                data-chat-composer-target="voiceSubmit"
                aria-label="Save voice memo"
                disabled>
          <%= icon_tag("arrow-up", class: "button--icon") %>
        </button>
      </div>
    </div>
  <% end %>
</div>
