<% if @bullet.errors.any? %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: @bullet.errors.full_messages %>
  <% end %>
<% else %>

<%= turbo_stream.replace @bullet do %>
  <%= render partial: @bullet.to_partial_path, locals: { @bullet.bulletable_type.downcase.to_sym => @bullet } %>
<% end %>

<%= turbo_stream.update "pinned_bullets_dock",
      partial: "/pinned/dock",
      locals: { bullets: Current.user.bullets.includes(bucket: :bucketable).pinned.order(updated_at: :desc) } %>
<% end %>
