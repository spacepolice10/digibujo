<%= turbo_stream.replace @bullet do %>
  <%= render partial: "/bullets/bullet", locals: { bullet: @bullet } %>
<% end %>

<%= turbo_stream.update "pinned_bullets_dock",
      partial: "/pinned/dock",
      locals: { bullets: Current.user.bullets.includes(bucket: :bucketable).pinned.order(updated_at: :desc) } %>
