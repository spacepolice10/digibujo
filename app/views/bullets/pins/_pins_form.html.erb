    <%= button_to bullet_pin_path(bullet), method: :patch, class: "bullet-dropdown-item", data: { "grid-navigation-target" => "item" } do %>
      <span class="bullet-dropdown-icon bullet-dropdown-icon--pin">
        <span class="icon" style="--icon-mask: var(--icon-pin)"></span>
      </span>

      <span class="bullet-dropdown-text">
        <span class="bullet-dropdown-label">
          <%= bullet.pinned? ? "Unpin" : "Pin" %>
        </span>

        <span class="bullet-dropdown-desc">
          <%= bullet.pinned? ? "Remove from quick access" : "Keep at top for quick access" %>
        </span>
      </span>
    <% end %>
