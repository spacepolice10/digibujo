<!-- Recorder is a part of composer. One of possible states and bulletable variants. So it is tightly bound to the general purpose text form and not supposed to be used as a standalone component. -->

<div id="recorder" data-composer-target="recorder" data-controller="voice-recorder" class="voice-recorder">

    <%= file_field_tag "bullet[bulletable_attributes][recording]",
        accept: "audio/webm,audio/mp4",
        hidden: true,
        data: { voice_recorder_target: "file" } %>
    <%= hidden_field_tag "bullet[bulletable_attributes][duration_seconds]", nil,
        id: "bullet_bulletable_attributes_duration_seconds",
        data: { voice_recorder_target: "duration" } %>

<button type="button" class="button--secondary button--circle" data-voice-recorder-target="playButton" data-action="voice-recorder#togglePlay" hidden>
    <%= icon_tag("play", class: "paused") %>
    <%= icon_tag("pause", class: "playing", hidden: true) %>
</button>
<button type="button" class="button--secondary button--circle" data-voice-recorder-target="recordButton" data-action="voice-recorder#record">
        <%= icon_tag("circle", style: "color: var(--color-fg-negative);") %>
</button>
<button type="button" class="button--secondary button--circle" data-voice-recorder-target="stopButton" data-action="voice-recorder#stop" hidden>
    <%= icon_tag("stop") %>
</button>
<button type="button" class="button--secondary button--circle" data-voice-recorder-target="discardButton" data-action="voice-recorder#discard" hidden>
    <%= icon_tag("trash") %>
</button>
    <div data-voice-recorder-target="waveform" aria-hidden="true" class="voice-recorder--waveform">
        <svg viewBox="0 0 160 32" preserveAspectRatio="none">
            <% 80.times do |index| %>
            <rect class="voice--waveform-item" x="<%= index * 2 %>" y="15" width="1.25" height="2" rx="0.5" />
            <% end %>
        </svg>
    </div>
    <span
    class="typography--paragraph-sm"
    data-voice-recorder-target="remaining"
    aria-live="polite">0:00</span>
    <div data-voice-recorder-target="previewContainer" hidden>
        <audio data-voice-recorder-target="preview" aria-hidden="true"></audio>
    </div>
</div>
