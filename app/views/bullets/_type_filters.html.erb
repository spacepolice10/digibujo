<% current_type = params[:type].presence %>
<% filters = [ [ nil, "All", "list", nil ] ] + Bullet.bulletable_types.map { |type|
     [ type.downcase, type.pluralize, type.constantize.new.marker_icon, type.downcase ]
   } %>
<nav class="layout--filter-group" aria-label="Filter bullets">
  <div class="layout--filter-surface">
    <% filters.each do |type_key, label, icon, bullet_type| %>
      <% hint_id = "filter_#{type_key || "all"}" %>
      <% anchor = "--filter-#{type_key || "all"}" %>
      <%= link_to path_for_type.call(type_key),
            class: "layout--filter-option",
            interestfor: hint_id,
            style: "anchor-name: #{anchor}",
            data: { bullet_type: bullet_type }.compact,
            aria: { label: label, current: (type_key.blank? ? current_type.blank? : current_type == type_key) ? "page" : false } do %>
        <i class="icon" style="--icon-mask: var(--icon-<%= icon.to_s.dasherize %>)" aria-hidden="true"></i>
      <% end %>
    <% end %>
  </div>
  <% filters.each do |type_key, label, _icon, _bullet_type| %>
    <% hint_id = "filter_#{type_key || "all"}" %>
    <% anchor = "--filter-#{type_key || "all"}" %>
    <div
      id="<%= hint_id %>"
      class="hint"
      popover="hint"
      style="position-anchor: <%= anchor %>"
    >
      <%= label %>
    </div>
  <% end %>
</nav>
