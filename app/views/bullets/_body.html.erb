<%# locals: (bullet:, selected_date: nil) %>
<% if bullet.body.to_plain_text.presence %>
  <div class="bullet-body">
    <% if bullet.list_link_uses_excerpt? %>
      <%= link_to bullet.excerpt, bullet_path(bullet), data: { turbo_frame: "_top" } %>
    <% else %>
      <%= link_to bullet.body, bullet_path(bullet), data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %>
<%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
