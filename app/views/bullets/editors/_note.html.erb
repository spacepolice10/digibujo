<%# locals: (bullet:, attributes: {}, default_project: nil, default_person: nil) %>
<% editor_value = bullet.editor_content(default_projects: Array(default_project).compact, default_people: Array(default_person).compact) %>

<%= render "bullets/editors/form", bullet: bullet, type_name: "Note", attributes: attributes do |f| %>
  <span class="bullet--marker bullet--note-marker" aria-hidden="true">
    <i class="icon" style="--icon-mask: var(--icon-line-dashed)" aria-hidden="true"></i>
  </span>
  <%= f.rich_text_area :content,
        value: editor_value,
        autofocus: true,
        placeholder: "What's on your mind?",
        preset: "note" do %>
    <lexxy-prompt trigger="#"
                  name="project"
                  src="<%= project_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="@"
                  name="person"
                  src="<%= person_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
  <% end %>

  <div class="bullet-form-note-options">
    <div class="mood-picker">
      <% moods = { positive: "😊", negative: "😞", inspired: "✨", frustrated: "😣" } %>
      <% moods.each do |name, emoji| %>
        <label class="mood-option">
          <%= f.fields_for :bulletable, bullet.bulletable do |nf| %>
            <%= nf.radio_button :mood, name, class: "utilities--sr-only" %>
          <% end %>
          <span class="mood-emoji"><%= emoji %></span>
        </label>
      <% end %>
    </div>
    <div class="flag-picker">
      <%= f.fields_for :bulletable, bullet.bulletable do |nf| %>
        <label class="flag-option">
          <%= nf.check_box :awaits_research %>
          <span>🔬 Research</span>
        </label>
        <label class="flag-option">
          <%= nf.check_box :idea %>
          <span>💡 Idea</span>
        </label>
      <% end %>
    </div>
  </div>
<% end %>
