<%# locals: (bullet:, attributes: {}, default_project: nil, default_person: nil) %>
<% editor_value = bullet.editor_content(default_projects: Array(default_project).compact, default_people: Array(default_person).compact) %>

<%= render "bullets/editors/form", bullet: bullet, type_name: "Event", attributes: attributes do |f| %>
  <span class="bullet--marker bullet--event-marker" aria-hidden="true">
    <i class="icon" style="--icon-mask: var(--icon-circle)" aria-hidden="true"></i>
  </span>
  <%= f.rich_text_area :content,
        value: editor_value,
        autofocus: true,
        placeholder: "What's happening?",
        multiline: false,
        preset: "inline" do %>
    <lexxy-prompt trigger="#"
                  name="project"
                  src="<%= project_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="@"
                  name="person"
                  src="<%= person_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
  <% end %>
<% end %>
