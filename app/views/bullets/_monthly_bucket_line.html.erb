<%# locals: (bullet:) %>
<%= link_to bullet_path(bullet),
      class: "bullet--monthly-bucket-link",
      data: { turbo_frame: "_top" },
      draggable: "false" do %>
  <span class="bullet--line"><%= bullet.name %></span>
  <% if bullet.attachments.attached? || bullet.rich_body? %>
    <span class="bullet--monthly-bucket-extra" aria-label="Has attachments or expanded content">
      <i class="icon" style="--icon-mask: var(--icon-<%= bullet.attachments.attached? ? "paperclip" : "expand" %>)" aria-hidden="true"></i>
    </span>
  <% end %>
<% end %>
