<% monthlylog = Current.user.monthlylogs.find(@monthlylog_id) %>

<%= turbo_stream.append dom_id(monthlylog, :unplanned_bullets) do %>
  <%= render_bullet_compact(@bullet) %>
<% end %>

<%= turbo_stream.update dom_id(monthlylog, :unplanned_composer) do %>
  <%= render "bullets/editor",
        bullet: Current.user.bullets.build,
        bulletable_type: "Task",
        attributes: {
          bucket_id: @bullet.bucket_id,
          render_context: "monthlylog_unplanned",
          monthlylog_id: monthlylog.id
        } %>
<% end %>
