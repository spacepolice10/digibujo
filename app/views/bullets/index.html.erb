<% content_for(:title, @filter.name) %>

<% if @filter.empty? %>
  <%= render "shared/tabbar" %>
<% else %>
  <%= render "shared/back_tabbar" %>
<% end %>

<main class="timeline--window" data-size="md">
  <% scroller = capture do %>
    <div
      id="<%= @filter.collection ? dom_id(@filter.collection) : 'timeline' %>"
      class="timeline--scroller"
      data-controller="timeline-scroll"
      data-timeline-scroll-path-value="<%= bullets_path(@filter.to_params) %>"
      data-bulk-menu-target="list"
    >
      <% if @more_bullets %>
        <div class="timeline--load-more-trigger" data-timeline-scroll-target="trigger">
          <%= icon("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <%= render "sections", bullets: @bullets, timeline: @timeline, mount_today: @filter.empty? %>
    </div>
  <% end %>

  <% if @filter.collection %>
    <%= turbo_frame_tag dom_id(@filter.collection, :timeline), class: "utilities--contents" do %>
      <%= scroller %>
    <% end %>
  <% else %>
    <%= scroller %>
  <% end %>

  <br>

  <% if @filter.empty? %>
    <div
      id="timeline_composer_dock"
      class="timeline--composer composer--dock"
    >
      <%= render "bullets/composer",
          bullet: Bullet.new,
          collection: nil,
          pops_on: Date.current,
          preset: "default",
          autofocus: false %>
    </div>
  <% end %>
</main>

<%= render "bullets/bulk_menu" %>
