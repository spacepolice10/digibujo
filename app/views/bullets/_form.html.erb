<% type_options = Bullet.bulletable_types %>
<% selected_type_name = bullet.bulletable_type.presence_in(type_options) || "Task" %>
<% selected_bulletable = selected_type_name.constantize %>
<% type_descriptions = {
  "task" => "Track an actionable item",
  "note" => "Capture an idea or detail",
  "event" => "Plan something time-based"
} %>
<%= form_with model: bullet, data: {
      controller: "bullet-form persist",
      bullet_form_mode_value: "fields",
      bullet_form_type_value: selected_type_name.downcase,
      action: "keydown.meta+enter->bullet-form#submit keydown.ctrl+enter->bullet-form#submit trix-change->bullet-form#updateEditorLayout resize->bullet-form#updateEditorLayout"
    } do |f| %>
<%= f.hidden_field :bulletable_type, value: selected_type_name, data: {bullet_form_target: "typeForm"} %>
  <div class="bullet-form-rail">
    <%= render "bullets/form_fields", bullet: bullet %>
  </div>

  <div class="bullet-form-composer">
      <%= render "bullets/form_type_menu",
            bullet: bullet,
            selected_bulletable: selected_bulletable,
            type_descriptions: type_descriptions,
            type_options: type_options %>
<div class="bullet-form-editor">
  <%= f.rich_text_area :content,
        autofocus: "true",
        placeholder: "What's on your mind?" %>
</div>
<div class="bullet-form-footer">
  <%= f.button type: "submit", class: "button-primary" do %>
    Dump
  <% end %>
</div>
  </div>

  <%= render "bullets/form_errors", bullet: bullet %>
<% end %>
