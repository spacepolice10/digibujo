<%# locals: (bullet:, editing:, stimulus_controller: nil, stimulus_actions: nil) %>
<% bulletable = bullet.bulletable || bullet.bulletable_type.constantize.new %>
<%
  controllers = [ "composer", stimulus_controller ].compact
  actions = [
    "keydown.enter+meta->composer#submit",
    "keydown.enter+ctrl->composer#submit",
    stimulus_actions,
    "turbo:submit-end->composer#submitFinish",
    "keydown.esc@document->composer#escape:capture"
  ].compact
%>

<%= form_with model: bullet, class: "bullets-form", data: {
  composer_form: true,
  controller: controllers.join(" "),
  action: actions.join(" ")
} do |fr| %>
  <%= fr.hidden_field :pops_on, value: bullet.pops_on %>
  <%= fr.hidden_field :bucket_id, value: bullet.bucket_id %>
  <%= fr.hidden_field :bulletable_type %>

  <% if bullet.errors.any? || bulletable.errors.any? %>
    <div class="form--errors" role="alert">
      <ul>
        <% (bullet.errors.full_messages + bulletable.errors.full_messages).uniq.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= yield fr, bulletable %>

  <div class="bullets-form--rail">
    <div class="bullets-form--rail-actions">
    <button
      type="button"
      class="button--tertiary button--icon-subtle bullets-form--type-dismiss"
      data-action="composer#cancel"
      aria-label="Close composer"
    >
      <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
    </button>
    <span
      class="bullets-form--type-pill"
      data-bullet-type="<%= bullet.bulletable_type.downcase %>"
      data-composer-transition-type="<%= bullet.bulletable_type.downcase %>"
    >
      <%= bullet.bulletable_type %>
    </span>
  </div>

      <div class="bullets-form--rail-submit">
        <%= fr.button type: "submit",
              class: "button--primary button--sm",
              aria: { label: "Save" } do %>
          <%= icon_tag("arrow-up", style: "color: var(--color-text-base);", class: "button--icon") %>
          Save
        <% end %>
      </div>
  </div>
<% end %>
