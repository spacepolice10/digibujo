<%# locals: (composer_id:, attributes: {}, new_path: nil, types: nil) %>
<% link_to_type = new_path || ->(type) { new_bullet_path(**attributes.merge(composer_id: composer_id, bulletable_type: type)) } %>
<% options = Bullet::Composer.type_options %>
<% options = options.select { |entry| types.include?(entry[:type]) } if types.present? %>

<div class="bullet--composer">
  <div class="bullet--composer-buttons">
    <% options.each do |entry| %>
      <%= link_to link_to_type.call(entry[:type]),
            class: [
              "bullet--composer-create-button",
              "bullet--composer-create-button--#{entry[:modifier]}",
              ("button--hotkey" if entry[:hotkey].present?)
            ].compact,
            data: {
              turbo_frame: composer_id,
              controller: ("hotkey" if entry[:hotkey].present?),
              hotkey: entry[:hotkey]
            }.compact,
            aria: {
              label: "Add #{entry[:name].downcase}",
              keyshortcuts: entry[:hotkey]
            }.compact do %>
        <i class="icon" style="--icon-mask: var(--icon-<%= entry[:icon].dasherize %>)" aria-hidden="true"></i>
        Add <%= entry[:name].downcase %>
      <% end %>
    <% end %>
  </div>
</div>
