<%# locals: (f:, bullet:, type_name:) %>
<% note_form = bullet.bulletable.is_a?(Note) ? bullet.bulletable : Note.new %>

<div class="bullet-form-note-options" data-controller="rich-body-toggle">
  <%= f.fields_for :bulletable, note_form do |nf| %>
    <div class="mood-picker">
      <% moods = { positive: "😊", negative: "😞", inspired: "✨", frustrated: "😣" } %>
      <% moods.each do |name, emoji| %>
        <label class="mood-option">
          <%= nf.radio_button :mood, name, class: "utilities--sr-only" %>
          <span class="mood_marker" title="<%= name.to_s.humanize %>" aria-hidden="true"><%= emoji %></span>
        </label>
      <% end %>
    </div>
  <% end %>

  <div class="bullet-form-rich-body-preview"
       data-rich-body-toggle-target="preview"
       data-action="click->rich-body-toggle#show">
    <div class="bullet-form-rich-body-preview-header">
      <span class="bullet-form-rich-body-preview-label">Details</span>
      <i class="icon" style="--icon-mask: var(--icon-chevron-down)" aria-hidden="true"></i>
    </div>
    <div class="bullet-form-rich-body-preview-content">
      Code, files, markdown…
    </div>
  </div>

  <div class="bullet-form-note-richtext"
       data-rich-body-toggle-target="editor"
       hidden>
    <%= f.rich_text_area :rich_body,
          placeholder: "Code, files, markdown…",
          preset: "expand" %>
  </div>
</div>
