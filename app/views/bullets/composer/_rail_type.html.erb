<%# locals: (bullet:, editing: false) %>
<% pill_colour = { "Task" => "cobalt", "Note" => "gold", "Event" => "vermillion", "Voice" => "emerald" }.fetch(bullet.bulletable_type) %>
<span class="pill pill--<%= pill_colour %> bullet-composer--type-pill" data-bullet-type="<%= bullet.bulletable_type.downcase %>" data-composer-transition-type="<%= bullet.bulletable_type.downcase %>">
  <%= bullet.bulletable_type %>
  <% unless editing %>
    <button type="button"
            class="button--tertiary button--icon-subtle bullet-composer--type-dismiss"
            data-action="composer#cancel"
            aria-label="Close composer">
      <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
    </button>
  <% end %>
</span>
