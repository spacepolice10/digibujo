<%# locals: (fr:, editing: false) %>
<div class="bullet-composer--rail-submit">
  <%= fr.button type: "submit",
        class: "button--primary button--icon button--circle",
        aria: { label: "Save" } do %>
    <i
      class="icon"
      style="--icon-mask: var(--icon-arrow-up)"
      aria-hidden="true"
    ></i>
  <% end %>
  <%= fr.button type: "submit",
          name: "another",
          value: "1",
          class: "button--tertiary",
          aria: { label: "Save and add another" } do %>
    + one more
  <% end %>
</div>
