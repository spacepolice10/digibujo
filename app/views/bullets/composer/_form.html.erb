<%# locals: (bullet:, attributes: {}, editing: false, url: nil) %>
<% editor_id = "bullet_editor_#{bullet.object_id}" %>
<% bulletable = bullet.bulletable || (bullet.bulletable_type.present? ? bullet.bulletable_type.constantize.new : nil) %>
<% picker_params = attributes.symbolize_keys.slice(:pops_on, :bucket_id, :composer_id).compact %>
<% picker_params[:composer_id] ||= "bullet_composer" %>

<%= form_with model: bullet,
      url: url.presence,
      namespace: editor_id,
      class: "bullet-form",
      data: {
        controller: "bullet-composer",
        bullet_composer_editor_url_value: composer_editor_path,
        bullet_composer_editing_value: editing,
        bullet_composer_actiontext_preset_value: bulletable&.actiontext_preset || "inline",
        bullet_composer_accepts_attachments_value: bulletable&.accepts_editor_attachments? || false,
        bullet_composer_submit_on_enter_value: bulletable&.submit_on_enter? || false,
        bullet_composer_submit_on_command_return_value: bulletable&.submit_on_command_return? || false,
        composer_frame_picker_url: (new_bullet_path(**picker_params) unless editing),
        action: "keydown->bullet-composer#handleKeydown turbo:submit-end->bullet-composer#clearOnSubmit"
      }.compact do |f| %>

  <%= render "bullets/composer/fields",
        f: f,
        bullet: bullet,
        submitted_attributes: attributes.compact,
        editing: editing %>
<% end %>
