<%# locals: (selected_date:, bucket:, composer_id:) %>
<% types = [
  { name: "Task", icon: "square", modifier: "task", hotkey: "Shift+T", hotkey_action: "keydown.shift+t@document->hotkey#click" },
  { name: "Note", icon: "text", modifier: "note", hotkey: "Shift+N", hotkey_action: "keydown.shift+n@document->hotkey#click" },
  { name: "Event", icon: "circle", modifier: "event", hotkey: "Shift+E", hotkey_action: "keydown.shift+e@document->hotkey#click" },
  { name: "Voice", icon: "microphone", modifier: "voice", hotkey: "Shift+V", hotkey_action: "keydown.shift+v@document->hotkey#click" }
] %>
<div class="bullet-composer--dock<%= " bullet-composer--dock-fixed" if request.variant.include?(:mobile) %>">
  <turbo-frame
    id="<%= composer_id %>"
    data-controller="composer-picker"
    data-action="turbo:before-frame-render->composer-picker#beforeFrameRender"
    class="utilities--contents"
  >
    <div class="bullet--composer-buttons">
      <% types.each do |type| %>
        <%= link_to new_bullet_path(pops_on: selected_date, bucket_id: bucket&.id, bulletable_type: type[:name]),
              class: ["bullet--composer-create-button", "bullet--composer-create-button--#{type[:modifier]}",
                ("hotkey-hint" if type[:hotkey]),
              ].compact,
              data: {
                turbo_frame: composer_id,
                composer_transition_type: type[:modifier],
                controller: ("hotkey" if type[:hotkey]),
                hotkey: type[:hotkey],
                action: type[:hotkey_action]
              }.compact,
              aria: { label: "Add #{type[:name]}", keyshortcuts: type[:hotkey] }.compact do %>

          <i class="icon" style="--icon-mask: var(--icon-<%= type[:icon] %>)" aria-hidden="true"></i>
          <%= type[:name] %>
        <% end %>
      <% end %>
    </div>
  </turbo-frame>
</div>
