<%# locals: (f:, bullet:, type_name:, editing: false, body_html: nil) %>
<% bulletable = bullet.bulletable || type_name.constantize.new %>
<% raw_html = body_html.presence || bullet.body.body_before_type_cast.to_s.presence || bullet.editor_content_for_form %>
<% editor_value = hydrate_editor_content(raw_html) %>

<div class="<%= bulletable.editor_container_class %>">
  <%= f.rich_text_area :body,
        value: editor_value,
        autofocus: !editing,
        placeholder: bulletable.editor_placeholder,
        multiline: bulletable.editor_multiline?,
        rows: (bulletable.editor_multiline? ? nil : 1),
        preset: bulletable.actiontext_preset do %>
    <lexxy-prompt trigger="#"
                  name="project"
                  src="<%= project_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="@"
                  name="person"
                  src="<%= person_suggestions_path %>"
                  remote-filtering
                  supports-space-in-searches>
    </lexxy-prompt>
    <lexxy-prompt trigger="/" name="action">
      <% unless editing %>
        <% Bullet::Composer.type_options.each do |entry| %>
          <lexxy-prompt-item search="<%= entry[:type].downcase %>">
            <template type="menu">
              <button type="button"
                      data-action="bullet-composer#selectType"
                      data-type="<%= entry[:type] %>">
                <%= entry[:name] %>
              </button>
            </template>
          </lexxy-prompt-item>
        <% end %>
      <% end %>
      <% if bulletable.accepts_editor_attachments? %>
        <lexxy-prompt-item search="attachment">
          <template type="menu">
            <button type="button" data-action="bullet-composer#pickFile">Attachment</button>
          </template>
        </lexxy-prompt-item>
      <% end %>
    </lexxy-prompt>
  <% end %>
</div>
