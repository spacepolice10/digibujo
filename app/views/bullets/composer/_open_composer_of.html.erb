<%# locals: (path:, name:, icon:, modifier:, hidden: false, frame: "_self", hotkey: nil, hotkey_action: nil) %>
<%= link_to path, class: [
    "bullet--composer-create-button", "bullet--composer-create-button--#{modifier}",
    ("hotkey-hint" if hotkey && !hidden),
    ("utilities--sr-only" if hidden)
  ].compact, data: {
    turbo_frame: frame,
    composer_transition_type: modifier,
    controller: ("hotkey" if hotkey),
    hotkey: hotkey,
    action: hotkey_action
  }.compact, aria: {
    label: "Add #{name}",
    keyshortcuts: hotkey
  }.compact do %>
  <i
    class="icon"
    style="--icon-mask: var(--icon-<%= icon.dasherize %>)"
    aria-hidden="true"
  ></i>
  Add <%= name.downcase %>
<% end %>
