<%# locals: (id:, composer_id: "bullet_composer") %>
<%= render "shared/dialog",
      id: id,
      close_on_submit: false,
      standalone: true,
      class_name: "dialog--large bullet-composer--dialog layout--surface",
      actions: [
        "close->dialog#clearFrame",
        "composer:restore->dialog#close",
        "turbo:before-frame-render->dialog#openOnFrame"
      ] do %>
  <turbo-frame id="<%= composer_id %>"></turbo-frame>
<% end %>
