<%# locals: (id:, composer_id: "bullet_composer") %>
<%= render "shared/dialog",
      id: id,
      close_on_submit: false,
      standalone: true,
      controllers: %w[dialog composer-dialog],
      class_name: "dialog--lg bullets-form--dialog layout--surface",
      actions: [
        "close->composer-dialog#cleanupElement",
        "composer:restore->dialog#close",
        "turbo:before-frame-render->composer-dialog#openOnFrame"
      ] do %>
  <turbo-frame id="<%= composer_id %>"></turbo-frame>
<% end %>
