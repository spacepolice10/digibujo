<%# locals: (id:) %>
<dialog
  id="<%= id %>"
  class="dialog dialog--large bullet-composer--dialog"
  data-controller="composer-dialog"
  data-action="
    close->composer-dialog#closed
    click->composer-dialog#backdropClose
    cancel->composer-dialog#cancel
    turbo:before-frame-render->composer-dialog#beforeFrameRender
    turbo:frame-load->composer-dialog#frameLoad
    turbo:submit-end->composer-dialog#submitEnd
  "
>
  <div class="dialog--header">
    <span>New bullet</span>
    <button
      type="button"
      class="button--tertiary button--icon-subtle"
      data-action="composer-dialog#close"
      aria-label="Close composer"
    >
      <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
    </button>
  </div>

  <div class="dialog--body">
    <turbo-frame id="bullet_composer"></turbo-frame>
  </div>
</dialog>
