<% type_options = Bullet.bulletable_types %>
<% selected_type_name = bullet.bulletable_type.presence_in(type_options) || "Note" %>
<% bullet_types = type_options.index_with { |name|
  klass = name.constantize
  {
    bulletableType: name,
    icon: klass.icon,
    colour: klass.colour,
    marker: klass.marker
  }
}.transform_keys(&:downcase) %>
<%= form_with model: bullet, class: "bullet-form", data: {
      controller: "bullet-form persist",
      bullet_form_types_value: bullet_types.to_json,
      bullet_form_type_value: selected_type_name.downcase,
      action: "keydown.enter->bullet-form#submitByReturn keydown.meta+enter->bullet-form#submitByReturn keydown.ctrl+enter->bullet-form#submitByReturn trix-change->bullet-form#detectType trix-initialize->bullet-form#detectType"
    } do |f| %>

  <div class="bullet-form-rail">
<fieldset class="bullet-form-mobile-type" aria-label="Bullet type">
  <legend class="sr-only">Bullet type</legend>

  <% type_options.each do |type_name| %>
    <% bulletable = type_name.constantize %>

    <label
      data-bullet-type="<%= type_name.downcase %>"
      class="button-secondary bullet-form-mobile-type-option"
    >
      <%= f.radio_button :bulletable_type,
            type_name,
            checked: selected_type_name == type_name,
            data: {
              action: "change->bullet-form#selectType",
              bullet_form_type_param: type_name.downcase
            } %>

      <span
        class="bullet-form-type-option-marker icon bullet-<%= type_name.downcase %>--marker"
        style="--icon-mask: var(--icon-<%= bulletable.icon %>)"
        aria-hidden="true"
      ></span>

      <span class="bullet-form-type-option-name"><%= bulletable.name %></span>
    </label>
  <% end %>
</fieldset>

    <%= render "bullets/form_fields", bullet: bullet %>
  </div>

  <div class="bullet-form-composer">
<div class="bullet-form-editor">
  <%= f.rich_text_area :content,
        autofocus: "true",
        placeholder: "What's on your mind?" %>
</div>
<div class="bullet-form-footer">
  <%= f.button type: "submit", class: "button-primary" do %>
    Dump
  <% end %>
</div>
  </div>

  <%= render "bullets/form_errors", bullet: bullet %>
<% end %>
