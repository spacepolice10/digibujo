<%# locals: (bullet:, bullets_path: nil, editing: false, return_to: nil) %>
<% bulletable = bullet.composer_bulletable %>
<dialog
  class="bullet-composer--mobile-dialog"
  data-controller="mobile-composer composer"
  data-action="cancel->composer#dialogCancel close->composer#dismiss"
>
  <%= form_with model: bullet, url: bullets_path, class: "bullet-composer bullet-composer--mobile", data: {
    composer_form: true,
    controller: bulletable.stimulus_controller.presence,
    composer_editing: (editing || nil),
    voice_recorder_duration_seconds_value: (Voice::DURATION_SECONDS if bullet.voice?),
    action: bulletable.stimulus_actions
  }.compact do |fr| %>
    <%= fr.hidden_field :pops_on, value: bullet.pops_on %>
    <%= fr.hidden_field :bucket_id, value: bullet.bucket_id %>
    <%= hidden_field_tag :return_to, return_to if return_to.present? %>
    <%= fr.hidden_field :bulletable_type %>

    <div class="bullet-composer--mobile-body">
      <%= fr.fields_for :bulletable, bulletable do |bf| %>
        <%= render "bullets/composer/action_text", form: bf, bullet: bullet, preset: bulletable.preset, placeholder: bulletable.placeholder, autofocus: bulletable.focusing_on_render?, editor_html_options: bulletable.editor_html_options %>
      <% end %>
    </div>

    <div class="bullet-composer--mobile-rail" data-mobile-composer-target="rail">
      <%= render "bullets/composer/rail_type", bullet: bullet, editing: editing %>

      <%= render bulletable.to_toolbar_path, fr: fr, bullet: bullet, bulletable: bulletable if bulletable.to_toolbar_path.present? %>

      <div class="bullet-composer--rail-actions">
        <%= render "bullets/composer/submit_actions", fr: fr, editing: editing %>
      </div>
    </div>
  <% end %>
</dialog>
