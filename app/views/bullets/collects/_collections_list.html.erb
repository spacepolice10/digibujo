<%# locals: (bullet_ids:, return_to:, collects_q:, collections:, collections_page:) %>
<%= render layout: "pagination/paginated_list",
      locals: {
        page: collections_page,
        container_id: "paginated-collects-collections",
        turbo_frame: "collects_picker_dropdown_id",
        pagination_link_path: lambda { |next_param|
          new_collect_path(
            bullet_ids: bullet_ids,
            return_to: return_to,
            q: collects_q,
            collections_page: next_param
          )
        }
      } do %>
  <ul class="layout--list bucket--list" role="listbox">
    <%= render partial: "bullets/collects/collection",
          collection: collections,
          locals: { bullet_ids: bullet_ids } %>
  </ul>
<% end %>
