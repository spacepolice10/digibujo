<% frame_id = params[:frame_id].presence || "collects_picker_frame" %>
<%= turbo_stream.replace "paginated-collects-collections" do %>
  <%= render "bullets/collects/collections_list",
        bullet_ids: params[:bullet_ids].to_s,
        frame_id: frame_id,
        return_to: @return_to,
        collects_q: @collects_q,
        collections: @collections,
        collections_page: @collections_page %>
<% end %>

<% if Sprint.enabled? %>
  <%= turbo_stream.replace "paginated-collects-sprints" do %>
    <%= render "bullets/collects/sprints_list",
          bullet_ids: params[:bullet_ids].to_s,
          frame_id: frame_id,
          return_to: @return_to,
          collects_q: @collects_q,
          sprints: @sprints,
          sprints_page: @sprints_page %>
  <% end %>
<% end %>
