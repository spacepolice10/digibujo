<%# locals: (bullet_ids: "", frame_id: "collects_picker_frame", return_to: nil, collects_q: nil, collections: []) %>
<div class="bulk-menu--action-header">
  <p class="bulk-menu--action-name">Collect into collection</p>
  <button type="button"
          class="button--secondary button--icon"
          popovertarget="<%= frame_id %>"
          popovertargetaction="hide"
          aria-label="Close collection picker">
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
</div>

<%= form_with url: new_collect_path,
      method: :get,
      class: "search-form",
      data: { turbo_frame: frame_id } do %>
  <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
  <%= hidden_field_tag :frame_id, frame_id if frame_id != "collects_picker_frame" %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <%= search_field_tag :q,
        collects_q,
        class: "form-input",
        placeholder: "Search collections",
        autofocus: true,
        autocomplete: "off" %>
<% end %>

<% if collections.any? %>
  <ul class="layout--list bucket--list">
    <%= render partial: "bullets/collects/collection", collection: collections, locals: { bullet_ids: bullet_ids } %>
  </ul>
<% else %>
  <p>No collections found.</p>
<% end %>

<div class="bulk-menu--action-footer">
  <%= link_to "Create new collection",
        new_collection_path(bullet_ids: bullet_ids, return_to: return_to),
        class: "button--secondary",
        data: { turbo_frame: "_top" } %>
</div>
