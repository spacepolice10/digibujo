<%# locals: (sprint:, bullet_ids: "") %>
<li class="layout--list-item" role="option">
  <%= form_with url: collect_path,
        method: :post,
        class: "bulk-menu--collect-form",
        data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, sprint.bucket.id %>
    <button type="submit"
            class="bulk-menu--collect-item-link"
            data-combobox-target="item">
      <%= render "sprints/search_palette", sprint: sprint %>
    </button>
  <% end %>
</li>
