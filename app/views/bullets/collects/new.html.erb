<% frame_id = params[:frame_id].presence || "collects_picker_frame" %>
<turbo-frame id="<%= frame_id %>" class="bulk-menu--action-menu bulk-menu--action-frame" popover>
  <%= render "picker",
        bullet_ids: params[:bullet_ids].to_s,
        frame_id: frame_id,
        return_to: @return_to,
        collects_q: @collects_q,
        collections: @collections,
        collections_page: @collections_page,
        sprints: @sprints,
        sprints_page: @sprints_page %>
</turbo-frame>
