<% content_for(:title) { "New bullet" } %>

<div class="session-layout">
  <div class="layout--header">
    <%= link_to daylog_path, class: "button--secondary" do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-left)"
        aria-hidden="true"
      ></i>
      Back
    <% end %>

    <div></div>
  </div>

  <turbo-frame id="<%= turbo_frame_request_id %>" class="utilities--contents">
    <% if @bullet.bulletable_type.present? %>
      <%= render @bullet.to_form_path, bullet: @bullet, editing: false %>
    <% else %>
      <%= render "bullets/composer/dock",
            selected_date: @bullet.pops_on || Date.current,
            bucket: @bullet.bucket || Current.user.ensure_daylog_bucket!,
            composer_id: turbo_frame_request_id.presence || "bullet_composer" %>
    <% end %>
  </turbo-frame>
</div>
