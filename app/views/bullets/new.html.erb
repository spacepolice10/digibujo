<% composer_frame_id = @composer_attributes[:composer_id].presence || "bullet_composer" %>
<turbo-frame id="<%= composer_frame_id %>" data-controller="composer-frame">
  <% if @bullet.bulletable_type.blank? %>
    <%= render "bullets/composer/picker",
          composer_id: composer_frame_id,
          attributes: @composer_attributes.except(:composer_id) %>
  <% else %>
    <%= render "bullets/composer/form",
          bullet: @bullet,
          attributes: @composer_attributes.merge(composer_id: composer_frame_id) %>
  <% end %>
</turbo-frame>
