<% content_for(:title) { "New bullet" } %>

<div class="layout--page layout--container layout--container-md">
  <% if @bullet.bulletable_type.present? %>
    <%= render @bullet.to_form_path,
          bullet: @bullet,
          editing: false,
          return_path: bullet_composer_return_path(@bullet) %>
  <% else %>
    <div class="bullets-form--dock<%= " bullets-form--dock-mobile" if request.variant.include?(:mobile) %>">
      <div class="bullets-form--buttons">
        <%= create_bullet_buttons bucket_id: (@bullet.bucket || Current.user.daylog.bucket).id,
              pops_on: @bullet.pops_on || Date.current,
              bulletable_type: Bullet.bulletable_types %>
      </div>
    </div>
  <% end %>
</div>
