<% id = turbo_frame_request_id.to_s %>
<% prefix = id.split("_bullets_").first %>
<% partial = if prefix.present? && lookup_context.exists?("#{prefix.pluralize}/bullets/bullet", [], true, formats: [:html])
               "#{prefix.pluralize}/bullets/bullet"
             else
               "bullets/bullet"
             end %>
<% target = id.sub(/composer/, 'container') %>

<%= turbo_stream.append target do %>
  <%= render partial: partial, locals: { bullet: @bullet } %>
<% end %>
