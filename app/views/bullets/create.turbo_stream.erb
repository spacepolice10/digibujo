<%= turbo_stream.append "bullets", @bullet %>

<%= turbo_stream.update "new_bullet_form" do %>
  <%= render "bullets/composer",
        attributes: { pops_on: @bullet.pops_on, bucket_id: @bullet.bucket_id } %>
<% end %>

<% if @bullet.pops_on.present? && @bullet.pops_on > Date.current %>
<%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "notify", messages: ["Bullet created and scheduled for #{@bullet.pops_on.strftime("%B %d")}"] %>
<% end %>
<% end %>
