<%= turbo_stream.append "bullets" do %>
  <%= render @bullet %>
<% end %>

<% if @bullet.pops_on.present? && @bullet.pops_on > Date.current %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "notify", messages: ["Scheduled for #{@bullet.pops_on.strftime('%B %d')}"] %>
  <% end %>
<% end %>
