<% if @error_message %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: [@error_message] %>
  <% end %>
<% else %>
  <% @bullets.each do |bullet| %>
    <%= turbo_stream.replace_all bullet do %>
      <%= render "bullets/bullet", bullet: bullet %>
    <% end %>
  <% end %>
<% end %>
