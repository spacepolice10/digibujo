<% if q.present? %>
  <% if entries.any? %>
    <ul class="layout--list menu--palette-list" role="listbox">
      <% entries.each do |entry| %>
        <%= render "searches/entry", entry: entry %>
      <% end %>
    </ul>
  <% else %>
    <p class="search--empty">No results for "<%= q %>"</p>
  <% end %>
<% elsif selections&.any? %>
  <h4 class="menu--section-heading">Recent</h4>
  <ul class="layout--list menu--palette-list" role="listbox">
    <% selections.each do |selection| %>
      <%= render "searches/entry", entry: selection.to_entry %>
    <% end %>
  </ul>
<% end %>
