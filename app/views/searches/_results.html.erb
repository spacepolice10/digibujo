<turbo-frame id="search_results">
<div class="search--results">
    <% if q.present? && bullets.any? %>
      <h3>Results for "<%= q %>"</h3>
      <%= render "pagination/paginated_records",
        page: page,
        pagination_link_path: ->(next_param) { search_path(q: q, page: next_param) } %>
    <% end %>
  </div>
</turbo-frame>
