<% if q.present? %>
  <% if entries.any? %>
    <ul class="layout--list menu--palette-list" role="listbox">
      <% entries.each do |entity| %>
        <%= render "searches/palette_item", entity: entity %>
      <% end %>
    </ul>
  <% else %>
    <p class="search--empty">No results for "<%= q %>"</p>
  <% end %>
<% elsif selections&.any? %>
  <%= render "searches/recent", selections: selections %>
<% end %>
