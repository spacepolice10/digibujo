<% if q.present? %>
  <% if projects.any? || buckets.any? || bullets.any? || people.any? %>
    <% if projects.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">Projects</h4>
        <ul class="layout--list bucket--list" role="listbox">
          <% projects.each do |project| %>
            <%= render "searches/project", project: project %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if buckets.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">Buckets</h4>
        <ul class="layout--list bucket--list" role="listbox">
          <% buckets.each do |bucket| %>
            <%= render "searches/bucket", bucket: bucket %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if people.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">People</h4>
        <ul class="layout--list bucket--list" role="listbox">
          <% people.each do |person| %>
            <%= render "searches/person", person: person %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if bullets.any? %>
      <section class="menu--palette-section">
        <h4 class="search--section-heading">Bullets</h4>
        <ul class="layout--list menu--palette-list" role="listbox">
          <% bullets.each do |bullet| %>
            <%= render "searches/bullet", bullet: bullet %>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="search--empty">No results for "<%= q %>"</p>
  <% end %>
<% end %>
