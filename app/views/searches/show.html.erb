<% content_for(:title, "Search") %>

<%= render "shared/tabbar" %>

<main
  class="chat--window search--window"
  data-size="md"
  data-controller="search"
  data-search-path-value="<%= search_path %>"
>
  <div class="chat--scroller search--scroller">
    <h1>Search</h1>

    <%= turbo_frame_tag "search_section", class: "search--section", data: { search_target: "section" } do %>
      <% if @q.present? %>
        <%= render "results", entries: @entries %>
      <% else %>
        <%= render "navigation" %>
      <% end %>
    <% end %>
  </div>

  <div id="search_dock" class="chat--composer search--dock">
    <%= render "searches/form", q: @q %>
  </div>
</main>
