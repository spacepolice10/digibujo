<% content_for(:title, "Search") %>

<%= render "shared/tabbar" %>

<main
  class="timeline--window search--window"
  data-size="sm"
  data-controller="search"
  data-search-path-value="<%= search_path %>"
>
  <div class="timeline--scroller search--scroller">
    <%= turbo_frame_tag "search_section", class: "search--section", data: { search_target: "section" } do %>
      <% if @q.present? %>
        <%= render "results", entries: @entries %>
      <% else %>
        <div class="search--navigation">
          <h1>Search</h1>
          <%= render "navigation", collections: @collections, attachments_count: @attachments_count, archived_count: @archived_count %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div id="search_dock" class="timeline--composer search--dock">
    <%= render "searches/form", q: @q %>
  </div>
</main>
