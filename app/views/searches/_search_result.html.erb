<%# locals: (entry:, query:) %>
<%= link_to polymorphic_path(entry), class: "search--result", data: { combobox_target: "item" } do %>
  <span class="search--result-icon">
    <%= icon(entry.search_result_icon, style: ("color: #{entry.colour_variable};" if entry.respond_to?(:colour_variable))) %>
  </span>
  <span class="search--result-content">
    <span class="search--result-type"><%= entry.search_result_type %></span>
    <span class="search--result-body"><%= highlight_search_result(entry.search_result_body, query) %></span>
  </span>
<% end %>
