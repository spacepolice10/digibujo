<%# locals: (q:) %>
<div class="search">
  <%= form_with url: search_path, method: :get, class: "utilities--contents" do %>
    <input
      type="search"
      name="q"
      class="search--textform"
      placeholder="Search…"
      value="<%= q.to_s %>"
      autocomplete="off"
      data-search-target="input"
      data-action="input->search#input"
      aria-label="Search"
    >

    <button
      type="button"
      class="search--control search--cleanup"
      aria-label="Clear search"
      data-action="search#cleanup"
    >
      <%= icon("x") %>
    </button>
  <% end %>
</div>
