<article id="search_navigation" class="search--navigation">
  <ul data-layout="column" data-divider="true">
    <li>
      <%= link_to attachments_path, data: { turbo_frame: "_top" } do %>
        <%= icon("paperclip") %>
        <p>Attachments</p>
        <% if @attachment_count.positive? %>
          <small class="search--navigation-item-counter"><%= @attachment_count %></small>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= link_to archived_index_path, data: { turbo_frame: "_top" } do %>
        <%= icon("archive") %>
        <p>Archive</p>
        <% if @archive_count.positive? %>
          <small class="search--navigation-item-counter"><%= @archive_count %></small>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= link_to bullets_path(from: Date.current + 1), data: { turbo_frame: "_top" } do %>
        <%= icon("calendar") %>
        <p>Upcoming</p>
      <% end %>
    </li>
  </ul>
</article>

<ul id="search_collections" data-layout="grid">
  <li>
    <%= link_to new_collection_path, class: "collection-chip", data: { turbo_frame: "_top" } do %>
      <%= icon("plus") %>
      <span>New</span>
    <% end %>
  </li>
  <% @collections.each do |collection| %>
    <li>
      <%= link_to bullets_path(collection: collection.name), class: "collection-chip", data: { turbo_frame: "_top" } do %>
        <%= icon("hash", style: ("color: #{colour(collection.colour)};" if collection.colour.present?)) %>
        <span><%= collection.name %></span>
      <% end %>
    </li>
  <% end %>
</ul>
