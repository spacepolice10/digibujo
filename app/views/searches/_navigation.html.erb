<article id="search_navigation" class="search--navigation">
  <ul data-layout="column" data-divider="true">
    <li>
      <%= link_to attachments_path, data: { turbo_frame: "_top" } do %>
        <%= icon("paperclip") %>

        <p>Attachments</p>

        <% if attachments_count.positive? %>
          <small class="search--navigation-item-counter"><%= attachments_count %></small>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= link_to completed_index_path, data: { turbo_frame: "_top" } do %>
        <%= icon("check") %>

        <p>Completed</p>

        <% if completed_count.positive? %>
          <small class="search--navigation-item-counter"><%= completed_count %></small>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= link_to archived_index_path, data: { turbo_frame: "_top" } do %>
        <%= icon("archive") %>

        <p>Archive</p>

        <% if archived_count.positive? %>
          <small class="search--navigation-item-counter"><%= archived_count %></small>
        <% end %>
      <% end %>
    </li>


    <li>
      <%= link_to collections_path, data: { turbo_frame: "_top" } do %>
        <%= icon("folder") %>

        <p>Collections</p>
      <% end %>
    </li>

    <li>
      <%= link_to bullets_path(from: Date.current + 1), data: { turbo_frame: "_top" } do %>
        <%= icon("calendar") %>

        <p>Upcoming</p>
      <% end %>
    </li>
  </ul>
</article>

