<turbo-frame id="home_activity">
  <div class="activity--rail-list">
    <% if @activities.any? %>
      <% @activities.each do |activity| %>
        <%= render "activities/item", activity: activity, density: :rail %>
      <% end %>
    <% else %>
      <p class="utilities--text-sm" style="color: var(--color-fg-subtle);">No recent activity</p>
    <% end %>
  </div>
</turbo-frame>
