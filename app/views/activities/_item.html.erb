<%# locals: (activity:, density: :rail) %>
<% subject = activity.subject %>
<div id="<%= dom_id(activity) %>" class="activity--item activity--<%= density %>-item">
  <% case subject %>
  <% when Bullet %>
    <span class="activity--dot"
          data-bullet-type="<%= subject.bulletable_type.downcase %>"
          aria-hidden="true"></span>
    <%= link_to bullet_path(subject), class: "activity--subject-link", data: { turbo_frame: "_top" } do %>
      <span class="activity--subject-name utilities--line-clamp-1"><%= subject.name.truncate(60) %></span>
    <% end %>
  <% when Bucket %>
    <span class="activity--dot" data-bucket-colour="<%= subject.colour %>" aria-hidden="true"></span>
    <%= link_to polymorphic_path(subject.bucketable), class: "activity--subject-link", data: { turbo_frame: "_top" } do %>
      <span class="activity--subject-name utilities--line-clamp-1"><%= subject.name.truncate(60) %></span>
    <% end %>
  <% else %>
    <span class="activity--dot" aria-hidden="true"></span>
    <span class="activity--subject-name utilities--line-clamp-1">
      <%= activity.subject_type == 'Bullet' ? 'Deleted bullet' : 'Deleted bucket' %>
    </span>
  <% end %>

  <% hint_id = dom_id(activity, :hint_action) %>
  <% hint_anchor = "--hint-activity-#{activity.id}" %>
  <button type="button"
          class="layout--filter-option activity--action"
          interestfor="<%= hint_id %>"
          style="anchor-name: <%= hint_anchor %>"
          aria-label="<%= activity.action_name %>">
    <i class="icon" style="--icon-mask: <%= activity.icon_mask %>" aria-hidden="true"></i>
  </button>

  <% if density == :feed && activity.detail.present? %>
    <p class="activity--detail utilities--line-clamp-1"><%= activity.detail %></p>
  <% end %>

  <% if density == :feed %>
    <time class="activity--time" datetime="<%= activity.created_at.to_fs(:db) %>">
      <%= l(activity.created_at, format: :short) %>
      <span class="activity--time-relative">· <%= time_ago_in_words(activity.created_at) %> ago</span>
    </time>
  <% else %>
    <span class="activity--time-relative"><%= time_ago_in_words(activity.created_at) %> ago</span>
  <% end %>

  <div id="<%= hint_id %>"
       class="hint"
       popover="hint"
       style="position-anchor: <%= hint_anchor %>">
    <%= activity.action_name %>
  </div>
</div>
