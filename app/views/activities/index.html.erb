<% content_for(:title, "Activity") %>

<div class="layout--page activity--page">
  <div class="layout--header activity--header">
    <%= link_to home_path, class: "button--tertiary", data: { turbo_frame: "_top" } do %>
      <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      Back
    <% end %>

    <div class="activity--header-title">
      <h2>Activity</h2>
    </div>
  </div>

  <div class="layout--surface">
    <% if @page.records.any? %>
      <%= render layout: "pagination/paginated_list",
            locals: {
              page: @page,
              container_id: "activity-feed",
              pagination_link_path: ->(next_param) { activities_path(page: next_param) }
            } do %>
        <div class="activity--feed-list">
          <% previous_date = nil %>
          <% @page.records.each do |activity| %>
            <% activity_date = activity.created_at.to_date %>
            <% if previous_date != activity_date %>
              <h3 class="activity--date"><%= activity_date.strftime('%A, %B %-d') %></h3>
              <% previous_date = activity_date %>
            <% end %>
            <%= render "activities/activity", activity: activity %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="activity--empty utilities--text-sm">No activity yet.</p>
    <% end %>
  </div>
</div>
