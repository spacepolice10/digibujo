<% content_for(:title) { "Activity" } %>

<main class="activity--page" data-size="md">
  <article class="activity--surface" data-elevation="1">
    <header class="activity--header">
      <nav>
        <%= icon_tag("history") %>
        <h1>Activity</h1>
      </nav>
    </header>

    <% if @page.records.any? %>
      <%= render layout: "pagination/paginated_list",
            locals: {
              page: @page,
              container_id: "activity-feed",
              pagination_link_path: ->(next_param) { activities_path(page: next_param) }
            } do %>
        <div class="activity--feed-list">
          <% previous_date = nil %>
          <% @page.records.each do |activity| %>
            <% date = activity.created_at.in_time_zone.to_date %>
            <% if previous_date != date %>
              <div class="activity--date-divider" role="separator" aria-label="<%= date.strftime('%b %-d, %Y') %>">
                <%= link_to timeline_path,
                      class: "button activity--date-pill",
                      data: { content: "text", turbo_frame: "_top" } do %>
                  <time datetime="<%= date.iso8601 %>"><%= date.strftime('%b %-d, %Y') %></time>
                <% end %>
              </div>
              <% previous_date = date %>
            <% end %>

            <%= render "activities/activity", activity: activity %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="activity--empty">No activity yet.</p>
    <% end %>
  </article>
</main>
