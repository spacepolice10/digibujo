<% content_for(:title) { "Published" } %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to home_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %><span>Home</span>
      <% end %>
      <h1>Published</h1>
    </header>

    <div class="layout--flex" data-direction="column">
      <% if @bullets.any? %>
        <%= render partial: "published/bullet", collection: @bullets, as: :bullet %>
      <% else %>
        <p class="typography--paragraph-sm">Nothing published yet.</p>
      <% end %>
    </div>
  </div>
</main>
