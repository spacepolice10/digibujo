<% content_for(:title) { @bullet.bulletable.name } %>
<article class="bullet-show">
  <header class="bullet-show-header">
    <div class="bullet-show-meta">
      <span class="bullet-type" data-bullet-type="<%= @bullet.bulletable_type.downcase %>"><%= bullet_type_label(@bullet) %></span>
    </div>
    <% if @bullet.bucket.present? %>
      <div class="bullet-tags">
        <% bucket = @bullet.bucket %>
          <% b = bucket.bucketable %>
          <% if b %>
          <span class="<%= ["pill", bucket.colour.present? ? "pill--#{bucket.colour}" : nil].compact.join(" ") %>"><%= b.name %></span>
          <% end %>
      </div>
    <% end %>
  </header>
  <div class="bullet-show-body">
    <%= @bullet.content %>
  </div>
  <footer class="bullet-show-footer">
    <time class="bullet-show-date"><%= @bullet.created_at.strftime("%-d %b %Y") %></time>
  </footer>
</article>
