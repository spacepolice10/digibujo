<footer class="footer">
  <div class="footer--dock">
    <div id="pinned_bullets_dock" data-turbo-permanent>
      <%= render "pinned/pinned_bullets_dock" %>
    </div>
    <div id="pinned_buckets_footer" data-turbo-permanent>
      <%= render "pinned/pinned_buckets_footer",
            buckets: Current.user.buckets.pinned.order(updated_at: :desc).includes(:bucketable) %>
    </div>
  </div>
</footer>
