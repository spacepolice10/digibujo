<%# locals: (name: nil, popover_target: nil) %>
<% if name.present? && popover_target.present? %>
  <div class="dropdown--element-header">
    <h2><%= name %></h2>
    <button
      type="button"
      class="button--primary button--icon button--circle dropdown--element-hide"
      popovertarget="<%= popover_target %>"
      popovertargetaction="hide"
      aria-label="<%= "Close #{name.downcase}" %>"
    >
      <%= icon_tag("x") %>
    </button>
  </div>
<% end %>

<div class="dropdown--element-body">
  <%= yield %>
</div>
