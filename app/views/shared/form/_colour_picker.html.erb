
<div class="form-group">
  <span class="form-label">Colour</span>
  <small class="form-small">
    Pick a colour to make this record easy to spot.
  </small>
  <div class="form--picker" role="radiogroup" aria-label="Colour picker">
    <% Colourable::COLOUR_MAPPINGS.each_key do |name| %>
      <label class="form-check">
        <%= form.radio_button :colour, name %>
        <span class="form--picker-control form--colour-swatch" style="background: <%= Colourable.colour_bg_variable_of(name) %>" aria-hidden="true"></span>
        <span class="utilities--sr-only"><%= name.capitalize %></span>
      </label>
    <% end %>
  </div>
</div>
