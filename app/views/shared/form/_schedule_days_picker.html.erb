<%# locals: (form:) %>
<% schedule_days = form.object.schedule_days %>
<div class="form-group">
  <span class="form-label">Days</span>
  <div class="form--picker form--repeat-date-picker"
       role="group"
       data-controller="grid-navigation"
       data-grid-navigation-columns-value="7"
       data-action="keydown->grid-navigation#navigate">
    <% Date::ABBR_DAYNAMES.each_with_index do |label, wday| %>
      <label class="form--picker-option">
        <input type="checkbox"
               name="<%= form.object_name %>[schedule_days][]"
               value="<%= wday %>"
               <% if schedule_days.include?(wday) %>checked<% end %>
               data-grid-navigation-target="item"
               data-action="focus->grid-navigation#syncPosition">
        <span class="form--picker-control form--repeat-date-control" aria-hidden="true"><%= label %></span>
        <span class="utilities--sr-only"><%= Date::DAYNAMES[wday] %></span>
      </label>
    <% end %>
  </div>
</div>
