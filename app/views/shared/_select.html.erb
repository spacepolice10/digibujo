<% select_id = local_assigns[:id] %>
<% select_name = local_assigns[:name] %>
<% select_classes = ["select", local_assigns[:class]].compact.join(" ") %>
<% select_data = local_assigns[:data] || {} %>
<% select_aria_label = local_assigns[:aria_label] %>
<% button_class = local_assigns[:button_class] %>
<% button_icon = local_assigns[:button_icon] %>
<% button_content = local_assigns[:button] %>
<% options = local_assigns[:options] || [] %>
<% placeholder = local_assigns[:placeholder] %>

<%= tag.select name: select_name,
               id: select_id,
               class: select_classes,
               aria: { label: select_aria_label },
               data: select_data,
               hidden: local_assigns[:hidden] do %>
  <% if button_class.present? %>
    <button type="button" class="<%= button_class %>">
      <% if button_icon.present? %>
        <i class="icon" style="--icon-mask: var(--icon-<%= button_icon %>)" aria-hidden="true"></i>
      <% elsif button_content.present? %>
        <%= button_content %>
      <% end %>
    </button>
  <% end %>

  <% if placeholder.present? %>
    <option value="<%= placeholder[:value] || "" %>"
            <% if placeholder.fetch(:disabled, true) %>disabled<% end %>
            <% if placeholder[:selected] %>selected<% end %>
            <% if placeholder[:hidden] %>hidden<% end %>>
      <%= placeholder[:label] %>
    </option>
  <% end %>

  <% options.each do |entry| %>
    <% option_attrs = { value: entry[:value] } %>
    <% option_attrs[:selected] = true if entry[:selected] %>
    <% option_attrs[:disabled] = true if entry[:disabled] %>
    <% option_attrs[:hidden] = true if entry[:hidden] %>
    <% option_attrs[:data] = entry[:data] if entry[:data].present? %>
    <%= tag.option(**option_attrs) do %>
      <span class="select--option">
        <span class="select--option-marker<%= " select--option-marker--#{entry[:modifier]}" if entry[:modifier].present? %>" aria-hidden="true">
          <i class="icon" style="--icon-mask: var(--icon-<%= entry[:icon] %>)" aria-hidden="true"></i>
        </span>
        <span class="select--option-label"><%= entry[:name] %></span>
        <% if entry[:hint].present? %>
          <span class="select--option-hint"><%= entry[:hint] %></span>
        <% end %>
      </span>
    <% end %>
  <% end %>
<% end %>
