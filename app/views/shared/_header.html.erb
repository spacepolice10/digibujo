<header class="header">
  <div class="header--branding">
    <div class="header--menu">
      <button
        type="button"
        class="button--accent"
        popovertarget="header_menu"
        aria-haspopup="menu"
      >
        Digibujo
        <i class="icon" style="--icon-mask: var(--icon-chevron-down)" aria-hidden="true"></i>
      </button>

      <div
        id="header_menu"
        class="dropdown-body menu--wrap"
        popover
        data-controller="menu"
        data-action="toggle->menu#focusOnOpen keydown->menu#keydown turbo:before-visit@document->menu#close keydown.ctrl+k@document->menu#open keydown.meta+k@document->menu#open"
      >
        <%= render "menu/menu" %>
      </div>
    </div>
  </div>
</header>
