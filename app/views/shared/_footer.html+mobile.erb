    <i class="icon" style="--icon-mask: var(--icon-home)" aria-hidden="true"></i>
  <% end %>
  <%= link_to daylog_path, class: "tabbar-item #{'tabbar-item--active' if controller_name == 'daylogs'}", aria: { label: "Timeline" } do %>
