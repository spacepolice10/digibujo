<nav class="menu--navigation"
     data-controller="grid-navigation"
     data-grid-navigation-columns-value="4"
     data-action="keydown->grid-navigation#navigate">
  <%= link_to activities_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "1",
          grid_navigation_target: "item",
          action: "keydown.1@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "1", label: "Activity" } do %>
    <i class="icon" style="--icon-mask: var(--icon-list)" aria-hidden="true"></i>
    <span class="menu--navigation-label">Activity</span>
  <% end %>
  <%= link_to review_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "2",
          grid_navigation_target: "item",
          action: "keydown.2@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "2", label: "Review" } do %>
    <i class="icon" style="--icon-mask: var(--icon-circle-check)" aria-hidden="true"></i>
    <span class="menu--navigation-label">Review</span>
  <% end %>
  <%= link_to archived_index_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "3",
          grid_navigation_target: "item",
          action: "keydown.3@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "3", label: "Archived" } do %>
    <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
    <span class="menu--navigation-label">Archived</span>
  <% end %>
  <%= link_to published_index_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "4",
          grid_navigation_target: "item",
          action: "keydown.4@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "4", label: "Published" } do %>
    <i class="icon" style="--icon-mask: var(--icon-link)" aria-hidden="true"></i>
    <span class="menu--navigation-label">Published</span>
  <% end %>
</nav>
