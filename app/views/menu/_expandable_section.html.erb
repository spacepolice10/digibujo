<details class="home--section"<% if local_assigns.fetch(:expanded, false) %> open<% end %>>
  <summary class="home--section-summary">
    <span class="home--section-name">
      <% if local_assigns[:icon].present? %>
        <i class="icon home--section-icon" style="--icon-mask: var(--icon-<%= icon %>)" aria-hidden="true"></i>
      <% end %>
      <%= title %>
    </span>
    <i class="icon home--section-chevron" style="--icon-mask: var(--icon-chevron-down)" aria-hidden="true"></i>
    <% if local_assigns[:show_more_path].present? %>
      <%= link_to "Show more",
            show_more_path,
            class: "home--section-more",
            data: { turbo_frame: "_top" },
            onclick: "event.stopPropagation()",
            "aria-label": "All #{title.downcase}" %>
    <% end %>
  </summary>
  <%= yield %>
</details>
