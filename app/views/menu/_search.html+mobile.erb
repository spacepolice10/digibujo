<div class="search--field">
  <%= form_with url: search_path,
        method: :get,
        class: "search--form",
        data: { combobox_target: "searchForm" } do |form| %>
    <%= form.label :q, "Search bullets, projects, and collections", class: "form-label utilities--sr-only" %>

    <%= form.search_field :q,
          value: "",
          placeholder: "Search…",
          class: "form-input",
          data: {
            menu_target: "focus",
            search_target: "textform",
            combobox_target: "searchField",
            action: "focus->combobox#activate blur->combobox#deactivate input->combobox#search keydown->combobox#navigate"
          } %>
  <% end %>

  <button type="button"
          class="search--dismiss button--tertiary button--icon-subtle"
          data-action="combobox#dismiss"
          aria-label="Close search">
    <i class="icon" style="--icon-mask: var(--icon-x)" aria-hidden="true"></i>
  </button>
</div>
