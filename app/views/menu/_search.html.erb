<%= form_with url: search_path,
      method: :get,
      local: true,
      class: "search--form",
      data: { search_target: "form", turbo_frame: "menu_search" } do |form| %>
  <%= render "shared/search_field",
        form: form,
        value: "",
        label: "Search bullets, projects, collections, and people",
        placeholder: "Search…",
        input_data: {
          menu_target: "focus",
          search_target: "textform",
          action: "input->search#search keydown->combobox#navigate"
        } %>
<% end %>
