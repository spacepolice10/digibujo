<%= form_with model: collection do |f| %>
  <% if bullet_ids.present? %>
    <%= hidden_field_tag :bullet_ids, bullet_ids %>
    <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% end %>


    <label>
      <legend>Name</legend>
      <%= f.text_field :name, required: true, autocomplete: "off", maxlength: 140, placeholder: "Reading list, Travel plans, Work ideas." %>
    </label>
      <%= render "shared/form/colour_picker", form: f %>
      <%= render "shared/form/icon_picker", form: f %>


  <% if bullet_ids.present? %>
    <%= f.submit "Create and collect", class: "button", data: { intent: "primary", radius: "full", size: "sm" } %>
  <% else %>
    <%= f.submit "Create", class: "button", data: { intent: "primary", radius: "full", size: "sm" } %>
  <% end %>
<% end %>
