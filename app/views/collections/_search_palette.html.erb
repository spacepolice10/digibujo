<div class="bucket--list-item-name">
  <div class="bucket--list-item-marker" data-bucket-colour="<%= collection.colour %>" aria-hidden="true">
    <%= image_tag collection.bucket.icon_path, alt: "#{collection.bucket.name} icon", class: "icons--list" %>
  </div>
  <span class="utilities--line-clamp-1"><%= collection.name %></span>
</div>
