<% content_for(:title) { "Collections" } %>

<div class="layout--page">
  <h2>Collections</h2>

  <div class="layout--header-actions">
    <%= link_to home_path, class: "button--tertiary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-left)"
        aria-hidden="true"
      ></i>
      Back
    <% end %>

    <%= link_to new_collection_path, class: "button--tertiary", aria: { label: "Add collection" } do %>
      <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
      Add collection
    <% end %>
  </div>

  <ul class="layout--list layout--surface">
    <%= render @collections %>
  </ul>
</div>
