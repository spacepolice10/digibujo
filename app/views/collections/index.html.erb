<% content_for(:title) { "Collections" } %>

<div class="layout--page">
  <div class="bucket--list">
    <div class="bullet-composer">
      <%= link_to new_collection_path, class: "bullet-composer--add", aria: { label: "Add collection" } do %>
        <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
        Add collection
      <% end %>
    </div>
    <ul class="layout--list">
      <%= render @collections %>
    </ul>
  </div>
</div>
