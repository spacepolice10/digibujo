<% content_for(:title, "Collections") %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
        <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>
        <h1>Collections</h1>
      </nav>
      <%= link_to new_collection_path, class: "button", data: { intent: "primary", radius: "full", size: "xs" } do %>
        <%= icon_tag("plus") %><span>New</span>
      <% end %>
    </header>

    <main id="collections">
      <% if @collections.any? %>
        <section>
            <% @collections.each do |collection| %>
              <li><%= render collection %></li>
            <% end %>
        </section>
      <% else %>
        <p class="typography--paragraph-sm">No collections yet.</p>
      <% end %>
    </main>
  </article>
</main>
