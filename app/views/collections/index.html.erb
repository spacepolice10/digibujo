<% content_for(:title, "Collections") %>

<%= render "shared/back_tabbar" %>


<main>
  <header>
    <h1>Collections</h1>
  </header>

  <ul data-layout="grid">
    <% @collections.each do |collection| %>
      <li>
        <%= link_to collection_path(collection), class: "collection-chip", data: { turbo_frame: "_top" } do %>
          <%= icon("hash", style: ("color: #{colour(collection.colour)};" if collection.colour.present?)) %>
          <span><%= collection.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= link_to new_collection_path, class: "button utilities--mx-auto", data: { turbo_frame: "_top", intent: "primary", radius: "full", size: "lg" } do %>
    <%= icon("plus") %> New collection
  <% end %>
</main>
