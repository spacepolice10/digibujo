<%# locals: (bullet:, selected_date: nil) %>
<turbo-frame id="<%= dom_id(bullet) %>"
             class="bullet"
             data-bullet-type="<%= bullet.bulletable_type.downcase %>"
             <% if bullet.bulletable_type == "Note" && bullet.bulletable.mood.present? %>
             data-note-mood="<%= bullet.bulletable.mood %>"
             <% end %>
             <% if bullet.completed? %>
             data-bullet-completed
             <% end %>>
  <div class="bullet--marker-slot">
    <%= render "bullets/marker", bullet: bullet %>
    <%= render "bullets/bulk_menu_select", bullet: bullet %>
  </div>
  <div class="bullet--body">
    <% unless bullet.bulletable_type == "Voice" && bullet.bulletable.recording.attached? %>
      <%= bullet.body %>
    <% end %>
    <%= render "voices/playback_for_bullet", bullet: bullet %>
    <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
  </div>
</turbo-frame>
