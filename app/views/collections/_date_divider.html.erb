<%# locals: (date:) %>
<div class="collection--date-divider" role="separator" aria-label="<%= relative_day_label(date) %>">
  <%= link_to daylog_path(date: date.iso8601),
        class: "collection--date-pill",
        data: { turbo_frame: "_top" } do %>
    <time datetime="<%= date.iso8601 %>"><%= relative_day_label(date) %></time>
  <% end %>
</div>
