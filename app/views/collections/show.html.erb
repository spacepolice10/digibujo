<% content_for(:title) { @collection.name } %>

<div class="layout--page">
  <div class="layout--header-actions">
    <%= link_to home_path, class: "button--secondary" do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-left)"
        aria-hidden="true"
      ></i>
      Back
    <% end %>

    <%= render "buckets/pins_button", bucket: @collection.bucket %>

    <%= link_to collection_export_path(@collection),
          class: "button--secondary",
          data: { turbo: false } do %>
      <i class="icon" style="--icon-mask: var(--icon-file)" aria-hidden="true"></i>
      Export
    <% end %>
  </div>

  <div class="layout--surface bucket--list" data-controller="bulk-menu">
    <div class="layout--header-content">
      <h2 class="layout--surface-name"><%= @collection.name %></h2>

      <% if @collection.bucket.description.present? %>
        <p class="layout--header-description utilities--text-sm">
          <%= @collection.bucket.description %>
        </p>
      <% end %>

      <div class="collection--create-bullet">
        <%= link_to new_bullet_path(bulletable_type: "Note", bucket_id: @collection.bucket.id, return_to: collection_path(@collection)),
        class: "button--tertiary",
        aria: { label: "Add note" } do %>
          <i
            class="icon"
            style="--icon-mask: var(--icon-plus)"
            aria-hidden="true"
          ></i>

          <p>Add note</p>
        <% end %>
      </div>
    </div>

    <div class="layout--surface">
      <div id="<%= dom_id(@collection, :bullets_container) %>" data-bulk-menu-target="list">
        <% if @bullets.any? %>
          <%= render "pagination/paginated_records",
              page: @page,
              pagination_link_path: ->(next_param) { collection_path(@collection, page: next_param) } %>
        <% else %>
          <p>No bullets yet. Pop a bullet to get started.</p>
        <% end %>
      </div>

    </div>

    <%= render "bullets/bulk_menu" %>
  </div>
</div>
