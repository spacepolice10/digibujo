<% content_for(:title) { @collection.name } %>

<div class="layout--page">
  <div class="layout--header-info">
    <%= image_tag @collection.bucket.icon_path, class: "icon", alt: "" %>

      <h2><%= @collection.name %></h2>
      <% if @collection.bucket.description.present? %>
        <p><%= @collection.bucket.description %></p>
      <% end %>

  </div>
  <div class="layout--header-actions">
    <%= link_to home_path, class: "button--secondary" do %>
      <i
        class="icon"
        style="--icon-mask: var(--icon-arrow-left)"
        aria-hidden="true"
      ></i>
      Back
    <% end %>

    <%= render "buckets/pins_button", bucket: @collection.bucket %>

    <%= link_to collection_export_path(@collection),
          class: "button--secondary",
          data: { turbo: false } do %>
      <i class="icon" style="--icon-mask: var(--icon-file)" aria-hidden="true"></i>
      Export
    <% end %>
  </div>

  <div class="layout--surface bucket--list">
    <div class="layout--header-content">
      <%= render "bullets/composer/dock", bucket: @collection.bucket, selected_date: nil, composer_id: dom_id(@collection, :bullets_composer) %>

      <div class="layout--surface">
        <div
          data-bulk-menu-target="list"
        >
          <% if @bullets.any? %>
            <%= render layout: "pagination/paginated_list",
                  locals: {
                    page: @page,
                    container_id: dom_id(@collection, :bullets_container),
                    pagination_link_path: ->(next_param) { collection_path(@collection, page: next_param) }
                  } do %>
              <% @page.records.each do |bullet| %>
                <%= render bullet %>
              <% end %>
            <% end %>
          <% else %>
            <p>No bullets yet. Pop a bullet to get started.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if request.variant.include?(:mobile) %>
    <%= render "bullets/composer/dialog",
          id: dom_id(@collection, :composer),
          composer_id: dom_id(@collection, :bullets_composer) %>
  <% end %>
</div>
