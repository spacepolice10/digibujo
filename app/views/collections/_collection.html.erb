<li id="<%= dom_id(collection.bucket, :list_item) %>" class="layout--list-item">
  <%= link_to collection_path(collection), class: "bucket--list-item-link" do %>
    <div class="bucket--list-item-name">
      <div class="bucket--list-item-marker" data-bucket-colour="<%= collection.bucket.colour %>" aria-hidden="true">
        <% if collection.icon_path %>
          <%= image_tag collection.icon_path, alt: "", class: "form--list-icon" %>
        <% end %>
      </div>
      <span class="utilities--line-clamp-1"><%= collection.name %></span>
    </div>
    <div class="bucket--list-item-meta utilities--line-clamp-1">
      <span><%= collection.bullets.count %> <%= "bullet".pluralize(collection.bullets.count) %></span>,
      <span><%= collection.created_at.strftime("%b %d") %></span>
    </div>
  <% end %>
</li>
<% if collection.bundles.any? %>
  <% collection.bundles.each do |bundle| %>
    <li class="layout--list-item bucket--list-item-child">
      <%= link_to collection_bundle_path(collection, bundle),
            class: "bucket--list-item-link bucket--list-item-child-link",
            data: { bucket_colour: bundle.colour } do %>
        <div class="bucket--list-item-name">
          <span class="bucket--child-dot-inner" aria-hidden="true"></span>
          <span class="utilities--line-clamp-1"><%= bundle.name %></span>
        </div>
      <% end %>
    </li>
  <% end %>
<% end %>
