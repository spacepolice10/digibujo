<li id="<%= dom_id(collection.bucket, :list_item) %>" class="layout--list-item">
  <%= link_to collection_path(collection), class: "layout--list-item-link" do %>
    <%= icon_tag(collection.bucket.icon, colour: collection.bucket.colour_variable) %>
    <span class="utilities--line-clamp-1"><%= collection.name %></span>

    <span class="typography--paragraph-sm utilities--line-clamp-1">
      <%= collection.bullets.count %>
      <%= "bullet".pluralize(collection.bullets.count) %>,
      <%= collection.created_at.strftime("%b %d") %>
    </span>
  <% end %>
</li>
