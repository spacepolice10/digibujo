<% content_for(:title, "New collection") %>

<main data-size="sm">
  <article data-elevation="1">
    <header>
      <nav>
        <%= back_link_to @return_to.presence || collections_path,
            class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "sm", content: "icon" },
            aria: { label: "Back to Collections" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>

        <h2>New collection</h2>
      </nav>
    </header>

    <main>
      <div id="<%= dom_id(@collection) %>">
        <%= render "form", collection: @collection, bullet_ids: @bullet_ids, return_to: @return_to %>

        <% if @bullets.present? %>
          <section class="bucket--collect-preview">
            <h2 class="bucket--collect-preview-heading">
              <%= pluralize(@bullets.size, "bullet") %> will be added
            </h2>

            <ul class="bucket--collect-preview-list">
              <%= render partial: "collections/bullet_preview", collection: @bullets, as: :bullet %>
            </ul>
          </section>
        <% end %>
      </div>
    </main>
  </article>
</main>
