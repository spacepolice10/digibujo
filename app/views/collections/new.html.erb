<% content_for(:title) { "New collection" } %>


<div class="layout--page layout--container layout--container-md">
  <div class="utilities--mx-auto collection--header">
    <%= icon_tag("folder", style: "color: var(--color-text-base);", class: "collection--header-icon") %>
    <h2>New collection</h2>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded">Collections are like folders in a traditional notebook — group related tasks, notes, or events together and keep them organised for as long as you need</p>
  </div>
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <% if @bullet_ids.present? && @return_to.present? %>
        <%= link_to @return_to, class: "button--tertiary button--sm" do %>
          <%= icon_tag("arrow-left") %>
          Back
        <% end %>
      <% else %>
        <%= link_to home_path, class: "button--tertiary button--sm", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
          <%= icon_tag("arrow-left") %>
          Back
        <% end %>
      <% end %>
    </div>
  
  <div id="<%= dom_id(@collection) %>" class="layout--padded">

    <%= render "form",
          collection: @collection,
          bullet_ids: @bullet_ids,
          return_to: @return_to %>

    <% if @bullets.present? %>
      <section class="bucket--collect-preview">
        <h3 class="bucket--collect-preview-heading">
          <%= pluralize(@bullets.size, "bullet") %> will be added
        </h3>
        <ul class="bucket--collect-preview-list">
          <%= render partial: "collections/bullet_preview", collection: @bullets, as: :bullet %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
</div>
