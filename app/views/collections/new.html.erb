<% content_for(:title, "New collection") %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to @return_to.presence || collections_path,
            class: "button", data: { content: "text", turbo_frame: "_top" }, aria: { label: "Back" } do %>
        <%= icon_tag("arrow-left") %><span>Collections</span>
      <% end %>
      <h1>New collection</h1>
    </header>

    <% unless @bullets.present? %>
      <p class="typography--paragraph-sm typography--balanced">
        Collections are like folders in a traditional notebook — group related bullets and keep them organised for as long as you need.
      </p>
    <% end %>

    <div id="<%= dom_id(@collection) %>">
      <%= render "form", collection: @collection, bullet_ids: @bullet_ids, return_to: @return_to %>

      <% if @bullets.present? %>
        <section class="bucket--collect-preview">
          <h2 class="bucket--collect-preview-heading"><%= pluralize(@bullets.size, "bullet") %> will be added</h2>
          <ul class="bucket--collect-preview-list">
            <%= render partial: "collections/bullet_preview", collection: @bullets, as: :bullet %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
</main>
