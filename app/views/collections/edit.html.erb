<% content_for(:title) { "Edit collection" } %>

<div class="layout--container" data-size="md">
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-invert-2);") %>
        Back
      <% end %>
      <div class="button--secondary button--sm">
        <%= icon_tag("folder") %>
        Edit collection
      </div>
    </div>
    <div id="<%= dom_id(@collection) %>" class="layout--padded">
        <%= render "form", collection: @collection %>
    </div>
</div>
</div>
