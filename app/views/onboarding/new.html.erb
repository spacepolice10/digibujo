<% content_for(:title) { "Welcome" } %>

<div class="onboarding-carousel"
     data-controller="onboarding"
     data-action="keydown.arrow_right@document->onboarding#next keydown.arrow_left@document->onboarding#previous">
  <section class="onboarding-section" data-onboarding-target="section">
    <main class="onboarding--content">
      <h1 class="onboarding--heading">Welcome to Digibujo</h1>
      <br>
<ul class="onboarding--basics">
      <li class="onboarding--basics-item">
        <p>Let's take a quick tour of the app, so you feel more comfortable with it.</p>
      </li>
      <nav class="onboarding--actions">
        <button type="button" class="button typography--bold" data-intent="primary" data-radius="full" data-size="sm" data-action="onboarding#next">Swipe to start a quick tour

          <%= icon_tag("arrow-right") %>
        </button>
      </nav>
    </ul>
</main>


    <% if @onboarding.errors.any? %>
      <div class="form--errors" role="alert">
        <ul>
          <% @onboarding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <main class="onboarding--content">
    <h2 class="onboarding--heading">Follow the rapid logging nature</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item">
        <p>Use the chat composer at the bottom of your timeline. Just start typing. <span class="hotkey-hint hotkey-hint--key">⎋ Escape</span> cancels, <span class="hotkey-hint hotkey-hint--key">↵ Enter</span>  sends.
        Capture fast, organize later. This is the key principle of bullet journal.</p>
      </li>

      <li class="onboarding--basics-item">
        <span class="onboarding--basics-tips">Even though bullet journal is about short notes, you can use the whole power of the text editor to write longer notes and save files.</span>
      </li>
      </ul>
    </main>

  </section>


  <section class="onboarding-section" data-onboarding-target="section">
    <main class="onboarding--content">
    <h2 class="onboarding--heading">Plan ahead with Upcoming</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item">
        <p>Schedule a bullet for a later day and it steps out of the way. It waits on the Upcoming screen and joins your timeline when its day comes.</p>
      </li>
      <li class="onboarding--basics-item">
        <span class="onboarding--basics-tips">Pick tomorrow, next week, or any date from the Later button in the bulk menu.</span>
      </li>
    </ul>
    </main>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <main class="onboarding--content">
    <h2 class="onboarding--heading">Move things along. By yourself</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item">
        <p>Older bullets settle into weekly and monthly sections of the timeline. Reschedule or collect the ones that still matter, and let the rest fade into the past.</p>
      </li>
      <li class="onboarding--basics-item">
        <span class="onboarding--basics-tips">Moving bullets manually is an important part of the bullet journal methodology. Intention forcing things to be done, not staying stuck in the planning phase.</span>
      </li>
    </ul>
    </main>
  </section>


  <section class="onboarding-section last-section" data-onboarding-target="section">
    <main class="onboarding--content">
    <h2 class="onboarding--heading">Explore Digibujo</h2>
    <br>
    <article class="onboarding--choice" data-elevation="1">
      <main>
      <%= form_with url: onboarding_path, class: "onboarding-form", data: { onboarding_target: "form" } do |form| %>
      <div>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-2);">
          <%= form.radio_button :data_seed, true, class: "utilities--sr-only", include_hidden: false, checked: true %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
          <strong>Add sample data</strong>

            <p> We can add some bullets and collections to make it look more natural.</p>
          </div>

        </label>
        <br>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-2);">
          <%= form.radio_button :data_seed, false, class: "utilities--sr-only", include_hidden: false %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
            <strong>Start with an empty journal</strong>
            <p> If you prefer to start clean.</p>
          </div>
        </label>
      </div>
      <br>
      <p> If you wish, we can add sample data to your journal, so you understand how it works and structure your journal. Everything can be deleted later.</p>
      <br>
      <div class="onboarding--actions">
        <%= form.button "Start my journal", class: "button typography--bold",
              data: { intent: "primary", radius: "full", size: "sm" } %>
      </div>
      <% end %>
      </main>
    </article>

    <br>
    <nav class="onboarding--about" aria-label="About">
      <%= link_to features_path, class: "session--footer-link" do %>
        <%= icon_tag("list", class: "session--footer-icon") %>
        Features
      <% end %>
      <%= link_to support_path, class: "session--footer-link" do %>
        <%= icon_tag("mail", class: "session--footer-icon") %>
        Support
      <% end %>
    </nav>
    </main>
  </section>
  <br>

  <footer class="onboarding-footer">
    <ol class="onboarding-dots"
        data-onboarding-target="dots"
        data-action="click->onboarding#jumpToDot">
      <% 5.times do |i| %>
        <li data-index="<%= i %>"></li>
      <% end %>
    </ol>
    <br>
  </footer>
</div>
