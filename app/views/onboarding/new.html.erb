<% content_for(:title) { "Welcome" } %>

<div class="session--page onboarding-carousel"
     data-controller="onboarding"
     data-action="keydown.arrow_right@document->onboarding#next keydown.arrow_left@document->onboarding#previous">
  <section class="onboarding-section session--welcome" data-onboarding-target="section">
    <h1 class="session--name">Welcome to Digibujo</h1>
    <p class="typography--paragraph-md typography--center typography--balanced">
      You're signed in as <strong><%= @onboarding.user.email_address %></strong>.
      <p>
      Let's take a quick tour of the app, so you feel more comfortable with it.
      </p>
    </p>
    <button type="button" class="button--primary" data-action="onboarding#next">Continue</button>


    <% if @onboarding.errors.any? %>
      <div class="form--errors" role="alert">
        <ul>
          <% @onboarding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center">Create bullets in Daylog</h2>
    <br>
    <ul class="onboarding--basics layout--list layout--surface layout--padded layout--list-grid">
      <li>
        <strong>Chat composer</strong>
        <span>At the bottom of Daylog just start typing. Escape cancels, Enter sends.</span>
      </li>
      <div class="onboarding-demo layout--surface layout--padded" aria-hidden="true">
        <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
          <span class="onboarding-demo-marker"><%= icon_tag("square") %></span>
          <span class="onboarding-demo-text">Buy groceries</span>
          <span class="onboarding-demo-time">09:12</span>
        </div>
        <div class="onboarding-demo-bullet onboarding-demo-bullet--new">
          <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
          <span class="onboarding-demo-text">Ideas for the weekend hike</span>
          <span class="onboarding-demo-time">09:13</span>
        </div>
        <div class="onboarding-demo-composer">
          <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
          <span class="onboarding-demo-typing">Ideas for the weekend hike</span>
        </div>

      </div>
      <li>
        <strong>Rapid logging</strong>
        <span>Capture fast, organize later. This is the key principle of bullet journal.</span>
        <span class="onboarding--hint">Even though bullet journal is about short notes, you can use the whole power of the text editor to write longer notes and save files.</span>
      </li>
      </ul>

    </div>
    <button type="button" class="button--primary" data-action="onboarding#next">Next
      <%= icon_tag("arrow-right", class: "button--icon") %>
    </button>
  </section>


  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center">Monthlylog</h2>
    <br>
    <ul class="onboarding--basics layout--list layout--surface layout--padded layout--list-grid">
      <li>
        <strong>Optional monthly spread</strong>
        <span>Bulelt journal allows to plan ahead using special monthly spread — separate bucket for your bullets.</span>
        <span class="typography--paragraph-sm">Digibujo supports this too making it possible to make some drafts for a future use</span>
      </li>
      <li>
        <strong>Migrate as needed</strong>
        <span>When time comes you can migrate your bullets from the monthly spread to the daylog making them your priority.</span>
        <span>Read more about this concept on the official Bullet Journal website.</span>
      </li>
    </ul>
    </div>
    <button type="button" class="button--primary" data-action="onboarding#next">Next
      <%= icon_tag("arrow-right", class: "button--icon") %>
    </button>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center">Bulk actions</h2>
    <br>
    <ul class="onboarding--basics layout--list layout--surface layout--padded layout--list-grid">
      <li>
        <strong>The single menu to handle all your bullets</strong>
        <span>All the manipulations around your notes, tasks and events start from selecting one via circle on the left side of the bullet</span>
      </li>
      <li>
        <strong>One bar, many intents</strong>
        <span>Later (postpone), Save (collect), Pin, Archive, Complete — applied to everything selected.</span>
      </li>

    </ul>
    </div>
    <button type="button" class="button--primary" data-action="onboarding#next">Next
      <%= icon_tag("arrow-right", class: "button--icon") %>
    </button>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container layout--container-md layout--padded">
    <h2 class="typography--h1 typography--center">Explore Digibujo</h2>
    <br>
    <nav class="layout--padded layout--surface layout--container layout--container-sm">
      <%= form_with url: onboarding_path, class: "onboarding-form", data: { onboarding_target: "form" } do |form| %>
      <div>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-4);">
          <%= form.radio_button :data_seed, true, class: "utilities--sr-only", include_hidden: false %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
          <strong>Add sample data</strong>

            <p class="typography--paragraph-sm"> We can add some notes, tasks and events to make it look more natural.</p>
          </div>

        </label>
        <br>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-4);">
          <%= form.radio_button :data_seed, false, class: "utilities--sr-only", include_hidden: false, checked: true %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
            <strong>Start with an empty journal</strong>
            <p class="typography--paragraph-sm"> If you prefer to start clean.</p>
          </div>
        </label>
      </div>
      <br>
      <small class="typography--paragraph-sm"> If you wish, we can add sample data to your journal, so you understand how it works and structure your journal. Everything can be deleted later.</small>
      <br>
      <%= form.button "Start my journal", class: "button--primary button--wide" %>
      <% end %>
    </nav>

    <br>
    <nav class="session--footer layout--padded layout--surface layout--container layout--container-sm" aria-label="About">
      <%= link_to features_path, class: "session--footer-link" do %>
        <%= icon_tag("list", class: "session--footer-icon") %>
        Features
      <% end %>
      <%= link_to support_path, class: "session--footer-link" do %>
        <%= icon_tag("mail", class: "session--footer-icon") %>
        Support
      <% end %>
    </nav>
    </div>
  </section>

  <footer class="onboarding-footer">
    <ol class="onboarding-dots"
        data-onboarding-target="dots"
        data-action="click->onboarding#jumpToDot">
      <% 5.times do |i| %>
        <li data-index="<%= i %>"></li>
      <% end %>
    </ol>
    <br>
    <div class="session--footer" data-onboarding-target="skip">
      <button type="button" class="button--secondary button--sm" data-action="onboarding#jumpToLast">Skip</button>
    </div>

  </footer>
</div>
