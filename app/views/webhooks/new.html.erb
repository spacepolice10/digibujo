<% content_for(:title, "New webhook") %>

<%= render "shared/back_tabbar", url: webhooks_path, aria_label: "Back to Webhooks" %>

<main data-size="sm">
  <header>
    <h1>Webhook</h1>

    <p>
      Give a name to the integration, then share the URL Dotted gives you.
    </p>
  </header>

  <%= form_with model: @webhook, url: webhooks_path, html: { class: "form" } do |form| %>
    <label>
      <small>Name</small>
      <%= form.text_field :name, required: true, placeholder: "Zapier, Gmail, etc." %>

      <% if @webhook.errors[:name].any? %>
        <small class="form--errors"><%= @webhook.errors.full_messages_for(:name).to_sentence %></small>
      <% end %>
    </label>

    <%= form.button type: "submit", data: { intent: "primary", radius: "full", size: "sm" }, class: "utilities--mx-auto" do %>
      <%= icon("plus") %> Create webhook
    <% end %>
  <% end %>
</main>
