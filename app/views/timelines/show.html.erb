<% content_for(:title, "Timeline") %>

<main class="chat--window" data-size="md">
  <article class="chat--surface" data-elevation="1">
    <main
      id="timeline"
      class="chat--scroller"
      data-controller="chat-scroll"
      data-chat-scroll-path-value="<%= timeline_bullets_path %>"
      data-bulk-menu-target="list"
    >
      <% if @more_bullets %>
        <div class="chat--load-more-trigger" data-chat-scroll-target="trigger">
          <%= icon_tag("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <%= render "timelines/sections", bullets: @bullets, timeline: @timeline, ensure_today: true %>
    </main>
  </article>

  <br>

  <div
    id="timeline_composer_dock"
    class="chat--composer composer--dock timeline--composer"
    data-controller="chat-composer"
  >
    <%= render "bullets/composer_v2",
          bullet: Bullet.new,
          pops_on: Date.current,
          preset: "default",
          autofocus: false %>
  </div>
</main>
