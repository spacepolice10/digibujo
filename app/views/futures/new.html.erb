<% content_for(:title) { "New future log" } %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
        <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" }, aria: { label: "Back to Home" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>

        <h1>New future log</h1>
      </nav>
    </header>

    <main>
      <p>Future logs are like a time machine — capture your dreams, goals, and aspirations for the future, and revisit them whenever you need a reminder of what's important to you.</p>

      <%= render "form", future: @future %>
    </main>
  </article>
</main>
