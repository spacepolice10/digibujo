<% content_for(:title) { "Future Log" } %>

<div class="layout--page future--page" data-controller="bulk-menu">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Home
      <% end %>
    </div>
    <h2><%= @future.name %></h2>
  </div>

  <div class="future--grid" data-bulk-menu-target="list">
    <% @children.each do |monthly_bucket| %>
      <% bucket = monthly_bucket.bucket %>
      <div class="future--card">
        <div class="future--card-header">
          <%= link_to monthly_bucket.name, future_monthly_bucket_path(monthly_bucket) %>
        </div>
        <div id="<%= dom_id(bucket, :unplanned) %>">
          <% unplanned = monthly_bucket.bullets.where(pops_on: nil).chronological.includes(:bucketable) %>
          <%= render partial: "bullets/bullet", collection: unplanned, as: :bullet %>
        </div>
        <%= link_to new_bullet_path(
              bucket_id: bucket.id,
              composer_id: "bullet_composer"
            ),
            data: { turbo_frame: "bullet_composer" },
            class: "button--tertiary button--icon",
            aria: { label: "Add bullet" } do %>
          <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
        <% end %>
      </div>
    <% end %>

    <div class="future--add-month">
      <%= button_to "+ Add month", months_future_path, method: :post, class: "button--primary" %>
    </div>
  </div>

  <turbo-frame id="bullet_composer">
    <%= render "bullets/composer", attributes: { composer_id: "bullet_composer" } %>
  </turbo-frame>

  <%= render "bullets/bulk_menu" %>
</div>