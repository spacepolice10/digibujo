<% content_for(:title) { @future.name } %>

<div class="layout--page future">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Home
      <% end %>

      <%= render "buckets/pins_button", bucket: @future.bucket %>
    </div>

    <h2><%= @future.name %></h2>
  </div>

  <%= render "futures/months_grid",
        months: @months,
        bullets_by_date: @bullets_by_date,
        future: @future %>

  <section class="future--unplanned" aria-label="Unplanned">
    <header class="future--unplanned-header">
      <h3 class="future--unplanned-title">Unplanned</h3>
      <p class="future--unplanned-description utilities--text-sm">
        Dump year goals, long-term thoughts, and potential projects here.
      </p>
    </header>

    <div
      class="future--unplanned-entries"
      data-controller="pops-drop drop-postpone-optimistic"
      data-pops-drop-pops-url-value="<%= postpone_path %>"
      data-pops-drop-bucket-id-value="<%= @future.bucket.id %>"
      data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
      data-bulk-menu-target="list"
    >
      <div id="future_bullets_unplanned_container">
        <% @unplanned_bullets.each do |bullet| %>
          <%= render "futures/bullets/bullet", bullet: bullet %>
        <% end %>
      </div>

      <%= link_to new_bullet_path(bucket_id: @future.bucket.id, bulletable_type: "Note"), class: "bullets-form--create-button", data: { turbo_frame: "future_bullets_unplanned_composer" }, aria: { label: "Add Note" } do %>
        <i class="icon" style="--icon-mask: var(--icon-plus)" aria-hidden="true"></i>
        Add bullet
      <% end %>
    </div>
  </section>

  <%= render "futures/composer_dialog", future: @future, months: @months %>
</div>
