<%# locals: (future:, months:) %>
<%= render "shared/dialog",
      id: "future_composer",
      close_on_submit: false,
      standalone: true,
      class_name: "dialog--large bullet-composer--dialog",
      actions: [
        "close->dialog#clearFrame",
        "composer:restore->dialog#close",
        "turbo:before-frame-render->dialog#openOnFrame"
      ] do %>
  <% months.each do |month_start| %>
    <turbo-frame id="future_bullets_<%= month_start.iso8601 %>_composer"></turbo-frame>
  <% end %>
  <turbo-frame id="future_bullets_unplanned_composer"></turbo-frame>
<% end %>
