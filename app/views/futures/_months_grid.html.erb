<%# locals: (months:, bullets_by_date:, future:) %>
<div class="future--grid" data-bulk-menu-target="list">
  <% months.each do |month_start| %>
    <% month_bullets = bullets_by_date[month_start] || [] %>
    <% composer_id = "future_bullets_#{month_start.iso8601}_composer" %>
    <% container_id = "future_bullets_#{month_start.iso8601}_container" %>

    <div class="future--card">
      <div class="future--card-header">
        <%= month_start.strftime("%b %Y") %>
      </div>

      <div
        class="future--card-content"
        data-controller="pops-drop drop-postpone-optimistic"
        data-pops-drop-pops-url-value="<%= postpone_path %>"
        data-pops-drop-pops-on-value="<%= month_start.iso8601 %>"
        data-pops-drop-bucket-id-value="<%= future.bucket.id %>"
        data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
      >
        <div id="<%= container_id %>">
          <% month_bullets.first(6).each do |bullet| %>
            <%= render "futures/bullets/bullet", bullet: bullet %>
          <% end %>
        </div>

        <%= link_to new_bullet_path(
              bucket_id: future.bucket.id,
              pops_on: month_start.iso8601,
              bulletable_type: "Note"
            ),
              class: "bullets-form--create-button",
              data: { turbo_frame: composer_id },
              aria: { label: "Add Note" } do %>
          <i class="icon" style="--icon-mask: var(--icon-text)" aria-hidden="true"></i>
          Note
        <% end %>
      </div>
    </div>
  <% end %>
</div>
