<% content_for(:title) { "Dotted" } %>
<main class="landing">
  <header class="landing-header">
    <a role="button" data-intent="secondary" data-size="lg" href="<%= root_path %>">
      <%= image_tag "/icon.svg", class: "landing-logo", alt: "" %>
      Dotted
    </a>

    <div class="landing-menu">
      <input type="checkbox" id="landing-menu-toggle" class="landing-menu-toggle" aria-label="Menu">
      <label for="landing-menu-toggle" class="landing-menu-label">
        Menu <%= icon("chevron-down", class: "landing-menu-chevron") %>
      </label>

      <nav aria-label="Product">
        <a role="button" data-intent="secondary" data-size="lg" href="<%= features_path %>">Features</a>
        <a role="button" data-intent="secondary" data-size="lg" href="<%= new_authentication_path %>">
          <span class="icon-wrap once-mark"><i class="icon" aria-hidden="true"></i></span>
          ONCE
        </a>
        <a role="button" data-intent="secondary" data-size="lg" href="<%= new_authentication_path %>">Sign in</a>
        <a role="button" data-intent="secondary" data-size="lg" href="<%= new_authentication_path %>">
          <%= icon("github") %> GitHub
        </a>
      </nav>
    </div>
  </header>

  <section class="landing-hero">
    <h1 class="landing-title">
      <span class="landing-title-dot"> . </span> dotted
    </h1>

    <p class="landing-tagline">
      A digital bullet journal implementation, personalized, open &amp;
      beautiful.
    </p>

    <div class="landing-cta-row">
      <a data-intent="accent" data-size="lg" href="<%= new_authentication_path %>">
        Try it!
      </a>
    </div>
  </section>

  <section id="pile" class="landing-pile">
    <p class="pile-kicker">What you can do with Dotted</p>

    <ul class="landing-bits">
      <li>
        <%= icon("lightbulb", class: "feature-icon") %>
        Catch an <span class="decoration--underline-wavy decoration-colour--sky">idea</span> before it disappears.
      </li>

      <li>
        <%= icon("calendar", class: "feature-icon") %>
        One <span class="decoration--wash decoration-colour--sky">daylog</span> for everything on your mind.
      </li>

      <li>
        <%= icon("folder", class: "feature-icon") %>
        Save what matters into <span class="decoration--wash decoration-colour--pear">colourful collections</span>.
      </li>

      <li>
        <%= icon("calendar-repeat", class: "feature-icon") %>
        Move a task to <span class="decoration--circle decoration-colour--pear">tomorrow</span> without rewriting it.
      </li>

      <li>
        <%= icon("search", class: "feature-icon") %>
        Find a thought in seconds with <span class="decoration--underline-double decoration-colour--lilac">Cmd/Ctrl+K</span>.
      </li>

      <li>
        <%= icon("paperclip", class: "feature-icon") %>
        Drop <span class="decoration--wash decoration-colour--ink">text or files</span> into the same quick composer.
      </li>

      <li>
        <%= icon("text", class: "feature-icon") %>
        Stay in flow: <span class="decoration--wash decoration-colour--ink">write, move, and finish</span> from the keyboard.
      </li>

      <li>
        <%= icon("link", class: "feature-icon") %>
        Share a single bullet with a <span class="decoration--underline-dotted decoration-colour--pear">link anyone can open</span>.
      </li>

      <li>
        <%= icon("webhook", class: "feature-icon") %>
        Drop new bullets into your daylog from <span class="decoration--wash decoration-colour--flame">Zapier or scripts</span> with webhooks.
      </li>

      <li>
        <%= icon("code", class: "feature-icon") %>
        Go beyond capture with the <span class="decoration--circle-box decoration-colour--lilac">CLI</span>: read, create, and edit bullets.
      </li>

      <li>
        <%= icon("home", class: "feature-icon") %>
        <span class="decoration--wash decoration-colour--mint">Keep your journal</span> on your <span class="decoration--circle-scribble decoration-colour--pear">own server</span>.
      </li>

      <li>
        <%= icon("heart", class: "feature-icon") %>
        Built with <span class="decoration--wash decoration-colour--blossom">love</span> using Rails and Hotwire.
      </li>
    </ul>

    <br>
    <a data-intent="accent" data-size="lg" href="<%= new_authentication_path %>">
      Try it!
    </a>
  </section>
</main>
