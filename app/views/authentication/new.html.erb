<% content_for(:title) { "Continue" } %>

<div class="session--page">
  <div class="form--surface">
    <%= render "authentication/flash" %>

    <%= form_with url: authentication_path, class: "form form--strong" do |form| %>
      <div class="session--intro">
        <h1 class="session--title">Continue with email</h1>
        <p class="form-hint session--description">Enter your email and we'll send you a one-time code to sign in or create an account.</p>
      </div>

      <% if @user&.errors&.any? %>
        <div class="form--errors" role="alert">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.email_field :email_address,
              class: "form-input",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              aria: { label: "Email" },
              value: params[:email_address] %>
      </div>

      <%= render "authentication/submit_button", form: form, label: "Continue" %>
    <% end %>
  </div>

  <nav class="session--footer-links" aria-label="About">
    <%= link_to features_path, class: "session--footer-link" do %>
      <i class="icon" style="--icon-mask: var(--icon-list)" aria-hidden="true"></i>
      Features
    <% end %>
    <%= link_to support_path, class: "session--footer-link" do %>
      <i class="icon" style="--icon-mask: var(--icon-mail)" aria-hidden="true"></i>
      Support
    <% end %>
  </nav>
</div>
