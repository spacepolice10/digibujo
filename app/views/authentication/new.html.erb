<% content_for(:title) { "Continue" } %>

<div class="session--page">
  <div class="form--surface">
    <%= render "authentication/flash" %>

    <%= form_with url: authentication_path,
          class: "form form--strong",
          data: {
            controller: "form-submit",
            form_submit_loading_text_value: "Sending code…",
            action: "turbo:submit-start->form-submit#start turbo:submit-end->form-submit#end"
          } do |form| %>
      <div class="session--intro">
        <h1 class="session--title">Continue with email</h1>
        <p class="form-hint session--description">Enter your email and we'll send you a one-time code to sign in or create an account.</p>
      </div>

      <% if @signup.errors.any? %>
        <div class="form--errors" role="alert">
          <ul>
            <% @signup.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.email_field :email_address,
              class: "form-input",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              aria: { label: "Email" },
              value: params[:email_address] %>
      </div>

      <%= render "authentication/submit_button", form: form, label: "Continue" %>
    <% end %>
  </div>
</div>
