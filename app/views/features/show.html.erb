<% content_for(:title) { "Features — Dotted" } %>

<% features = [
  {
    title: "Rapid logging",
    description: "A chat-style dock at the bottom of your timeline: type the thought, or attach a file. No nested “create inside X” maze."
  },
  {
    title: "Two bullets, one flow",
    description: "Text and attachments share one composer, and every bullet can be checked off when it is done."
  },
  {
    title: "One infinite daylog",
    description: "Everything you write lands in a single feed. Recent days are their own sections; older ones settle into Last week, Last month, and beyond."
  },
  {
    title: "Upcoming",
    description: "Schedule a bullet for a later day and it waits on the Upcoming screen, then joins your daylog when its day comes."
  },
  {
    title: "Capture, then curate",
    description: "Brain-dump first, organise later. The daylog and collections keep the noise navigable without slowing you down."
  },
  {
    title: "Move, don’t rewrite",
    description: "Later, Save, Complete — move bullets instead of rewriting them, all from one selection menu."
  },
  {
    title: "Keyboard-first",
    description: "Every common intent — compose, navigate, pop, collect, complete — has a hotkey, with hints surfaced inline."
  },
  {
    title: "Postpone without guilt",
    description: "Push a bullet to tomorrow — or any day — and keep going. Decisions deferred, not lost."
  },
  {
    title: "Collections as notebooks",
    description: "Named, coloured, icon’d collections. Save bullets from the daylog, then export a collection as HTML when you want it out."
  },
  {
    title: "Complete it, browse later",
    description: "Mark bullets done, browse them in Completed when you need them, and let retention clean expired items after about thirty days."
  },
  {
    title: "Quick search",
    description: "Press Cmd/Ctrl + K to find bullets and collections fast without leaving the keyboard."
  },
  {
    title: "Publish what you want",
    description: "Publish individual bullets to share them on the internet. Each one gets a short code and a clean public view — no login to read."
  },
  {
    title: "Appearance that stays quiet",
    description: "Home tint themes — default, warm, cool, nature, cheese. Atmosphere without a settings rabbit hole."
  },
  {
    title: "Outlining",
    description: "Like TaskPaper — but no special headers. Any bullet can outline others: just indent and the tree builds itself. Navigate it with the keyboard, fold the noise away, focus on one branch."
  },
  {
    title: "CLI &amp; agent integration",
    description: "Drive Dotted from a terminal or from an AI agent. The same bullets and collections — programmable from outside the browser."
  },
  {
    title: "Hooks",
    description: "Drop bullets onto your daylog from Zapier, agents, or your own scripts — one URL per integration."
  },
  {
    title: "Self-host, open source",
    description: "Ready for self-deployment with Kamal. Your data stays in your own SQLite databases — no Redis, no telemetry. Self-host freely under the O’Saasy license."
  },
  {
    title: "Crafted with love",
    description: "Built on Rails 8 and Hotwire, SQLite and Solid Queue under the hood, Kamal to ship it."
  },
] %>

<main>
  <section>
    <% features.each do |feature| %>
      <li>
        <article data-elevation="1">
          <header>
            <h2><%= feature[:title] %></h2>
          </header>

          <main>
            <p><%= feature[:description] %></p>
          </main>
        </article>
      </li>
    <% end %>
  </section>

  <footer>
    <%= link_to new_authentication_path,
        class: "utilities--mx-auto",
        data: { intent: "primary", radius: "full", size: "lg" },
        aria: { label: "Create your own account" } do %>
      Create your own
    <% end %>
  </footer>
</main>
