<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Digibujo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
    <meta name="application-name" content="Digibujo">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/toasts_host" %>

    <div class="session-layout">
      <header class="session-layout--header">
        <img src="/icon.svg" alt="Digibujo" class="public-logo">
      </header>
      <main class="session-layout--main <%= content_for(:main_class) %>">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
