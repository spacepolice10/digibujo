<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Digibujo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Digibujo">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@200;400;800&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="dialog timezone-cookie">
<div id="toasts" class="toasts" data-controller="toasts" aria-live="polite"></div>
    <% unless request.variant.include?(:mobile) %>
      <%= render "shared/header" %>
    <% end %>
    <%= yield %>
    <% if request.variant.include?(:mobile) %>
      <%= render "shared/mobile_tab_bar" %>
    <% end %>
    <%= render "shared/footer" %>
    <%= render "shared/dialog", data_action: "turbo:submit-end->dialog#submitEnd" do %>
      <%= turbo_frame_tag "modal" %>
    <% end %>
  </body>
</html>
