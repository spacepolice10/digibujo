<% content_for(:title, "Access codes") %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to user_path,
            class: "button",
            data: { content: "text", turbo_frame: "_top" },
            aria: { label: "Back to Account" } do %>
        <%= icon_tag("arrow-left") %>
        <span>Account</span>
      <% end %>
      <h1>Access codes</h1>
    </header>

    <p class="typography--paragraph-sm typography--balanced">
      Long-lived codes for CLI and integrations. Create them via the API; revoke any code you no longer trust here.
    </p>

    <% if @access_codes.any? %>
      <div id="access_codes" class="layout--flex" data-direction="column">
        <%= render partial: "access_codes/access_code", collection: @access_codes, as: :access_code %>
      </div>
    <% else %>
      <p id="access_codes_empty" class="typography--paragraph-sm">No access codes yet.</p>
    <% end %>
  </div>
</main>
