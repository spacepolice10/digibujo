<% content_for(:title, "Access codes") %>

<%= render "shared/back_tabbar" %>

<main data-size="sm">
  <header>
    <h1>Access codes</h1>

    <p>
      Long-lived codes for CLI and integrations. Create them via the API; revoke
      any code you no longer trust here.
    </p>
  </header>

  <% if @access_codes.any? %>
    <section id="access_codes" class="card-list">
      <%= render partial: "access_codes/access_code", collection: @access_codes, as: :access_code %>
    </section>
  <% else %>
    <%= render "shared/empty_state", icon_name: "code", name: "No access codes", description: "Codes you create through the API will appear here." %>
  <% end %>
</main>
