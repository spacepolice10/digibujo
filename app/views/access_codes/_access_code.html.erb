<%# locals: (access_code:) %>
<article
  id="<%= dom_id(access_code) %>"
  class="access-code--item"
  data-elevation="2"
>
  <main>
    <div>
      <code><%= access_code.code_prefix %>…</code>
      <% if access_code.description.present? %>
        <span><%= access_code.description %></span>
      <% end %>
    </div>
    <small><%= l(access_code.created_at.to_date, format: :long) %></small>
  </main>

  <footer>
  <%= button_to access_code_path(access_code),
        method: :delete,
        data: { intent: "secondary", radius: "full", size: "xs", status: "negative" },
        form: { data: { turbo_confirm: "Revoke this access code? Anything using it will stop working." } } do %>
    <%= icon("trash") %>
    <span>Revoke</span>
  <% end %>
  </footer>
</article>
