<%# locals: (access_code:) %>
<article id="<%= dom_id(access_code) %>" data-elevation="1">
  <main>
    <code><%= access_code.code_prefix %>…</code>

    <% if access_code.description.present? %>
      <span><%= access_code.description %></span>
    <% end %>
  </main>

  <footer>
    <%= button_to access_code_path(access_code),
        method: :delete,
        data: { intent: "secondary", radius: "full", size: "sm", status: "negative" },
        form: { data: { turbo_confirm: "Revoke this access code? Anything using it will stop working." }, class: "utilities--contents" } do %>
      <%= icon("trash") %>
      <span>Revoke</span>
    <% end %>
  </footer>
</article>
