<%# locals: (date:, picture:) %>
<%= turbo_stream.replace "daylog_picture_#{date.iso8601}" do %>
  <%= render "daylogs/picture", date: date, picture: picture %>
<% end %>
<%= turbo_stream.replace "daylog_photo_card_#{date.iso8601}" do %>
  <%= render "daylogs/photo_card", date: date, picture: picture, lazy: mobile_variant? %>
<% end %>
