    <%= button_to bullet_archive_path(bullet), method: :patch, class: "bullet-dropdown-item", data: { "grid-navigation-target" => "item" } do %>
      <span class="bullet-dropdown-icon bullet-dropdown-icon--archive">
        <span class="icon" style="--icon-mask: var(--icon-archive)"></span>
      </span>

      <span class="bullet-dropdown-text">
        <span class="bullet-dropdown-label">
          <%= bullet.archived? ? "Unarchive" : "Archive" %>
        </span>

        <span class="bullet-dropdown-desc">
          <%= bullet.archived? ? "Restore to Timeline" : "Stored in archive for 30 days" %>
        </span>
      </span>
    <% end %>
