<% content_for(:title, "New hook") %>

<%= render "shared/back_tabbar", url: hooks_path, aria_label: "Back to Hooks" %>

<main data-size="sm">
  <h1>Hook</h1>

  <div>
    <div class="utilities--contents">
      <p>
        Give a name to the integration, then share the URL Dotted gives you.
      </p>

      <%= form_with model: @hook, url: hooks_path, html: { class: "form" } do |form| %>
        <label>
          <legend>Name</legend>
          <%= form.text_field :name, required: true, placeholder: "Zapier, Gmail, etc." %>
          <% if @hook.errors[:name].any? %>
            <small class="form--errors"><%= @hook.errors.full_messages_for(:name).to_sentence %></small>
          <% end %>
        </label>

        <%= form.button type: "submit", data: { intent: "primary", radius: "full", size: "sm" } do %>Create hook<% end %>
      <% end %>

      <h2>How to call it</h2>
      <p>
        After create you’ll get a URL. External apps <strong>POST</strong> JSON to it.
        <code>author_name</code> is optional.
      </p>
      <%= tag.pre role: "doc-example" do %><%=
        JSON.pretty_generate(
          author_name: "Zapier",
          body: "Ship the release"
        )
      %><% end %>
    </div>
  </div>
</main>
