<% content_for(:title, "New hook") %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to hooks_path,
            class: "button",
            data: { content: "text", turbo_frame: "_top" },
            aria: { label: "Back to Hooks" } do %>
        <%= icon_tag("arrow-left") %>
        <span>Hooks</span>
      <% end %>
      <h1>New hook</h1>
    </header>

    <p class="typography--paragraph-sm typography--balanced">
      Name the integration, then share the URL Digibujo gives you.
    </p>

    <section class="layout--surface layout--flex" data-elevation="2" data-padding="true" data-direction="column">
      <h2>How to call it</h2>
      <p class="typography--paragraph-sm">
        After create you’ll get a URL. External apps <strong>POST</strong> JSON to it.
        <code>bulletable_type</code> is <code>Note</code> or <code>Task</code>.
        <code>author_name</code> is optional.
      </p>
      <pre role="doc-example"><%=
        JSON.pretty_generate(
          author_name: "Zapier",
          bulletable_type: "Note",
          body: "Ship the release"
        )
      %></pre>
    </section>

    <%= form_with model: @hook, url: hooks_path, class: "form" do |form| %>
      <div class="form-section">
        <%= form.label :name %>
        <small>Label for you, e.g. “Zapier” or “GitHub”.</small>
        <%= form.text_field :name, required: true, autofocus: true %>
        <% if @hook.errors[:name].any? %>
          <small class="form--errors"><%= @hook.errors.full_messages_for(:name).to_sentence %></small>
        <% end %>
      </div>

      <%= form.submit "Create hook",
            class: "button form--submit",
            data: { intent: "primary", radius: "full", size: "sm" } %>
    <% end %>
  </div>
</main>
