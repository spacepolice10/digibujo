<% content_for(:title, "Hooks") %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
      <%= back_link_to user_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" },
            aria: { label: "Back to Account" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h2>Hooks</h2>
      </nav>
      <%= link_to new_hook_path,
            class: "button",
            data: { intent: "primary", radius: "full", size: "sm", content: "icon" },
            aria: { label: "Create Hook" } do %>
        <%= icon_tag("plus") %>
      <% end %>
    </header>

    <main>
    <p>
      Give an external app a URL. When it posts, Digibujo drops a bullet into your timeline.
    </p>

    <% if @created_hook_code.present? %>
      <section class="hook--created" role="status">
        <header>
          <span aria-hidden="true">⚡</span>
          <strong>Hook is ready</strong>
        </header>
        <p>Copy this URL now. You won’t see it again.</p>
        <code class="hook--created-link"><%= hook_intake_url(@created_hook_code) %></code>
      </section>
    <% end %>

    <% if @hooks.any? %>
      <section id="hooks" class="hook--list">
        <%= render partial: "hooks/hook", collection: @hooks, as: :hook %>
      </section>
    <% else %>
      <p id="hooks_empty">No hooks yet.</p>
    <% end %>
    </main>
  </article>
</main>
