<% content_for(:title) { "Triage" } %>

<div class="layout--page layout--container layout--container-md">

  <div class="layout--flex layout--gapped layout--justify-between">
    <%= back_link_to daylog_path, class: "button--secondary button--sm" do %>
      <%= icon_tag("arrow-left") %>

    <% end %>
    <div class="button--secondary button--sm">
    <%= icon_tag("mail") %>
    <span>Triage</span>
    </div>
  </div>
    <div class="layout--flex layout--gapped layout--padded layout--mx-auto">
      Bullets waiting to be added to your daylog
    </div>


    <div class="layout--list">
      <div data-bulk-menu-target="list">

      <% @bullets.each do |bullet| %>
        <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
      <% end %>
      </div>
    </div>
    <div class="layout--flex layout--gapped layout--mx-auto">
    <%= link_to "Daylog", daylog_path, class: "button--secondary button--sm" %>
    </div>
</div>
