<% if @failed_message.present? %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: [@failed_message] %>
  <% end %>
<% else %>
  <%= turbo_stream.remove dom_id(@bullet, :pending) %>
  <%= turbo_stream.replace "triage_chip" do %>
    <%= render "daylogs/triage_chip", pending_count: Pending.pending_number_of(Current.user) %>
  <% end %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "notify", messages: ["Discarded"] %>
  <% end %>
<% end %>
