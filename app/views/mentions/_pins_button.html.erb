<turbo-frame id="<%= dom_id(mention, :pin_button) %>">
  <% if mention.pinned? %>
    <%= button_to pin_path,
          method: :delete,
          params: pin_params,
          class: "button--secondary",
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{mention.name}" } do %>
      <i class="icon" style="--icon-mask: var(--icon-unpin)" aria-hidden="true"></i>
      Unpin
    <% end %>
  <% else %>
    <%= button_to pin_path,
          method: :post,
          params: pin_params,
          class: "button--secondary",
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{mention.name}" } do %>
      <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
      Pin
    <% end %>
  <% end %>
</turbo-frame>
