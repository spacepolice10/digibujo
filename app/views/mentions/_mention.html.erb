<li id="<%= dom_id(mention, :list_item) %>" class="layout--list-item">
  <%= link_to public_send(:"#{mention.kind}_path", mention),
        { data: { turbo_frame: "_top" }, class: "layout--list-item-link" } do %>

    <%= icon_tag(mention.icon, colour: mention.colour) %>
    <span class="utilities--line-clamp-1"><%= mention.name %></span>

    <div class="typography--paragraph-sm utilities--line-clamp-1">
      <span><%= mention.bullets.count %> <%= "bullet".pluralize(mention.bullets.count) %></span>,
      <span><%= mention.created_at.strftime("%b %d") %></span>
    </div>
  <% end %>
</li>
