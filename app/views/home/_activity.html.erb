<%# locals: (activity:) %>
<div
  id="<%= dom_id(activity) %>"
  class="home--activity-item"
>
  <%= link_to activity_path(activity), class: "home--activity-link", data: { turbo_frame: "_top" } do %>
    <p class="home--activity-detail utilities--line-clamp-1">
      <%= activity_sentence(activity, relative: true, linked: false) %>
    </p>
  <% end %>
</div>
