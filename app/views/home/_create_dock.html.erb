<div class="dropdown--dock home--create-dock">
  <button
    type="button"
    class="button--primary button--icon button--circle"
    popovertarget="home_create"
    aria-label="Create"
  >
    <%= icon_tag("plus") %>
  </button>
  <div
    id="home_create"
    class="dropdown dropdown--element dropdown--element-bottom animations--side-in home--create-dropdown"
    popover
  >
    <%= render "home/create_menu" %>
  </div>
</div>
