<% appearance = Current.user.settings!.appearance %>

<div class="home--appearance">
  <div
    class="form--picker form--colour-picker"
    role="radiogroup"
    aria-label="Background appearance"
    data-controller="appearance"
    data-appearance-url-value="<%= home_appearance_path %>"
    data-action="change->appearance#changeAppearance"
  >
    <% User::Settings::APPEARANCES.each do |name| %>
      <label class="form--picker-option">
        <%= radio_button_tag :appearance, name, appearance == name %>

        <span
          class="
            <%= class_names(
            'form--picker-control',
            'form--colour-swatch',
            "home--appearance-swatch--#{name}"
            ) %>
          "
          aria-hidden="true"
        ></span>

        <span class="utilities--sr-only"><%= name.capitalize %></span>
      </label>
    <% end %>
  </div>
</div>
