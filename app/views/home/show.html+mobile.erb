<% content_for(:title, "Home") %>

<div class="layout--page">
  <div class="layout--flex layout--justify-between">
    <h1 class="typography--h1">Hello <%= current_user.email_address %></h1>

    <div class="layout--flex">
      <%= render "account_button" %>
      <div data-controller="dialog">
        <button
          type="button"
          class="button--primary button--icon button--circle"
          commandfor="home_create"
          command="show-modal"
          aria-label="Create"
        >
        <%= icon_tag("plus") %>
        </button>
        <%= render "shared/dialog", id: "home_create" do %>
            <%= render "home_actions" %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "menu/navigation" %>

  <div
    class="search"
    data-controller="combobox search"
    data-combobox-path-value="<%= search_path %>"
    data-search-selection-path-value="<%= search_selection_path %>"
  >
    <%= render "searches/form" %>
    <%= render "searches/palette" %>
  </div>
      <% @sections.each do |section| %>
        <%= render "home_section", section: section %>
      <% end %>
</div>
