<div class="dropdown--element-header">
  <h2>Create</h2>
  <button
    type="button"
    class="button--primary button--icon button--circle dropdown--element-hide"
    popovertarget="home_create"
    popovertargetaction="hide"
    aria-label="Close create"
  >
    <%= icon_tag("x") %>
  </button>
</div>

<div class="dropdown--element-body">
  <nav class="dropdown--menu" aria-label="Create">
    <%= link_to new_collection_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("plus") %>
      Add collection
    <% end %>

    <%= link_to new_future_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("calendar") %>
      Add future log
    <% end %>

    <%= link_to new_monthlylog_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("calendar") %>
      Add monthly log
    <% end %>

    <%= link_to new_project_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("tag") %>
      New project
    <% end %>
  </nav>
</div>
