<% content_for(:title, "Home") %>

<main class="home--page" data-size="md">
  <section>
    <% if mobile_variant? %>
      <article data-elevation="1">
        <header>
          <nav>
            <%= render "home/account_button" %>
            <%= link_to "Digibujo", home_path, class: "home--wordmark", data: { turbo_frame: "_top" } %>
          </nav>
        </header>

        <main>
          <%= link_to search_path,
        class: "button",
        data: { turbo_frame: "_top", intent: "secondary", radius: "base" } do %>
            <%= icon_tag("search") %>
            <span>Search</span>
          <% end %>
        </main>
      </article>
    <% end %>

    <% if mobile_variant? %>
      <article data-elevation="1">
        <header>
          <h2>Pins</h2>
        </header>

        <main>
          <% @pinned_entities.each do |entity| %>
            <li>
              <%= render "pinned/pinned_entity", pinned_entity: entity %>
            </li>
          <% end %>

          <% if @pinned_entities.empty? %>
            <p>Nothing pinned yet.</p>
          <% end %>
        </main>

        <footer>
          <%= link_to pinned_index_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
            <p>Show all...</p>
          <% end %>
        </footer>
      </article>
    <% end %>

    <article data-elevation="1">
      <header>
        <h2>Logs</h2>
      </header>

      <main>
        <section>
          <li>
            <%= link_to current_monthlylog_navigation_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
              <%= icon_tag("calendar") %>

              <p>Monthly log</p>
            <% end %>
          </li>

          <li>
            <%= link_to current_future_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
              <%= icon_tag("calendar-repeat") %>

              <p>Future log</p>
            <% end %>
          </li>
        </section>
      </main>
    </article>

    <article data-elevation="1">
      <header>
        <h2>Collections</h2>

        <%= link_to new_collection_path, class: "button",
        data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "xs", content: "icon" } do %>
          <%= icon_tag("plus") %>
        <% end %>
      </header>

      <main>
        <section>
          <% @collections.each do |collection| %>
            <li><%= render collection %></li>
          <% end %>
        </section>

        <% if @collections.empty? %>
          <p>
            Collections are like folders in a traditional notebook — group
            related bullets and keep them organised for as long as you need.
          </p>
        <% end %>
      </main>

      <footer>
        <%= link_to collections_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
          <p>Show all...</p>
        <% end %>
      </footer>
    </article>

    <article data-elevation="1">
      <header>
        <h2>Attachments</h2>
      </header>

      <main>
        <% if @attachments.any? %>
          <div class="home--attachment-previews">
            <%= render partial: "home/attachment_preview", collection: @attachments, as: :attachment %>
          </div>
        <% else %>
          <p>Upload files to your journal to keep track of your documents.</p>
        <% end %>
      </main>

      <footer>
        <%= link_to attachments_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "sm", content: "text" } do %>
          <p>Show all...</p>
        <% end %>
      </footer>
    </article>

    <article data-elevation="1">
      <header>
        <h2>Projects</h2>
      </header>

      <main>
        <section>
          <% @projects.each do |project| %>
            <li>
              <%= render project %>
            </li>
          <% end %>
        </section>

        <% if @projects.empty? %>
          <p>
            Put a # in your note or task to create a thread to make a connection
            between bullets.
          </p>
        <% end %>
      </main>

      <footer>
        <%= link_to projects_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
          <p>Show all...</p>
        <% end %>
      </footer>
    </article>

    <article data-elevation="1">
      <header>
        <h2>Trackers</h2>

        <%= link_to new_tracker_path, class: "button",
          data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "xs", content: "icon" } do %>
          <%= icon_tag("plus") %>
        <% end %>
      </header>

      <main>
        <section>
          <% @trackers.each do |tracker| %>
            <li>
              <%= render tracker %>
            </li>
          <% end %>
        </section>

        <% if @trackers.empty? %>
          <p>Create trackers to track your progress.</p>
        <% end %>
      </main>

      <footer>
        <%= link_to trackers_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "sm" } do %>
          <p>Show all...</p>
        <% end %>
      </footer>
    </article>

    <article data-elevation="1">
      <header>
        <h2>Recently shared</h2>
      </header>

      <main>
        <% @published_bullets.each do |bullet| %>
          <li>
            <%= link_to bullet_path(bullet), class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "base", size: "sm" } do %>
              <%= icon_tag(bullet.marker_icon.to_s.dasherize) %>

              <p><%= bullet.name %></p>
            <% end %>
          </li>
        <% end %>

        <% if @published_bullets.empty? %>
          <p>Share your bullets with others to collaborate on projects.</p>
        <% end %>
      </main>

      <footer>
        <%= link_to published_index_path, class: "button", data: { turbo_frame: "_top", intent: "secondary", radius: "full", size: "sm" } do %>
          <p>Show all...</p>
        <% end %>
      </footer>
    </article>

    <br>
  </section>

  <%= link_to archived_index_path, class: "button",
    data: { intent: "secondary", radius: "full", size: "lg", turbo_frame: "_top" } do %>
    <%= icon_tag("archive") %>

    <p>Archive</p>
  <% end %>
</main>
