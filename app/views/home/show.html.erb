<div class="layout--container layout--grid cols-3">
  <aside class="home--side">
    <%= render "home_actions" %>
    <%= render "appearance_picker", appearance: @appearance %>
  </aside>

  <div class="layout--surface layout--grid-item span-1 home--section-list">
    <% @sections.each do |section| %>
      <%= render "home_section", section: section %>
    <% end %>
  </div>

  <aside class="home--activities">
    <h4 class="layout--rail-heading">Activity</h4>

    <turbo-frame
      id="home_activity"
      src="<%= compact_activities_path %>"
      loading="lazy"
    ></turbo-frame>
  </aside>
</div>
