<% content_for(:title, "Attachments") %>

<%= render "shared/back_tabbar" %>

<main class="attachment--page" data-size="md">
  <h1>Attachments</h1>

  <% if @attachments.any? %>
    <section class="attachment--gallery">
      <% @attachments.each do |attachment| %>
        <% blob = attachment.blob %>
        <%= link_to attachment_path(blob.signed_id),
              class: "attachment--tile",
              data: { kind: blob.variable? ? "image" : "file", turbo_frame: "_top" },
              aria: { label: "View #{blob.filename}" } do %>
          <% if blob.variable? %>
            <%= image_tag blob.representation(resize_to_limit: [800, 1600]),
                  alt: blob.filename.to_s,
                  loading: "lazy" %>
          <% else %>
            <span class="attachment--tile-file">
              <%= icon("paperclip") %>
              <span class="attachment--tile-name"><%= blob.filename %></span>
              <span class="attachment--tile-size"><%= number_to_human_size(blob.byte_size) %></span>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <p class="attachment--empty">No attachments yet.</p>
  <% end %>
</main>
