<% content_for(:title) { @blob.filename.to_s } %>

<main data-size="md">
  <article data-elevation="1">
    <header><nav>
        <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>
        <h2>Attachment</h2>
    </nav></header>

  <main class="attachment--show">
    <% if @blob.representable? %>
      <%= represent_image_tag @blob,
            variant: :display,
            alt: @blob.filename,
            class: "attachment--show-image" %>
    <% else %>
      <p>
        <%= link_to @blob.filename,
              rails_blob_path(@blob, disposition: "attachment"),
              data: { turbo: false } %>
        · <%= number_to_human_size @blob.byte_size %>
      </p>
    <% end %>
  </main>
  </article>
</main>
