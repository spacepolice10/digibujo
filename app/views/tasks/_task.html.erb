<%# locals: (task:, selected_date: nil) %>
<% bullet = task %>
<% task = bullet.bulletable %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-type="task" data-task-completed="<%= task.completed? %>">
  <%= render "bullets/marker", bullet: bullet %>
  <div class="bullet--body">
    <%= task.excerpt %>
    <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
  </div>
</turbo-frame>
