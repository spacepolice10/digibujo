<turbo-frame id="<%= dom_id(task) %>" class="bullet" data-bullet-type="task">
  <% task_item = task.bulletable %>
  <%= form_with url: bullet_complete_path(task), method: task_item.done? ? :delete : :post, data: { turbo_stream: true } do %>
    <button class="bullet--task-marker" data-task-done="<%= task_item.done? %>">
        <% if task_item.done? %>
          <i class="icon " style="--icon-mask: var(--icon-check)" aria-hidden="true"></i>
        <% else %>
          <i class="icon" style="--icon-mask: var(--icon-square)" aria-hidden="true"></i>
        <% end %>
    </button>
  <% end %>
  <%= link_to edit_bullet_path(task), class: "bullet--name" do %>
    <%= task.name %>
  <% end %>
  <%= render "bullets/metadata", bullet: task %>
  <%= render "bullets/menu", bullet: task %>
</turbo-frame>
