<turbo-frame id="<%= dom_id(task) %>" class="bullet" data-bullet-type="task">
  <%= form_with url: complete_path, method: task.bulletable.done? ? :delete : :post, data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, task.id %>
    <button class="bullet--marker bullet--task-marker" data-task-done="<%= task.bulletable.done? %>">
        <% if task.bulletable.done? %>
          <i class="icon " style="--icon-mask: var(--icon-check)" aria-hidden="true"></i>
        <% else %>
          <i class="icon" style="--icon-mask: var(--icon-square)" aria-hidden="true"></i>
        <% end %>
    </button>
  <% end %>
  <div class="bullet--body">
    <div class="bullet--name">
      <%= task.body %>
    </div>
    <%= render "bullets/metadata", bullet: task %>
    <%= render "bullets/attachments", bullet: task %>
  </div>
  <%= render "bullets/select", bullet: task %>
</turbo-frame>
