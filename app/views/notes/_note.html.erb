<%# locals: (note:, selected_date: nil) %>
<turbo-frame id="<%= dom_id(note) %>" class="bullet" data-bullet-type="note"
             <% if note.bulletable.mood.present? %>data-note-mood="<%= note.bulletable.mood %>"<% end %>>
  <div class="bullet--marker-slot">
    <%= render "bullets/marker", bullet: note %>
  </div>
  <div class="bullet--body">
    <%= note.body %>
    <%= render "bullets/metadata", bullet: note, selected_date: selected_date %>
  </div>
  <%= render "bullets/bulk_menu_select", bullet: note %>
</turbo-frame>
