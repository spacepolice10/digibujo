<%# locals: (note:, selected_date: nil) %>
<% bullet = note %>
<% note = bullet.bulletable %>
<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-type="note"
  <% if note.mood.present? %>
    data-note-mood="<%= note.mood %>"
  <% end %>
>
  <%= render "bullets/marker", bullet: bullet %>

  <div class="bullet--body">
    <div class="bullet--note-surface">
      <%= note.excerpt %>
      <span class="bullet--mood-marker">
        <%= note.mood_marker %>
      </span>
    </div>
    <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
  </div>
</turbo-frame>
