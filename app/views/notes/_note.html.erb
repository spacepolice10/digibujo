<%# locals: (note:, selected_date: nil) %>
<% bullet = note %>
<% note = bullet.bulletable %>

<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-type="note"
  <% if note.mood.present? %>
    data-note-mood="<%= note.mood %>"
  <% end %>
>
  <%= render "bullets/marker", bullet: bullet %>

  <div class="bullet--body">
    <div class="bullet--document">
      <% if note.long? %>
        <h3 class="bullet--name">
          <%= note.name %>
        </h3>
        <p>
          <%= note.excerpt %>
        </p>
        <div class="read-more">
          <%= link_to "Read more", bullet_path(bullet), class: "", data: { turbo_frame: "_top" } %>
          <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
        </div>
      <% else %>
      <div class="bullet--note">
        <%= note.excerpt %>
      </div>
        <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
      <% end %>
    </div>

    <% if note.mood_marker.present? %>
      <span class="bullet--mood" aria-hidden="true">
        <%= note.mood_marker %>
      </span>
    <% end %>
  </div>
</turbo-frame>
