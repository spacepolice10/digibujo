<%# locals: (bullet:, selected_date: nil) %>
<% note = bullet.bulletable %>
<% if note.long? %>
<div class="bullet--document">
    <h2 class="bullet--name"><%= note.name %></h2>
    <p><%= note.excerpt %></p>
    <div class="read-more">
      <%= link_to "Read more", bullet_path(bullet), class: "", data: { turbo_frame: "_top" } %>
    </div>
  </div>
  <% else %>
    <div class="bullet--note"><%= note.excerpt %></div>
  <% end %>
<% if note.mood_marker.present? %>
  <span class="bullet--mood" aria-hidden="true"><%= note.mood_marker %></span>
<% end %>
