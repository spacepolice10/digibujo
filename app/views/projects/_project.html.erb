<li id="<%= dom_id(project, :list_item) %>" class="layout--list-item">
  <%= link_to project_path(project), { data: { turbo_frame: "_top" }, class: "layout--list-item-link" } do %>
    <span aria-hidden="true">
      <%= image_tag project.icon_path, alt: "", style: "background-color: transparent", class: "icon" %>
    </span>

    <span class="utilities--line-clamp-1"><%= project.name %></span>

    <div class="typography-description utilities--line-clamp-1">
      <span><%= project.bullets.count %> <%= "bullet".pluralize(project.bullets.count) %></span>,
      <span><%= project.created_at.strftime("%b %d") %></span>
    </div>
  <% end %>
</li>
