      <li class="bucket--list-item">
        <%= link_to project_path(project), class: "button-secondary", **bucket_link_attributes(project) do %>
          <% if project.icon.present? %>
            <i
              class="icon"
              style="--icon-mask: <%= bucket_icon_mask(project.bucket) %>"
              aria-hidden="true"
            ></i>
          <% end %>

          <%= project.name %>
        <% end %>
      </li>
