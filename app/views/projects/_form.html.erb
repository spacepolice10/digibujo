<%= form_with model: project, class: "form form--strong" do |f| %>
  <small class="form-hint">Projects work like topic tags — mark bullets with a project and you can instantly see everything related to that goal in one place.</small>

  <%= render "identity_fields", form: f,
        name_hint: "Name the project you are working on. Examples: Website redesign, Book draft, Home renovation." %>
  <%= f.submit class: "button--primary form--submit" %>
<% end %>
