<%= form_with model: project, class: "form form--strong" do |f| %>
  <small class="form-hint">Projects work like topic tags — mark bullets with a project and you can instantly see everything related to that goal in one place.</small>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <small class="form-hint">Name the project you are working on. Examples: Website redesign, Book draft, Home renovation.</small>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>
  <%= render "shared/form/colour_picker", form: f %>
  <%= render "shared/form/icon_picker", form: f %>
  <%= f.submit class: "button--primary form--submit" %>
<% end %>
