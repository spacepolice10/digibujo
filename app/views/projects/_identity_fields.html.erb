<%# locals: (form:, name_hint: nil) %>
<div class="form-group">
  <%= form.label :name, class: "form-label" %>
  <% if name_hint.present? %>
    <small class="form-hint"><%= name_hint %></small>
  <% end %>
  <%= form.text_field :name, class: "form-input", required: true %>
</div>
<div class="form-group">
  <span class="form-label">Colour</span>
  <div class="form--colour-picker" role="radiogroup" aria-label="Project colour">
    <% Colourable::COLOUR_MAPPINGS.each_key do |name| %>
      <label class="form--colour-option">
        <%= form.radio_button :colour, name %>
        <span class="form--colour-swatch" style="background: <%= Colourable.colour_bg_variable_for(name) %>" aria-hidden="true"></span>
      </label>
    <% end %>
  </div>
</div>
<div class="form-group">
  <span class="form-label">Icon</span>
  <small class="form-hint">Pick an emoji to make this project easy to spot.</small>
  <div class="form--icon-picker" role="radiogroup" aria-label="Project icon">
    <% Iconable::EMOJI_ICONS.each do |key| %>
      <label class="form--icon-option">
        <%= form.radio_button :icon, key %>
        <%= image_tag "emoji/#{key}.svg", alt: "", class: "form--icon-image" %>
      </label>
    <% end %>
  </div>
</div>
