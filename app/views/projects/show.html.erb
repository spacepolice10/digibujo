<% content_for(:title) { @project.name } %>

<div class="layout--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to home_path, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Projects
      <% end %>
      <%= render "mentions/pins_button",
            mention: @project,
            pin_path: projects_pin_path,
            pin_params: { project_id: @project.id } %>
      <%= button_to project_path(@project),
            method: :delete,
            class: "button--secondary button--danger layout--rail-action",
            form: { data: { turbo_confirm: "Delete this project and remove it from all bullets?" } } do %>
        <i class="icon" style="--icon-mask: var(--icon-trash)" aria-hidden="true"></i>
        Delete
      <% end %>
    </div>
    <h2 class="layout--surface-name"><%= @project.name %></h2>
  </div>

  <div class="layout--surface">
    <div class="layout--list" data-bulk-menu-target="list">
      <% if @bullets.any? %>
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                pagination_link_path: ->(next_param) { project_path(@project, page: next_param) }
              } do %>
          <% @page.records.each do |bullet| %>
            <%= render bullet %>
          <% end %>
        <% end %>
      <% else %>
        <p>No bullets yet.</p>
      <% end %>
    </div>
  </div>
</div>
