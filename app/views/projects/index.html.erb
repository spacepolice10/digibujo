<% content_for(:title) { "Projects" } %>

<div class="layout--page">
<div class="layout--header">
  <h2>Projects</h2>
  <%= render "projects/search" %>
  <div class="layout--header-actions">
    <%= link_to "New project", new_project_path, class: "button--primary" %>
  </div>
</div>

  <turbo-frame id="projects">
    <% if @projects.any? %>
      <ul class="layout--list bucket--list">
        <%= render @projects %>
      </ul>
    <% else %>
      <p>No projects yet. Collect or pop bullets to create them.</p>
    <% end %>
  </turbo-frame>
</div>
