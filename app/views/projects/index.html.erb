<% content_for(:title) { "Projects" } %>

<main data-size="md">
  <article data-elevation="1">
    <header>
      <nav>
        <%= back_link_to home_path, class: "button", data: { intent: "secondary", content: "icon", radius: "full", size: "sm", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>

      <h1>Projects</h1>
      </nav>

      <%= link_to new_project_path, class: "button", data: { intent: "primary", radius: "full", size: "xs" } do %>
        <%= icon_tag("plus") %><span>New</span>
      <% end %>
    </header>

    <main id="projects">
      <% if @projects.any? %>
        <ul>
          <li>
            <%= render partial: "projects/project", collection: @projects, as: :project %>
          </li>
        </ul>
      <% else %>
        <p class="typography--paragraph-sm">No projects yet.</p>
      <% end %>
    </main>
  </article>
</main>
