<% content_for(:title) { "New project" } %>

<div class="layout--page">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to projects_path, class: "button--secondary", onclick: "if (history.length > 1) { event.preventDefault(); history.back(); }" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
    </div>
    <h2>New project</h2>
  </div>
  <div class="layout--surface">
    <%= render "mentions/form",
          mention: @project,
          url: projects_path,
          hint: "Projects work like topic tags — mark bullets with a project and you can instantly see everything related to that goal in one place.",
          name_hint: "Name the project you are working on. Examples: Website redesign, Book draft, Home renovation." %>
  </div>
</div>
