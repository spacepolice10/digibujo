<%# locals: (project:, pin_path:, pin_params:) %>
<turbo-frame id="<%= dom_id(project, :pin_button) %>">
  <% if project.pinned? %>
    <%= button_to pin_path,
          method: :delete,
          params: pin_params,
          class: "button--secondary button--sm",
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{project.name}" } do %>
      <%= icon_tag("pin", style: "color: var(--color-invert-2);") %>
    <% end %>
  <% else %>
    <%= button_to pin_path,
          method: :post,
          params: pin_params,
          class: "button--secondary button--sm ",
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{project.name}" } do %>
      <%= icon_tag("pin", style: "color: var(--color-invert-2);") %>
    <% end %>
  <% end %>
</turbo-frame>
