<%# locals: (review_from:, review_to:, page:, amount_in_review:) %>
<main class="review--to-review" aria-label="To review">
  <header class="review--to-review-header">
    <h3 class="review--side-name">To review</h3>
    <p class="review--side-description utilities--text-sm">Timeline bullets for this period.</p>
  </header>

  <article class="review--to-review-body review--to-review-list" data-bulk-menu-target="list">
    <% if page.records.any? %>
      <%= render layout: "pagination/paginated_list",
            locals: {
              page: page,
              container_id: "paginated-review-to-review",
              pagination_link_path: lambda { |next_param|
                review_path(from: review_from.iso8601, to: review_to.iso8601, page: next_param)
              }
            } do %>
        <% page.records.each do |bullet| %>
          <%= render "reviews/bullet", bullet: bullet %>
        <% end %>
      <% end %>
    <% else %>
      <p class="review--to-review-empty utilities--text-sm">Nothing to review</p>
    <% end %>
  </article>

  <% if amount_in_review.to_i.positive? %>
    <footer id="review-migrate-footer" class="review--to-review-footer">
      <%= form_with url: mark_as_reviewed_path,
                    method: :post do %>
        <%= hidden_field_tag :from, review_from.iso8601 %>
        <%= hidden_field_tag :to, review_to.iso8601 %>
        <%= button_tag type: :submit, class: "button--secondary" do %>
          <span class="review--migration-mark" aria-hidden="true"></span>
          Mark all as reviewed
        <% end %>
      <% end %>
    </footer>
  <% end %>
</main>
