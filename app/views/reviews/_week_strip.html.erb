<aside class="review--week" aria-label="This week">
  <header class="review--week-header">
    <h3 class="review--panel-title">Schedule</h3>
    <p class="review--panel-description utilities--text-sm">
      <%= @week_start.strftime("%b %-d") %> – <%= @week_days.last.strftime("%b %-d") %>
    </p>
  </header>

  <div class="review--week-days">
    <% @week_days.each do |date| %>
      <%= render "reviews/week_day", date: date, bullets: @week_bullets_by_date[date] || [] %>
    <% end %>
  </div>
</aside>
