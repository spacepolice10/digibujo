<%# locals: (collection:) %>
<li class="layout--list-item">
  <div class="bulk-menu--collect-form review--collection-drop-target"
       data-controller="collect-drop"
       data-collect-drop-collect-url-value="<%= collect_path %>"
       data-collect-drop-bucket-id-value="<%= collection.bucket.id %>"
       data-action="dragover->collect-drop#dragover dragleave->collect-drop#dragleave drop->collect-drop#drop">
    <%= link_to collection_path(collection),
          class: "bulk-menu--collect-item-link",
          data: { turbo_frame: "_top" } do %>
      <%= render "collections/search_palette", collection: collection %>
    <% end %>
  </div>
</li>
