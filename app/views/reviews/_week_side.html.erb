<%# locals: (review_to:, week_days:, week_bullets_by_date:) %>
<aside class="review--week" aria-label="This week">
  <header class="review--week-header">
    <h3 class="review--side-name">Schedule</h3>
    <p class="review--side-description utilities--text-sm">
      <%= review_to.strftime("%b %-d") %> – <%= week_days.last.strftime("%b %-d") %>
    </p>
  </header>

  <div class="review--week-dates">
    <% week_days.each do |date| %>
      <%= render "reviews/week_date", date: date, bullets: week_bullets_by_date[date] || [] %>
    <% end %>
  </div>
</aside>
