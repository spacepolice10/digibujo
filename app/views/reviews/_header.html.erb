<div class="review--header layout--header">
  <h2>Review</h2>
  <span class="utilities--text-sm">
    <% if @review_from == @review_to %>
      <%= @review_from.strftime("%a, %b %-d, %Y") %>
    <% else %>
      <%= @review_from.strftime("%b %-d") %> – <%= @review_to.strftime("%b %-d, %Y") %>
    <% end %>
    · <strong id="review-amount-in-review"><%= @amount_in_review %></strong> total
  </span>
</div>
