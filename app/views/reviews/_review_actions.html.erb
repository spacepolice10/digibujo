<%# locals: (bullet:, schedule_tomorrow:, review_from:, review_to:) %>
<div class="review--review-actions" data-controller="review-actions" data-review-actions-bullet-id-value="<%= bullet.id %>">
  <%= form_with url: pop_path, method: :post, class: "review--review-action", data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet.id %>
    <%= hidden_field_tag :pops_on, schedule_tomorrow.iso8601 %>
    <%= button_tag type: :submit, class: "button--tertiary button--icon", aria: { label: "Schedule for tomorrow" } do %>
      <i class="icon" style="--icon-mask: var(--icon-arrow-right)" aria-hidden="true"></i>
    <% end %>
  <% end %>

  <button type="button"
          class="button--tertiary button--icon review--review-action"
          data-action="review-actions#openCollectPicker"
          aria-label="Collect into collection">
    <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
  </button>

  <% if bullet.completable? && !bullet.completed? %>
    <%= form_with url: complete_path, method: :post, class: "review--review-action", data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, bullet.id %>
      <%= button_tag type: :submit, class: "button--tertiary button--icon", aria: { label: "Complete" } do %>
        <i class="icon" style="--icon-mask: var(--icon-check)" aria-hidden="true"></i>
      <% end %>
    <% end %>
  <% else %>
    <%= form_with url: archive_path, method: :post, class: "review--review-action", data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, bullet.id %>
      <%= button_tag type: :submit, class: "button--tertiary button--icon", aria: { label: "Archive" } do %>
        <i class="icon" style="--icon-mask: var(--icon-archive)" aria-hidden="true"></i>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: review_migrate_path(from: review_from.iso8601, to: review_to.iso8601),
                method: :post,
                class: "review--review-action",
                data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet.id %>
    <%= button_tag type: :submit, class: "button--tertiary button--icon", aria: { label: "Mark as migrated" } do %>
      <span class="review--migration-mark" aria-hidden="true">›</span>
    <% end %>
  <% end %>
</div>
