<% page = local_assigns.fetch(:page) %>
<%= render layout: "pagination/paginated_list",
      locals: {
        page: page,
        pagination_link_path: local_assigns.fetch(:pagination_link_path),
        container_id: local_assigns.fetch(:container_id, "paginated-records"),
        turbo_frame: local_assigns[:turbo_frame]
      } do %>
  <% page.records.each do |record| %>
    <%= render record, selected_date: local_assigns[:selected_date] %>
  <% end %>
<% end %>
