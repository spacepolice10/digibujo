
<% greeting = {
    "morning" => "Good morning",
    "afternoon" => "Good afternoon",
    "evening" => "Good evening",
    "night" => "Good night",
}[time_period] %>


<div class="daylog--triage-preview layout--container" data-size="sm" data-margin="horizontal">
    <div class="layout--surface" data-elevation="2" data-padding="true">
    <div>
        <h2> <%= Date.today.strftime("%A, %B %-d") %> </h2>
    </div>
    <br>
    <p>
    <%= greeting %> <span class="pill"> <%= Current.user.name %> </span> you have <span class="highlight" style="--highlight-colour: var(--model-color-2);">  <%= @monthlylog_tasks_number %> tasks </span> and <span class="highlight" style="--highlight-colour: var(--model-color-4);"> <%= @monthlylog_note_number %> notes </span> in your monthly log that you've planned for today. Also you have <span class="pill pill--notify"> <%= @yesterdays_number %> <%= 'bullet'.pluralize(@yesterdays_number) %> </span> that probably wait for migration from yesterday.
    </p>
    <br>

    <div class="layout--flex" data-justify="center">
        <%= link_to "Review", triage_path, class: "button", data: {intent: "primary", radius: "full", size: "sm"} %>
    </div>
    </div>
</div>
