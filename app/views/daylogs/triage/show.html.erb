<% content_for(:title) { "Daylog triage" } %>

<main class="triage--container" data-size="xl">
  <section class="triage--surface">
    <article class="triage--section divided--vertical" data-elevation="1" aria-label="To review">

      <header class="triage--section-header">
        <nav class="triage--section-navigation">
          <%= back_link_to daylog_path,
                class: "button",
                data: { content: "text", turbo_frame: "_top" },
                aria: { label: "Back to Daylog" } do %>
            <%= icon_tag("arrow-left") %>
            <span>Daylog</span>
          <% end %>
        </nav>
      </header>

      <main class="triage--section-content" data-bulk-menu-target="list" data-drop-zone-value="triage">
        <div id="daylog_triage_queue" class="triage--bullets">
          <% if @triage.bullets.any? %>
            <%= render partial: "daylogs/triage/bullet", collection: @triage.bullets, as: :bullet %>
          <% else %>
            <p>Nothing pending right now.</p>
          <% end %>
        </div>
      </main>
    </article>

    <article
      class="triage--section"
      data-elevation="1"
      aria-label="Today"
      data-controller="pops-drop"
      data-pops-drop-pops-url-value="<%= postpone_path %>"
      data-pops-drop-bucket-id-value="<%= @daylog.bucket.id %>"
      data-pops-drop-pops-on-value="<%= @selected_date.iso8601 %>"
      data-drop-zone-value="<%= @selected_date.iso8601 %>"
      data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
      data-bulk-menu-ignore
    >
      <header class="triage--section-header">
        <h3>Today</h3>
        <p>Drop bullets here to migrate them to <%= @selected_date.strftime("%A, %B %-d") %>.</p>
      </header>

      <main class="triage--section-content">
        <div id="daylog_triage_today" class="triage--bullets">
          <% if @today_bullets.any? %>
            <% @today_bullets.each do |bullet| %>
              <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
            <% end %>
          <% else %>
            <p>Today is still empty.</p>
          <% end %>
        </div>
      </main>
    </article>
  </section>
</main>
