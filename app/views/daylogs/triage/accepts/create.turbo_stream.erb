<% if @failed_message.present? %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: [@failed_message] %>
  <% end %>
<% else %>
  <% @bullets.each do |bullet| %>
    <%= turbo_stream.remove dom_id(bullet, :triage) %>
    <%= turbo_stream.append "daylog_triage_today" do %>
      <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
    <% end %>
  <% end %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "notify", messages: [@bullets.one? ? "Added to today" : "#{@bullets.size} bullets added to today"] %>
  <% end %>
<% end %>
