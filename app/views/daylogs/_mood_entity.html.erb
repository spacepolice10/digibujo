<%# locals: (date:, entity:) %>
<% popover_id = "daylog_mood_#{date.iso8601}" %>
<% anchor_name = "--#{popover_id.tr('-', '_')}" %>
<% hint_id = "daylog_mood_hint_#{date.iso8601}" %>
<% hint_anchor = "--hint-mood-#{date.iso8601.tr('-', '_')}" %>
<div class="dropdown--dock daylog--mood" style="anchor-name: <%= anchor_name %>">
  <button
    type="button"
    class="button--tertiary button--icon"
    popovertarget="<%= popover_id %>"
    interestfor="<%= hint_id %>"
    style="anchor-name: <%= hint_anchor %>"
    aria-label="<%= entity ? "Change mood" : "Pick mood" %>"
    aria-haspopup="menu"
  >
    <% if entity %>
      <%= entity.marker %>
    <% else %>
      <%= icon_tag("face") %>
    <% end %>
  </button>

  <div
    id="<%= hint_id %>"
    class="hint"
    popover="hint"
    style="position-anchor: <%= hint_anchor %>"
  >
    <%= entity ? entity.mood.humanize : "Pick mood" %>
  </div>

  <div
    id="<%= popover_id %>"
    class="dropdown dropdown--element dropdown--element-bottom animations--side-in daylog--mood-dropdown"
    style="position-anchor: <%= anchor_name %>"
    popover
    data-controller="grid-navigation"
    data-grid-navigation-columns-value="1"
    data-action="keydown->grid-navigation#navigate"
  >
    <%= render "shared/dropdown", name: "Mood", popover_target: popover_id do %>
      <nav class="dropdown--menu" aria-label="Mood">
        <% Daylog::MoodEntity::MOOD_MARKERS.each do |mood, emoji| %>
          <% selected = entity&.mood == mood.to_s %>
          <%= button_to daylog_mood_entity_path,
                method: :post,
                params: { date: date.iso8601, mood: mood },
                class: [
                  "dropdown-item",
                  ("dropdown-item--current" if selected)
                ],
                form_class: "dropdown--menu-form",
                form: { data: { turbo: true } },
                data: {
                  grid_navigation_target: "item",
                  action: "focus->grid-navigation#syncPosition"
                },
                aria: { label: mood.to_s.humanize, pressed: selected } do %>
            <span class="daylog--mood-menu-marker" aria-hidden="true"><%= emoji %></span>
            <%= mood.to_s.humanize %>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>
</div>
