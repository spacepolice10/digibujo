<turbo-frame
id="daylog_metadata_<%= @date.iso8601 %>"
>
  <div class="daylog--metadata">
    <%= link_to daylog_path(date: @date.iso8601), class: "button--secondary button--circle button-sm" do %>
      <%= icon_tag("arrow-right") %>
    <% end %>
    <%= render "mood_entity", date: @date, entity: @mood_entity %>
    <%= render "picture", date: @date, picture: @picture %>
  </div>
</turbo-frame>
