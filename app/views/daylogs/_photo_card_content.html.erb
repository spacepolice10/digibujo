<%# locals: (date:, picture:) %>
<div
  class="daylog--photo-card"
  role="button"
  tabindex="0"
  aria-expanded="false"
  aria-label="Photo for <%= date.strftime('%b %-d') %>"
  data-daylog-photo-target="card"
  data-action="
    click->daylog-photo#toggle
    keydown.enter->daylog-photo#toggle
    keydown.space->daylog-photo#toggle:prevent
    animationend->daylog-photo#settle
  "
>
  <%= image_tag picture.picture.variant(:preview),
        alt: "",
        class: "daylog--photo-card-image",
        draggable: false %>

  <div
    class="daylog--photo-toolbar"
    data-action="click->daylog-photo#stop"
  >
    <%= link_to attachment_path(picture.picture.blob.signed_id),
          class: "button--tertiary button--icon",
          data: { turbo_frame: "_top" },
          aria: { label: "View photo" } do %>
      <%= icon_tag("expand") %>
    <% end %>
    <%= button_to daylog_picture_path(date: date.iso8601),
          method: :delete,
          class: "button--tertiary button--icon",
          form: {
            data: {
              turbo_stream: true,
              turbo_confirm: "Are you sure you want to remove this photo?"
            }
          },
          aria: { label: "Remove photo" } do %>
      <%= icon_tag("trash") %>
    <% end %>
  </div>
</div>
