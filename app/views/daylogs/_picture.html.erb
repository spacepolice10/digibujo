<%# locals: (date:, picture:) %>
<% picture_id = "daylog_picture_#{date.iso8601}" %>
<% has_photo = picture&.picture&.attached? %>
<div id="<%= picture_id %>" class="daylog--picture">
  <% if has_photo %>
    <button
      type="button"
      class="button--tertiary button--icon"
      aria-label="Show photo"
      aria-controls="daylog_photo_card_<%= date.iso8601 %>"
      data-action="daylog-photo#toggle"
    >
      <%= icon_tag("arrow-left") %>
    </button>
  <% else %>
    <%= form_with url: daylog_picture_path,
          method: :post,
          multipart: true,
          data: { turbo_stream: true } do %>
      <%= hidden_field_tag :date, date.iso8601 %>
      <label class="button--tertiary button--icon" aria-label="Add photo">
        <%= icon_tag("camera") %>
        <%= file_field_tag :picture,
              accept: CalendarDate::Picture::ALLOWED_CONTENT_TYPES.join(","),
              class: "utilities--sr-only",
              onchange: "this.form.requestSubmit()" %>
      </label>
    <% end %>
  <% end %>
</div>
