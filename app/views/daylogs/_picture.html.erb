<%# locals: (date:, picture:) %>
<% if picture&.picture&.attached? %>
<div class="daylog--picture-container button--tertiary">
  <div class="daylog--picture">
    <%= image_tag picture.picture,
          alt: "Photo for #{date.strftime('%b %-d')}",
          class: "daylog--picture-thumbnail" %>
          <div class="daylog--picture-controls">
    <%= button_to daylog_picture_path(date: date.iso8601),
    method: :delete,
          class: "button--link",
          data: { confirm: "Are you sure you want to remove this photo?" } do %>
    <%= icon_tag("trash") %>
    <% end %>
    <%= link_to attachment_path(picture.picture.blob.signed_id),
    data: { turbo_frame: "_top" },
          aria: { label: "View full photo" } do %>
      <%= icon_tag("zoom-in") %>
    <% end %>
    </div>
  </div>
</div>
<% else %>
  <%= form_with url: daylog_picture_path,
        method: :post,
        multipart: true,
        data: { turbo: true } do %>
    <%= hidden_field_tag :date, date.iso8601 %>
    <label class="button--tertiary button--icon">
      <%= icon_tag("camera") %>
      <%= file_field_tag :picture,
            accept: Daylog::Picture::ALLOWED_CONTENT_TYPES.join(","),
            class: "utilities--sr-only",
            onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>
<% end %>
