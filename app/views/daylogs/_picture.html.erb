<%# locals: (date:, picture:) %>
<% picture_id = "daylog_picture_#{date.iso8601}" %>
<% has_photo = picture&.picture&.attached? %>
<div id="<%= picture_id %>" class="daylog--picture">
  <% if has_photo %>
    <%= link_to attachment_path(picture.picture.blob.signed_id),
          class: "button--tertiary button--icon",
          data: { turbo_frame: "_top" },
          aria: { label: "View photo" } do %>
      <%= icon_tag("expand") %>
    <% end %>
    <%= button_to daylog_picture_path(date: date.iso8601),
          method: :delete,
          class: "button--tertiary button--icon",
          form: {
            data: {
              turbo_stream: true,
              turbo_confirm: "Are you sure you want to remove this photo?"
            }
          },
          aria: { label: "Remove photo" } do %>
      <%= icon_tag("trash") %>
    <% end %>
  <% else %>
    <%= form_with url: daylog_picture_path,
          method: :post,
          multipart: true,
          data: { turbo_stream: true } do %>
      <%= hidden_field_tag :date, date.iso8601 %>
      <label class="button--tertiary button--icon" aria-label="Add photo">
        <%= icon_tag("camera") %>
        <%= file_field_tag :picture,
              accept: Daylog::Picture::ALLOWED_CONTENT_TYPES.join(","),
              class: "utilities--sr-only",
              onchange: "this.form.requestSubmit()" %>
      </label>
    <% end %>
  <% end %>
</div>
