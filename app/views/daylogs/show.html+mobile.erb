<% if @daylog %>
  <div class="layout--page layout--container layout--container-md daylog daylog--chat daylog--chat-mobile">
    <%= render "daylogs/chat",
          daylog: @daylog,
          daylog_bucket: @daylog_bucket,
          selected_date: @selected_date,
          bullets: @bullets,
          more_bullets: @more_bullets %>
  </div>
<% else %>
  <%= render "daylogs/empty" %>
<% end %>
