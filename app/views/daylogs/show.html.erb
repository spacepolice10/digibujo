<% if @daylog %>
  <div class="layout--page layout--container layout--container-md daylog daylog--chat">
    <%= render "daylogs/chat",
          daylog: @daylog,
          daylog_bucket: @daylog_bucket,
          selected_date: @selected_date,
          bullets: @bullets,
          more_bullets: @more_bullets,
          trackers: @trackers %>
  </div>
<% else %>
  <%= render "daylogs/placeholder" %>
<% end %>
