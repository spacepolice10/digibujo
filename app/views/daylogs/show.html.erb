<div class="layout--page daylog--page" data-controller="daylog bulk-menu">
  <turbo-frame id="bullets-timeline">
    <div id="bullets-header" class="layout--header daylog--header">
      <div class="layout--header-actions daylog--header-recurrencies">
        <% scheduled_recurrencies = @recurrency_tracker.recurrencies.select { |recurrency| recurrency.scheduled_on?(@selected_date) } %>
        <% if scheduled_recurrencies.any? %>
          <div class="recurrency--for-day" role="group" aria-label="Recurrency for <%= @selected_date == Date.current ? "this day" : @selected_date.strftime("%B %-d") %>">
            <span class="recurrency--for-day-label" aria-hidden="true">
              <i class="icon" style="--icon-mask: var(--icon-calendar-repeat)" aria-hidden="true"></i>
            </span>
            <% scheduled_recurrencies.each do |recurrency| %>
              <%= render "recurrencies/cell", recurrency: recurrency, date: @selected_date, tracker: @recurrency_tracker, variant: :chip, dom_key: "header" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="layout--header-actions daylog--header-nav">
        <%= link_to prev_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button--tertiary", aria: { label: "Show previous day" } do %>
          <i
            class="icon"
            style="--icon-mask: var(--icon-arrow-left)"
            aria-hidden="true"
          ></i>
        <% end %>

        <button
          type="button"
          class="button--tertiary"
          data-action="daylog#openDatePicker"
          aria-label="Pick a date"
        >
          <i
            class="icon"
            style="--icon-mask: var(--icon-calendar)"
            aria-hidden="true"
          ></i>

          <%= @selected_date.strftime("%a, %b %-d") %>
        </button>

        <input <%# herb:disable html-input-require-autocomplete %>
          type="date"
          value="<%= @selected_date.iso8601 %>"
          data-daylog-target="dateForm"
          data-action="change->daylog#switchDate"
          class="utilities--sr-only"
          tabindex="-1"
        >

        <%= link_to next_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button--tertiary", aria: { label: "Show next day" } do %>
          <i
            class="icon icon--flip-h"
            style="--icon-mask: var(--icon-arrow-right)"
            aria-hidden="true"
          ></i>
        <% end %>
      </div>

      <div class="layout--header-actions daylog--header-today">
        <% unless @selected_date == Date.current %>
          <%= link_to "Today", daylog_path, data: { turbo_action: "advance" }, class: "button--tertiary" %>
        <% end %>
      </div>
    </div>

    <div id="bullets" data-bulk-menu-target="list">
      <%= render "pagination/paginated_records",
          page: @page,
          selected_date: @selected_date,
          pagination_link_path: ->(next_param) { daylog_path(date: @selected_date.iso8601, page: next_param) } %>
    </div>

    <%= render "bullets/bulk_menu" %>

    <turbo-frame id="bullet_composer" class="bullet_pops_on_<%= @selected_date %>" data-controller="composer-frame">
      <%= render "bullets/composer/picker",
            composer_id: "bullet_composer",
            attributes: { pops_on: @selected_date } %>
    </turbo-frame>
  </turbo-frame>
</div>
