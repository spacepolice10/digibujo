<div class="layout--page daylog--page" data-controller="daylog bulk-menu">
  <turbo-frame id="bullets-timeline">
    <div id="bullets-header" class="layout--header">
      <div class="layout--header-actions"></div>

      <div class="layout--header-actions">
        <%= link_to prev_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button--tertiary", aria: { label: "Show previous day" } do %>
          <i
            class="icon"
            style="--icon-mask: var(--icon-arrow-left)"
            aria-hidden="true"
          ></i>
        <% end %>

        <button
          type="button"
          class="button--tertiary"
          data-action="daylog#openDatePicker"
          aria-label="Pick a date"
        >
          <i
            class="icon"
            style="--icon-mask: var(--icon-calendar)"
            aria-hidden="true"
          ></i>

          <%= @selected_date.strftime("%a, %b %-d") %>
        </button>

        <input <%# herb:disable html-input-require-autocomplete %>
          type="date"
          value="<%= @selected_date.iso8601 %>"
          data-daylog-target="dateForm"
          data-action="change->daylog#switchDate"
          class="utilities--sr-only"
          tabindex="-1"
        >

        <%= link_to next_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button--tertiary", aria: { label: "Show next day" } do %>
          <i
            class="icon icon--flip-h"
            style="--icon-mask: var(--icon-arrow-right)"
            aria-hidden="true"
          ></i>
        <% end %>
      </div>

      <div style="justify-content: flex-end;" class="layout--header-actions">
        <% unless @selected_date == Date.current %>
          <%= link_to "Today", daylog_path, data: { turbo_action: "advance" }, class: "button--tertiary" %>
        <% end %>
      </div>
    </div>

    <div id="bullets" data-bulk-menu-target="list">
      <%= render "pagination/paginated_records",
          page: @page,
          pagination_link_path: ->(next_param) { daylog_path(date: @selected_date.iso8601, page: next_param) } %>
    </div>

    <%= render "bullets/bulk_menu" %>

    <turbo-frame id="bullet_composer" class="bullet_pops_on_<%= @selected_date %>">
      <%= render "bullets/composer",
          attributes: { pops_on: @selected_date } %>
    </turbo-frame>
  </turbo-frame>
</div>
