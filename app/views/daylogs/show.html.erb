<div
  class="chat--window layout--container"
  data-size="sm"
  data-elevation="1"
>
  <div class="layout--surface" data-elevation="1">
  <header class="chat--header">
    <turbo-frame id="daylog_header_<%= @selected_date.iso8601 %>">
      <div class="layout--flex">
        <div>
          <% if @bullets.any? %>
            <div class="header--controls">
              <span class="typography--mono typography--paragraph-sm">
                <%= @selected_date.strftime("%a, %b %-d") %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </header>

  <div
    class="chat--wrap"
    data-controller="chat-scroll"
    data-chat-scroll-path-value="<%= daylog_bullets_path %>"
  >
    <div
      id="daylog_bullets_container"
      class="chat--scroller"
      data-bulk-menu-target="list"
      data-chat-scroll-target="scroller"
    >
      <% if @more_bullets %>
        <div class="chat--load-more-trigger" data-chat-scroll-target="trigger">
          <%= icon_tag("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <div
        id="<%= dom_id(@daylog.bucket, @selected_date) %>"
        class="chat--padder"
      ></div>

      <% if @bullets.present? %>
        <% @bullets.each do |bullet| %>
          <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
        <% end %>
      <% else %>
        <%= render "daylogs/triage_preview" %>
      <% end %>

      <div id="daylog_composer" class="daylog--composer">
        <%= render "bullets/composer_v2",
        bullet: Bullet.new,
        bucket_id: @daylog.bucket.id,
        pops_on: @selected_date,
        allowed_bulletable_variants: ["Task", "Note", "Event", "Voice"],
        preset: "default",
        autofocus: false,
        composer_id: dom_id(@daylog.bucket, @selected_date) %>
      </div>
    </div>
  </div>
  </div>
</div>
