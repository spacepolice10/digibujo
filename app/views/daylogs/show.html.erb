<div class="w-tablet mx-auto" data-controller="bulk-menu">
<turbo-frame id="bullets-timeline">
  <div id="bullets-header" class="flex justified slightly-padded w-tablet mx-auto">
    <div class="flex slightly-gapped">
      <%= link_to "Activity", activities_path, data: { turbo_frame: "_top" }, class: "button-secondary" %>
    </div>
    <div class="flex slightly-gapped">
      <%= link_to prev_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button-tertiary", aria: { label: "Show previous day" } do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      <% end %>
      <h4><%= @selected_date.strftime("%a, %b %-d") %></h4>
      <%= link_to next_date_href(@selected_date), data: { turbo_action: "advance" }, class: "button-tertiary", aria: { label: "Show next day" } do %>
        <i class="icon icon--flip-h" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
      <% end %>
    </div>
    <div class="flex slightly-gapped">
      <% unless @selected_date == Date.current %>
        <%= link_to "Today", daylog_path, data: { turbo_action: "advance" }, class: "button-tertiary" %>
      <% end %>
    </div>
  </div>
  <div id="bullets" class="w-tablet mx-auto" data-bulk-menu-target="list">
    <%= render "pagination/paginated_records",
          page: @page,
          pagination_link_path: ->(next_param) { daylog_path(date: @selected_date.iso8601, page: next_param) } %>
  </div>
  <%= render "bullets/bulk_menu" %>

  <turbo-frame id="new_bullet_form">
    <%= render "bullets/editor",
          bullet: Current.user.bullets.build,
          bulletable_type: "Note",
          attributes: { pops_on: @selected_date } %>
  </turbo-frame>
</turbo-frame>
</div>
