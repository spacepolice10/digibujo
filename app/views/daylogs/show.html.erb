<div class="layout--page daylog--page" data-controller="daylog bulk-menu">
  <turbo-frame id="bullets-timeline">
    <div id="bullets-header" class="layout--header daylog--header">
      <div class="layout--header-actions daylog--header-nav">
        <%= link_to daylog_path(date: (@selected_date - 1.day).iso8601),
              data: {
                turbo_action: "advance",
                controller: "hotkey",
                hotkey: "←",
                action: "keydown.shift+left@document->hotkey#click"
              },
              class: "button--tertiary hotkey-hint",
              aria: { label: "Show previous day", keyshortcuts: "Shift+ArrowLeft" } do %>
          <i
            class="icon"
            style="--icon-mask: var(--icon-arrow-left)"
            aria-hidden="true"
          ></i>
        <% end %>

        <button
          type="button"
          class="button--tertiary"
          data-action="daylog#openDatePicker"
          aria-label="Pick a date"
        >
          <i
            class="icon"
            style="--icon-mask: var(--icon-calendar)"
            aria-hidden="true"
          ></i>

          <%= @selected_date.strftime("%a, %b %-d") %>
        </button>

        <input <%# herb:disable html-input-require-autocomplete %>
          type="date"
          value="<%= @selected_date.iso8601 %>"
          data-daylog-target="dateForm"
          data-action="change->daylog#switchDate"
          class="utilities--sr-only"
          tabindex="-1"
        >

        <%= link_to daylog_path(date: (@selected_date + 1.day).iso8601),
              data: {
                turbo_action: "advance",
                controller: "hotkey",
                hotkey: "→",
                action: "keydown.shift+right@document->hotkey#click"
              },
              class: "button--tertiary hotkey-hint",
              aria: { label: "Show next day", keyshortcuts: "Shift+ArrowRight" } do %>
          <i
            class="icon icon--flip-h"
            style="--icon-mask: var(--icon-arrow-right)"
            aria-hidden="true"
          ></i>
        <% end %>
      </div>

      <div class="layout--header-actions daylog--header-today">
        <% unless @selected_date == Date.current %>
          <%= link_to "Today", daylog_path, data: { turbo_action: "advance" }, class: "button--accent daylog--today" %>
        <% end %>
      </div>
    </div>

    <div class="layout--surface bucket--list">
      <%= render "bullets/composer/jump" %>

      <div id="bullets" data-bulk-menu-target="list">
        <%= render "pagination/paginated_records",
            page: @page,
            selected_date: @selected_date,
            pagination_link_path: ->(next_param) { daylog_path(date: @selected_date.iso8601, page: next_param) } %>
      </div>

      <%= render "bullets/composer/dock", selected_date: @selected_date %>
    </div>

    <p class="daylog--hotkey-hint">
      Hold <span class="hotkey-hint--key">Shift</span> to see hotkeys
    </p>

    <%= render "bullets/bulk_menu" %>
  </turbo-frame>
</div>
