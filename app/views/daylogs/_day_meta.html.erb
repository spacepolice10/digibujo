<%# locals: (date:, mood_entity:, picture:, empty:) %>
<div class="daylog--day-meta">
  <div class="daylog--day-meta-surface">
    <div class="daylog--day-meta-media">
      <%= render "daylogs/picture", date: date, picture: picture %>
    </div>

    <div class="daylog--day-meta-mood">
      <%= render "daylogs/mood_entity", date: date, entity: mood_entity %>
    </div>

    <% if empty %>
      <div id="no_bullets_container" class="daylog--day-meta-empty">
        <p class="daylog--day-meta-empty-title typography--balanced">No bullets yet</p>
        <p class="daylog--day-meta-empty-copy typography--paragraph-sm typography--balanced typography--center">
          Check your monthly bucket, references, or start a braindumping session.
        </p>
      </div>
    <% end %>
  </div>
</div>
