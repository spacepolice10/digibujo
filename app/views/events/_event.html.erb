<div id="<%= dom_id(event) %>" class="bullet" data-bullet-type="event">
  <span class="bullet--event--marker">
    <i class="icon" style="--icon-mask: var(--icon-circle)" aria-hidden="true"></i>
  </span>
  <div class="bullet--name"><%= event.name %></div>
  <%= render "bullets/menu", bullet: event %>
</div>
