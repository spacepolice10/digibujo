<turbo-frame id="<%= dom_id(event) %>" class="bullet" data-bullet-type="event">
  <div class="bullet--marker bullet--event-marker">
    <i class="icon" style="--icon-mask: var(--icon-circle)" aria-hidden="true"></i>
  </div>
     <div class="bullet--body" data-controller="bullet-navigation" data-action="mouseup->bullet-navigation#rememberSelection click->bullet-navigation#navigate" data-bullet-navigation-href-value="<%= edit_bullet_path(event) %>">
    <div class="bullet--name">
      <%= event.content %>
    </div>
    <%= render "bullets/metadata", bullet: event %>
    <%= render "bullets/attachments_gallery", bullet: event %>
</div>
  <%= render "bullets/select", bullet: event %>
</turbo-frame>
