<turbo-frame id="<%= dom_id(event) %>" class="bullet" data-bullet-type="event">
  <div class="bullet--marker bullet--event-marker">
    <i class="icon" style="--icon-mask: var(--icon-circle)" aria-hidden="true"></i>
  </div>
  <div class="bullet--body">
    <div class="bullet--name">
      <%= event.body %>
    </div>
    <%= render "bullets/metadata", bullet: event %>
    <%= render "bullets/attachments", bullet: event %>
</div>
  <%= render "bullets/select", bullet: event %>
</turbo-frame>
