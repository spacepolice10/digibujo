<%# locals: (event:, selected_date: nil) %>
<% bullet = event %>
<% event = bullet.bulletable %>

<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-type="event"
  data-event-completed="<%= event.completed? %>"
>
  <%= render "bullets/marker", bullet: bullet %>

  <div class="bullet--body">
    <span class="bullet--content"><%= event.excerpt %></span>
    <%= render "bullets/metadata", bullet: bullet, selected_date: selected_date %>
  </div>
</turbo-frame>
