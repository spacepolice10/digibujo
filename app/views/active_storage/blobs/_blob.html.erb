<% if blob.representable? %>
  <figure class="attachment attachment--preview attachment--<%= blob.filename.extension %>">
    <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [ 480, 360 ] : [ 360, 260 ]),
          class: "attachment--preview-image" %>
  </figure>
<% else %>
  <span class="attachment attachment--file attachment--inline attachment--<%= blob.filename.extension %>">
    <%= link_to blob.filename, rails_blob_path(blob, disposition: "attachment"), class: "attachment--name" %>
  </span>
<% end %>
