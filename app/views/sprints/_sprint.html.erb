<li id="<%= dom_id(sprint.bucket, :list_item) %>" class="layout--list-item">
  <%= link_to sprint_path(sprint), class: "bucket--list-item-link" do %>
    <div class="bucket--list-item-name">
      <div class="bucket--list-item-marker" data-bucket-colour="<%= sprint.bucket.colour %>" aria-hidden="true">
        <%= image_tag sprint.icon_path, alt: "", class: "icons--list" %>
      </div>
      <span class="utilities--line-clamp-1"><%= sprint.name %></span>
    </div>
    <div class="bucket--list-item-meta utilities--line-clamp-1">
      <span><%= sprint.starts_on.strftime("%b %-d") %> – <%= sprint.ends_on.strftime("%b %-d") %></span>
    </div>
  <% end %>
</li>
