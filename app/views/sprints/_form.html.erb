<%# locals: (sprint:, bullet_ids: nil, return_to: nil) %>
<%= form_with model: sprint, class: "form form--strong" do |f| %>
  <% if bullet_ids.present? %>
    <%= hidden_field_tag :bullet_ids, bullet_ids %>
    <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% else %>
    <small class="form-hint">Sprints are time-boxed pushes — commit to a goal for a fixed period and track progress before the deadline.</small>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <small class="form-hint"><%= bullet_ids.present? ? "Give your sprint a name." : "Examples: Kitchen refresh, Launch prep, Spring cleaning." %></small>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :starts_on, "Starts", class: "form-label" %>
    <%= f.date_field :starts_on, class: "form-input", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :ends_on, "Ends", class: "form-label" %>
    <%= f.date_field :ends_on, class: "form-input", required: true %>
  </div>

  <%= render "shared/form/colour_picker", form: f, aria_label: "Sprint colour" %>
  <%= render "shared/form/icon_picker", form: f,
        aria_label: "Sprint icon",
        hint: "Pick an emoji to make this sprint easy to spot." %>

  <div class="form-group">
    <%= label_tag "sprint[description]", "Description", class: "form-label" %>
    <small class="form-hint">Optional. What are you trying to finish in this sprint?</small>
    <%= text_area_tag "sprint[description]",
          sprint.try(:bucket)&.description,
          class: "form-input",
          rows: 3,
          id: "sprint_description" %>
  </div>

  <% if bullet_ids.present? %>
    <%= f.submit "Create and collect", class: "button--primary form--submit" %>
  <% else %>
    <%= f.submit class: "button--primary form--submit" %>
  <% end %>
<% end %>
