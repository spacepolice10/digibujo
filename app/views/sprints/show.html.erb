<% content_for(:title) { @sprint.name } %>

<div class="layout--page layout--workspace-page">
  <div class="layout--workspace">
    <aside class="layout--rail">
      <%= link_to home_path, class: "button--secondary layout--rail-action" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Back
      <% end %>
      <%= render "buckets/pins_button", bucket: @sprint.bucket %>
      <%= render "bullet/listing/type_filters", listing: @listing %>
    </aside>

    <div class="layout--surface bucket--list" data-controller="bulk-menu">
      <h2 class="layout--surface-name"><%= @sprint.name %></h2>

      <div class="sprint--summary">
        <p class="sprint--dates utilities--text-sm">
          <%= @sprint.starts_on.strftime("%b %-d") %> – <%= @sprint.ends_on.strftime("%b %-d, %Y") %>
        </p>
        <p class="sprint--status sprint--status-<%= @sprint.status %>">
          <%= render "sprints/status_label", sprint: @sprint %>
        </p>
        <% if @progress[:total].positive? %>
          <div class="sprint--progress" role="group" aria-label="Task progress">
            <div class="sprint--progress-bar" aria-hidden="true">
              <div class="sprint--progress-fill" style="width: <%= @progress[:percent] %>%"></div>
            </div>
            <p class="sprint--progress-label utilities--text-sm">
              <%= @progress[:completed] %>/<%= @progress[:total] %> tasks
            </p>
          </div>
        <% end %>
      </div>

      <% if @sprint.bucket.description.present? %>
        <p class="bucket--description utilities--text-sm"><%= @sprint.bucket.description %></p>
      <% end %>

      <%= render "bullet/listing/list", listing: @listing, page: @page %>

      <%= render "bullets/bulk_menu" %>
    </div>
  </div>
</div>
