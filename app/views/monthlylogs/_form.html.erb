<%# locals: (monthlylog:, bucket:) %>
<%= form_with url: monthlylogs_path, scope: :monthlylog, class: "form" do |f| %>
  <% if bucket.errors.any? %>
    <div class="form-errors" role="alert">
      <% bucket.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/bucket_identity_fields",
        form: f,
        name_hint: "Name for this monthly spread, e.g. June 2026." %>

  <div class="form-group">
    <%= f.label :period_from, "From", class: "form-label" %>
    <%= f.date_field :period_from,
          value: bucket.period_from&.iso8601,
          class: "form-input",
          required: true %>
  </div>
  <div class="form-group">
    <%= f.label :period_to, "To", class: "form-label" %>
    <%= f.date_field :period_to,
          value: bucket.period_to&.iso8601,
          class: "form-input",
          required: true %>
  </div>

  <%= f.submit "Create monthly log", class: "button--primary" %>
<% end %>
