<% if @monthlylog %>
  <% content_for(:title) { @monthlylog.name } %>

  <div class="layout--mx-auto monthlylog--header">
    <%= icon_tag("calendar", style: "color: var(--color-text-base);", class: "monthlylog--header-icon") %>
    <h2><%= @monthlylog.name %></h2>
    <p class="typography--paragraph-sm">
      <%= @monthlylog.period_from.strftime("%b %-d") %> –
      <%= @monthlylog.period_to.strftime("%b %-d, %Y") %>
    </p>
  </div>
  <p class="utilities--mx-auto typography--paragraph-sm layout--padded">This is monthly planning section. Drop your "sometime" bullets here & jot down  the events that will happen in the future.</p>

  <div class="layout--page">
  <main class="layout--container layout--container-lg layout--surface">

    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Home
      <% end %>
      <div class="layout--flex layout--gapped">
      <%= render "buckets/pins_button", bucket: @monthlylog.bucket %>
      <%= link_to "Add tracker", new_monthlylog_tracker_path(@monthlylog), class: "button--secondary button--sm" %>
      </div>
    </div>

      <div class="monthlylog--spread">
        <section
          class="monthlylog--calendar"
          aria-label="Planned by date"
          data-controller="scroll"
        >
          <% if @days.any? %>
            <div class="monthlylog--calendar-body">
              <% @days.each do |date| %>
                <div
                  class="monthlylog--date-band<%= " monthlylog--date-band-current" if date == Date.current %>"
                  <% if date == Date.current %> data-scroll-target="current" <% end %>
                >
                  <div class="monthlylog--date-rail">
                    <%= link_to daylog_path(date: date.iso8601),
                          class: "monthlylog--date-item",
                          aria: { label: "Open #{date.strftime('%B %-d')} on daily log" } do %>
                      <span class="monthlylog--date-number"><%= date.day %></span>
                      <span class="monthlylog--date-name"><%= date.strftime("%a") %></span>
                    <% end %>

                    <div
                      class="monthlylog--date-entries"
                      data-controller="pops-drop drop-postpone-optimistic"
                      data-pops-drop-pops-url-value="<%= postpone_path %>"
                      data-pops-drop-bucket-id-value="<%= @monthlylog.bucket.id %>"
                      data-pops-drop-pops-on-value="<%= date.iso8601 %>"
                      data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
                    >
                      <div
                        id="<%= dom_id(@monthlylog, "date_#{date.to_date}_bullets") %>"
                        class="monthlylog--bullets-list"
                        data-bulk-menu-target="list"
                      >
                        <%= turbo_frame_tag "monthlylog_bullets_#{date.to_date}_container" do %>
                          <% (@bullets_by_date[date] || []).each do |bullet| %>
                            <%= render "monthlylogs/bullets/bullet", bullet: bullet %>
                          <% end %>
                        <% end %>
                      </div>

                      <% composer_id = "monthlylog_bullets_#{date.to_date}_composer" %>
                      <div class="monthlylog--date-artifacts">
                        <div class="monthlylog--date-mood">
                          <%= render "daylogs/mood_entity",
                                date: date,
                                entity: @mood_entities_by_date[date] %>
                        </div>
                        <% scheduled_trackers = @trackers.select { |tracker| tracker.scheduled_on?(date) } %>
                        <% if scheduled_trackers.any? %>
                          <div class="monthlylog--date-trackers">
                            <% scheduled_trackers.each do |tracker| %>
                              <%= render "trackers/day_toggle", tracker: tracker, date: date %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                      <div class="monthlylog--date-composer">
                        <%= create_bullet_buttons composer_id: composer_id,
                              dialog_id: "monthlylog_composer",
                              bucket_id: @monthlylog.bucket.id,
                              pops_on: date,
                              bulletable_type: %w[Task Event] %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="monthlylog--by-date-empty">No period set for this spread.</p>
          <% end %>
        </section>

        <div class="monthlylog--divider" aria-hidden="true"></div>

        <section class="monthlylog--unplanned" aria-label="Unplanned">
          <header class="monthlylog--unplanned-header">
            <h3 class="monthlylog--unplanned-title">Unplanned</h3>
            <p class="monthlylog--unplanned-description utilities--text-sm">
              Brain dump for the month — park ideas here until you assign them to a day.
            </p>
          </header>

          <div
            class="monthlylog--unplanned-entries"
            data-controller="pops-drop drop-postpone-optimistic"
            data-pops-drop-pops-url-value="<%= postpone_path %>"
            data-pops-drop-bucket-id-value="<%= @monthlylog.bucket.id %>"
            data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
          >
            <%= turbo_frame_tag "monthlylog_bullets_unplanned_container",
                  class: "monthlylog--bullets-list layout--list",
                  data: { bulk_menu_target: "list" } do %>
              <% @unplanned_bullets.each do |bullet| %>
                <%= render "monthlylogs/bullets/bullet", bullet: bullet %>
              <% end %>
            <% end %>

            <% composer_id = "monthlylog_bullets_unplanned_composer" %>
            <%= create_bullet_buttons composer_id: composer_id,
                  dialog_id: "monthlylog_composer",
                  bucket_id: @monthlylog.bucket.id,
                  pops_on: nil,
                  bulletable_type: %w[Note] %>
          </div>
        </section>
      </div>
    </div>

    <%= render "monthlylogs/composer_dialog" %>
  </div>
<% else %>
  <% content_for(:title) { "Monthly spread" } %>

  <div class="layout--page layout--container layout--container-md">
    <div class="layout--surface layout--mx-auto">
      <div class="layout--surface-header">
        <h2>Monthly spread</h2>
      </div>
      <div class="layout--surface layout--padded layout--mx-auto">
        <p class="typography--paragraph-sm typography--center">No monthly spread yet. Create one to plan the month ahead.</p>
        <div class="layout--padded">
          <%= link_to "Create monthly spread", new_monthlylog_path, class: "button--primary layout--mx-auto" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
