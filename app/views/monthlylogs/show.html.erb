<% if @monthlylog %>
  <% content_for(:title) { @monthlylog.name } %>
  

  <div class="layout--page">
  <main class="layout--container layout--container-md layout--surface">

 

      <div class="monthlylog--spread">
        <section class="monthlylog--calendar" aria-label="Planned by date">
          <% if @days.any? %>
            <% offset = @days.first.wday %>
            <% padded = Array.new(offset, nil) + @days %>

            <div class="layout--grid layout--gapped monthlylog--calendar-grid" style="--grid-cols-number: 7;">
              <% Date::DAYNAMES.each do |weekday| %>
                <div class="layout--grid-item layout--surface-sunken monthlylog--weekday">
                  <%= weekday.first(3) %>
                </div>
              <% end %>

              <% padded.each do |date| %>
                <% if date.blank? %>
                  <div class="layout--grid-item" aria-hidden="true"></div>
                <% else %>
                  <% picture = @pictures_by_date[date] %>
                  <% count = @bullet_counts_by_date[date].to_i %>

                  <div
                    class="layout--grid-item layout--surface-sunken monthlylog--date-cell"
                    data-controller="pops-drop monthlylog-calendar-drop-optimistic"
                    data-pops-drop-pops-url-value="<%= postpone_path %>"
                    data-pops-drop-bucket-id-value="<%= @monthlylog.bucket.id %>"
                    data-pops-drop-pops-on-value="<%= date.iso8601 %>"
                    data-pops-drop-requested-with-value="pops-drop"
                    data-pops-drop-optimistic-value="monthlylog-calendar-drop-optimistic"
                    data-drop-zone-value="<%= date.iso8601 %>"
                    data-monthlylog-calendar-drop-optimistic-count-value="<%= count %>"
                    data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
                  >
                    <%= link_to monthlylog_bullets_path(@monthlylog, date: date.iso8601),
                          data: { turbo_frame: "monthlylog_date" },
                          class: "monthlylog--date-item#{" is-selected" if date == @date}" do %>
                      <% if picture&.picture&.attached? %>
                        <%= image_tag picture.picture.variant(:thumb), class: "monthlylog--date-preview", alt: "" %>
                      <% end %>
                      <span class="monthlylog--date-number"><%= date.day %></span>
                      <span
                        class="monthlylog--indicator"
                        data-monthlylog-calendar-drop-optimistic-target="indicator"
                        <%= "hidden" unless count > 0 %>
                        aria-hidden="true"></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="monthlylog--by-date-placeholder">No period set for this spread.</p>
          <% end %>

          <turbo-frame
            id="monthlylog_date"
            src="<%= monthlylog_bullets_path(@monthlylog, date: @date.iso8601) %>"
            class="monthlylog--date-section">
          </turbo-frame>
        </section>

        <div class="monthlylog--divider" aria-hidden="true"></div>

        <section class="monthlylog--unplanned" aria-label="Unplanned">
          <header class="monthlylog--unplanned-header">
            <h3 class="monthlylog--unplanned-title">Unplanned</h3>
            <p class="monthlylog--unplanned-description utilities--text-sm">
              Brain dump for the month — park ideas here until you assign them to a day.
            </p>
          </header>

          <turbo-frame
            id="monthlylog_unplanned"
            src="<%= monthlylog_bullets_path(@monthlylog) %>"
            class="monthlylog--unplanned-entries">
          </turbo-frame>
        </section>
      </div>
    </div>
  </div>
<% else %>
  <% content_for(:title) { "Monthly spread" } %>

  <div class="layout--page layout--container layout--container-md">
    <div class="layout--surface layout--mx-auto">
      <div class="layout--surface-header">
        <h2>Monthly spread</h2>
      </div>
      <div class="layout--surface layout--padded layout--mx-auto">
        <p class="typography--paragraph-sm typography--center">No monthly spread yet. Create one to plan the month ahead.</p>
        <div class="layout--padded">
          <%= link_to "Create monthly spread", new_monthlylog_path, class: "button--primary layout--mx-auto" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
