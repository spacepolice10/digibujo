<% content_for(:title) { @monthlylog.name } %>

<div class="layout--page" data-controller="bulk-menu">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to buckets_path, class: "button--secondary" do %>
        <i class="icon" style="--icon-mask: var(--icon-arrow-left)" aria-hidden="true"></i>
        Index
      <% end %>
    </div>
    <h2 class="monthlylog"><%= @monthlylog.name %></h2>
    <% if @monthlylog.period? %>
      <p class="utilities--text-sm">
        <%= @monthlylog.period_from.strftime("%b %-d") %> – <%= @monthlylog.period_to.strftime("%b %-d, %Y") %>
      </p>
    <% end %>
  </div>

  <div class="monthlylog--spread">
    <section class="monthlylog--by-date" aria-label="Planned by date">
      <% if @period_days %>
        <% @period_days.each do |date| %>
          <div class="monthlylog--date-row">
            <div class="monthlylog--date-label">
              <span><%= date.day %></span>
              <span><%= date.strftime("%a")[0] %></span>
            </div>
            <div id="<%= dom_id(@monthlylog, "date_#{date}_bullets") %>" class="monthlylog--date-entries">
              <% (@bullets_by_date[date] || []).each do |bullet| %>
                <%= render_bullet_compact(bullet) %>
              <% end %>
            </div>
            <turbo-frame id="<%= dom_id(@monthlylog, "date_#{date}_composer") %>">
              <%= render "monthlylogs/day_composer", monthlylog: @monthlylog, date: date, bucket: @bucket %>
            </turbo-frame>
          </div>
        <% end %>
      <% else %>
        <p class="monthlylog--by-date-empty">No period set for this spread.</p>
      <% end %>
    </section>

    <section class="monthlylog--unplanned" aria-label="Unplanned">
      <h3 class="utilities--text-sm">Unplanned</h3>
      <div id="<%= dom_id(@monthlylog, :unplanned_bullets) %>">
        <% @unplanned_bullets.each do |bullet| %>
          <%= render_bullet_compact(bullet) %>
        <% end %>
      </div>
      <turbo-frame id="<%= dom_id(@monthlylog, :unplanned_composer) %>">
        <%= render "bullets/editor",
              bullet: Current.user.bullets.build,
              bulletable_type: "Task",
              attributes: {
                bucket_id: @bucket.id,
                render_context: "monthlylog_unplanned",
                monthlylog_id: @monthlylog.id
              } %>
      </turbo-frame>
    </section>
  </div>

  <%= render "bullets/bulk_menu" %>
</div>
