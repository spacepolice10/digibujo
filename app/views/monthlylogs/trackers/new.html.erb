<% content_for(:title) { "New tracker" } %>

<div class="layout--container layout--container-md">
  <div class="layout--header">
    <div class="layout--header-actions">
      <%= link_to monthlylog_path(@monthlylog), class: "button--secondary" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    <h2>New tracker</h2>
  </div>
  <div class="layout--surface">
    <%= render "trackers/form", tracker: @tracker, url: monthlylog_trackers_path(@monthlylog) %>
  </div>
</div>
