<% offset = days.first.wday %>
<% padded = Array.new(offset, nil) + days %>

<div class="layout--grid layout--gapped" style="--grid-cols-number: 7;">
        <% Date::DAYNAMES.each do |weekday| %>
         <div class="layout--grid-item layout--surface-sunken">
             <%= weekday.first(3) %>
         </div>
        <% end %>
    <% padded.each do |date| %>
        <% if date.present? %>
        <div class="layout--grid-item layout--surface-sunken">
            <%= link_to monthlylog_date_path(date: date), data: { turbo_frame: "monthlylog_date" }, class: "monthlylog--date-item" do %>
                    <%= date&.strftime("%-d") %>
                <% end %>
            </div>
        <% end %>
    <% end %>
</div>