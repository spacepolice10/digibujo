<li id="<%= dom_id(monthlylog.bucket, :list_item) %>" class="layout--list-item">
  <%= link_to monthlylog_path(monthlylog), data: { turbo_frame: "_top" }, class: "bucket--list-item-link" do %>
    <div class="bucket--list-item-name">
      <div class="bucket--list-item-marker" data-bucket-colour="<%= monthlylog.colour %>" aria-hidden="true">
        <% if monthlylog.icon.present? %>
          <i class="icon" style="--icon-mask: <%= monthlylog.icon_mask %>" aria-hidden="true"></i>
        <% end %>
      </div>
      <span class="utilities--line-clamp-1"><%= monthlylog.name %></span>
    </div>
    <div class="utilities--line-clamp-1 utilities--text-sm">
      <% if monthlylog.period? %>
        <span><%= monthlylog.period_from.strftime("%b %-d") %> – <%= monthlylog.period_to.strftime("%b %-d") %></span>
      <% end %>
    </div>
  <% end %>
</li>
